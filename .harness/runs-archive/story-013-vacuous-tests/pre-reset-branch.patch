+def shipped_schemas(harness_root: Path | None = None) -> tuple[str, ...]:
+    """The declared inventory of schema names, read from schemas/manifest.json.
+
+    The manifest is the single source of truth for which schemas the harness
+    ships; the tests are where that declaration is checked against the
+    directory. A missing or malformed manifest raises rather than yielding an
+    empty or partial inventory, which would make those checks vacuous.
+    """
+    path = schemas_dir(harness_root) / MANIFEST_NAME
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError as error:
+        raise ValueError(f"{path}: schema manifest is missing or unreadable") from error
+    try:
+        manifest = json.loads(text)
+    except json.JSONDecodeError as error:
+        raise ValueError(f"{path}: schema manifest is not parseable as JSON") from error
+    if not isinstance(manifest, dict) or not isinstance(
+        manifest.get(MANIFEST_KEY), list
+    ):
+        raise ValueError(
+            f"{path}: schema manifest must be an object with a "
+            f"{MANIFEST_KEY!r} array of schema names"
+        )
+    names = manifest[MANIFEST_KEY]
+    for name in names:
+        if not isinstance(name, str) or not name:
+            raise ValueError(
+                f"{path}: every {MANIFEST_KEY} entry must be a non-empty string, "
+                f"found {name!r}"
+            )
+    return tuple(names)
