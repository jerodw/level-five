{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W1CrMtUK9LvSVRCRstyEdX","type":"tool_result","content":"1\t\"\"\"story-013: the schema inventory moves out of tests/ into schemas/manifest.json.\n2\t\n3\tThe story's claim is that the inventory can live beside the schemas it\n4\tdeclares without losing what made it valuable: adding an artifact shape to\n5\tthe harness still cannot happen unnoticed. These tests hold that claim to\n6\tits two halves.\n7\t\n8\tThe declaration half is checked directly - the manifest names exactly the\n9\tsix shipped schemas, the accessor reads it, and every degradation path\n10\traises instead of handing back an empty inventory that would make the\n11\tper-schema parametrized checks silently vacuous.\n12\t\n13\tThe enforcement half is checked by mutation rather than by reading the\n14\tassertions and reasoning about them. A copy of the harness is made in a\n15\ttemporary directory, one thing is changed in it - a schema file with no\n16\tmanifest entry, a manifest entry with no schema file, a stray non-schema\n17\tfile - and the repository's own inventory tests are run against that copy\n18\tto show they fail. The same machinery demonstrates the story's central\n19\tproperty: adding a schema together with its manifest line turns the suite\n20\tgreen again while every file under tests/ stays byte-identical, so the\n21\tpaths a new schema requires editing are all under schemas/ and none are\n22\tunder tests/.\n23\t\"\"\"\n24\timport ast\n25\timport json\n26\timport shutil\n27\timport subprocess\n28\timport sys\n29\tfrom pathlib import Path\n30\t\n31\timport pytest\n32\t\n33\timport context_assembler\n34\timport schema_validator\n35\t\n36\tREPO_ROOT = Path(schema_validator.__file__).resolve().parents[1]\n37\t\n38\t# Named here, not read from the manifest: this is the story's own statement\n39\t# of what the harness ships today, and it is the thing the manifest is\n40\t# checked against. Reading it from the manifest would check nothing.\n41\tEXPECTED_SCHEMAS = (\n42\t    \"changed-files\",\n43\t    \"execution-history\",\n44\t    \"retry-guidance\",\n45\t    \"story\",\n46\t    \"test-results\",\n47\t    \"verification-result\",\n48\t)\n49\t\n50\t# The two tests that hold the directory to the declared inventory. Both are\n51\t# run against mutated copies of the harness below.\n52\tINVENTORY_TESTS = (\n53\t    \"tests/test_schema_validator.py::test_shipped_schemas_are_exactly_the_named_ones\",\n54\t    \"tests/test_story_004_validation.py::test_schemas_directory_holds_exactly_the_named_schemas\",\n55\t)\n56\t\n57\tINVENTORY_TEST_FILES = (\"tests/test_schema_validator.py\",\n58\t                        \"tests/test_story_004_validation.py\")\n59\t\n60\t# A well-formed schema in the subset the validator supports, so a mutation\n61\t# test fails because of the inventory and never because the file it added is\n62\t# a bad schema.\n63\tTHROWAWAY_SCHEMA = {\n64\t    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n65\t    \"title\": \"throwaway\",\n66\t    \"description\": \"A schema added by a test to exercise the inventory.\",\n67\t    \"type\": \"object\",\n68\t    \"required\": [\"note\"],\n69\t    \"properties\": {\"note\": {\"type\": \"string\", \"description\": \"anything\"}},\n70\t}\n71\t\n72\tCOPIED = (\"orchestration\", \"schemas\", \"tests\", \"workflows\", \"prompts\",\n73\t          \"scripts\", \"rules\")\n74\t\n75\t\n76\t# --------------------------------------------------------------------------\n77\t# The manifest is the declaration\n78\t# --------------------------------------------------------------------------\n79\t\n80\t\n81\tdef test_manifest_names_exactly_the_six_shipped_schemas():\n82\t    \"\"\"No schema added and none removed by this story.\"\"\"\n83\t    manifest = json.loads(\n84\t        (REPO_ROOT / \"schemas\" / \"manifest.json\").read_text(encoding=\"utf-8\"))\n85\t    assert sorted(manifest[schema_validator.MANIFEST_KEY]) == sorted(EXPECTED_SCHEMAS)\n86\t\n87\t\n88\tdef test_every_named_schema_has_a_file_and_every_file_is_named():\n89\t    directory = REPO_ROOT / \"schemas\"\n90\t    assert {p.name for p in directory.glob(\"*.schema.json\")} == \\\n91\t        {f\"{name}.schema.json\" for name in EXPECTED_SCHEMAS}\n92\t\n93\t\n94\tdef test_shipped_schemas_returns_the_declared_names():\n95\t    assert sorted(schema_validator.shipped_schemas()) == sorted(EXPECTED_SCHEMAS)\n96\t    assert isinstance(schema_validator.shipped_schemas(), tuple)\n97\t\n98\t\n99\tdef test_shipped_schemas_accepts_a_harness_root_override(tmp_path: Path):\n100\t    \"\"\"The override behaves like load_schema's and schemas_dir's: the caller's\n101\t    root, not the module's.\"\"\"\n102\t    (tmp_path / \"schemas\").mkdir()\n103\t    (tmp_path / \"schemas\" / \"manifest.json\").write_text(\n104\t        json.dumps({schema_validator.MANIFEST_KEY: [\"only-this-one\"]}),\n105\t        encoding=\"utf-8\")\n106\t    assert schema_validator.shipped_schemas(tmp_path) == (\"only-this-one\",)\n107\t    # And the default root is untouched by the override.\n108\t    assert sorted(schema_validator.shipped_schemas()) == sorted(EXPECTED_SCHEMAS)\n109\t\n110\t\n111\tdef test_shipped_schemas_carries_type_hints():\n112\t    annotations = schema_validator.shipped_schemas.__annotations__\n113\t    assert \"harness_root\" in annotations\n114\t    assert \"return\" in annotations\n115\t    source = ast.parse((REPO_ROOT / \"orchestration\" / \"schema_validator.py\")\n116\t                       .read_text(encoding=\"utf-8\"))\n117\t    function = next(node for node in source.body\n118\t                    if isinstance(node, ast.FunctionDef)\n119\t                    and node.name == \"shipped_schemas\")\n120\t    assert ast.unparse(function.returns) == \"tuple[str, ...]\"\n121\t    argument = function.args.args[0]\n122\t    assert argument.arg == \"harness_root\" and argument.annotation is not None\n123\t\n124\t\n125\t# --------------------------------------------------------------------------\n126\t# A degraded manifest raises rather than emptying the inventory\n127\t# --------------------------------------------------------------------------\n128\t\n129\t\n130\t@pytest.mark.parametrize(\"payload\", [\n131\t    pytest.param(None, id=\"missing-file\"),\n132\t    pytest.param(\"{ not json\", id=\"unparseable\"),\n133\t    pytest.param('[\"changed-files\"]', id=\"top-level-array\"),\n134\t    pytest.param('\"changed-files\"', id=\"top-level-string\"),\n135\t    pytest.param(\"{}\", id=\"no-schemas-key\"),\n136\t    pytest.param('{\"schemas\": \"changed-files\"}', id=\"schemas-not-a-list\"),\n137\t    pytest.param('{\"schemas\": [\"changed-files\", 7]}', id=\"entry-not-a-string\"),\n138\t    pytest.param('{\"schemas\": [\"changed-files\", \"\"]}', id=\"empty-entry\"),\n139\t])\n140\tdef test_a_degraded_manifest_raises(tmp_path: Path, payload):\n141\t    \"\"\"An empty or partial inventory would make the per-schema parametrized\n142\t    checks expand over nothing and pass vacuously, which is worse than the\n143\t    loud failure.\"\"\"\n144\t    (tmp_path / \"schemas\").mkdir()\n145\t    if payload is not None:\n146\t        (tmp_path / \"schemas\" / \"manifest.json\").write_text(payload, encoding=\"utf-8\")\n147\t    with pytest.raises(Exception) as raised:\n148\t        schema_validator.shipped_schemas(tmp_path)\n149\t    assert not isinstance(raised.value, AssertionError)\n150\t\n151\t\n152\tdef test_an_empty_inventory_is_never_returned_for_a_degraded_manifest(tmp_path: Path):\n153\t    \"\"\"The failure mode this guards is silence, so state it as its own fact.\"\"\"\n154\t    (tmp_path / \"schemas\").mkdir()\n155\t    try:\n156\t        result = schema_validator.shipped_schemas(tmp_path)\n157\t    except Exception:\n158\t        return\n159\t    raise AssertionError(f\"missing manifest yielded {result!r} instead of raising\")\n160\t\n161\t\n162\t# --------------------------------------------------------------------------\n163\t# Exactly one declared inventory survives, established by search\n164\t# --------------------------------------------------------------------------\n165\t\n166\t\n167\t# A collection naming this many of the six is claiming to be the inventory.\n168\t# Not two: tests legitimately name the pair of schemas one prompt injects,\n169\t# or the pair of artifacts one stage writes, and those are references to\n170\t# particular schemas rather than a statement of what the harness ships.\n171\tINVENTORY_THRESHOLD = 4\n172\t\n173\tSCHEMA_NAME_LITERALS = set(EXPECTED_SCHEMAS) | {\n174\t    f\"{name}.schema.json\" for name in EXPECTED_SCHEMAS}\n175\t\n176\t\n177\tdef _python_inventories(tree: ast.AST) -> list[tuple[int, list[str]]]:\n178\t    \"\"\"Every collection literal in the tree that reads as a schema inventory.\"\"\"\n179\t    found = []\n180\t    for node in ast.walk(tree):\n181\t        elements = None\n182\t        if isinstance(node, (ast.List, ast.Tuple, ast.Set)):\n183\t            elements = node.elts\n184\t        elif isinstance(node, ast.Call) and isinstance(node.func, ast.Name) \\\n185\t                and node.func.id in {\"set\", \"frozenset\", \"tuple\", \"list\"} \\\n186\t                and len(node.args) == 1 \\\n187\t                and isinstance(node.args[0], (ast.List, ast.Tuple, ast.Set)):\n188\t            elements = node.args[0].elts\n189\t        if elements is None:\n190\t            continue\n191\t        literals = [e.value for e in elements\n192\t                    if isinstance(e, ast.Constant) and e.value in SCHEMA_NAME_LITERALS]\n193\t        if len(literals) >= INVENTORY_THRESHOLD:\n194\t            found.append((node.lineno, literals))\n195\t    return found\n196\t\n197\t\n198\tdef _json_inventories(payload) -> list[list[str]]:\n199\t    found = []\n200\t    if isinstance(payload, list):\n201\t        literals = [v for v in payload\n202\t                    if isinstance(v, str) and v in SCHEMA_NAME_LITERALS]\n203\t        if len(literals) >= INVENTORY_THRESHOLD:\n204\t            found.append(literals)\n205\t        for item in payload:\n206\t            found.extend(_json_inventories(item))\n207\t    elif isinstance(payload, dict):\n208\t        keys = [k for k in payload if k in SCHEMA_NAME_LITERALS]\n209\t        if len(keys) >= INVENTORY_THRESHOLD:\n210\t            found.append(keys)\n211\t        for value in payload.values():\n212\t            found.extend(_json_inventories(value))\n213\t    return found\n214\t\n215\t\n216\tdef test_no_literal_inventory_of_schema_names_remains_in_tests_or_orchestration():\n217\t    \"\"\"By search, not by inspection: nowhere under tests/ or orchestration/\n218\t    does a collection of schema names still exist.\"\"\"\n219\t    offenders = {}\n220\t    for directory in (\"tests\", \"orchestration\"):\n221\t        for path in sorted((REPO_ROOT / directory).rglob(\"*.py\")):\n222\t            if path.name == Path(__file__).name:\n223\t                continue    # this module names them on purpose, as the check\n224\t            tree = ast.parse(path.read_text(encoding=\"utf-8\"))\n225\t            for lineno, literals in _python_inventories(tree):\n226\t                offenders[f\"{path.relative_to(REPO_ROOT)}:{lineno}\"] = literals\n227\t    assert offenders == {}\n228\t\n229\t\n230\tdef test_the_two_inventory_constants_are_gone_by_name():\n231\t    \"\"\"The exact statement of the deletion, alongside the fuzzier search\n232\t    above: no module anywhere still binds a collection literal to a name\n233\t    that reads as a shipped-schema inventory.\"\"\"\n234\t    survivors = {}\n235\t    for directory in (\"tests\", \"orchestration\"):\n236\t        for path in sorted((REPO_ROOT / directory).rglob(\"*.py\")):\n237\t            if path.name == Path(__file__).name:\n238\t                continue\n239\t            tree = ast.parse(path.read_text(encoding=\"utf-8\"))\n240\t            for node in ast.walk(tree):\n241\t                if not isinstance(node, ast.Assign):\n242\t                    continue\n243\t                targets = [t.id for t in node.targets if isinstance(t, ast.Name)]\n244\t                if not any(\"SHIPPED\" in name for name in targets):\n245\t                    continue\n246\t                if isinstance(node.value, (ast.List, ast.Tuple, ast.Set, ast.Dict)):\n247\t                    survivors[str(path.relative_to(REPO_ROOT))] = targets\n248\t    assert survivors == {}\n249\t\n250\t\n251\tdef test_the_manifest_is_the_only_file_declaring_the_full_inventory():\n252\t    \"\"\"Search the whole shipped tree rather than the two files the story\n253\t    expected: a third copy anywhere is the thing being ruled out.\"\"\"\n254\t    carriers = []\n255\t    for directory in COPIED:\n256\t        for path in sorted((REPO_ROOT / directory).rglob(\"*\")):\n257\t            if not path.is_file() or \"__pycache__\" in path.parts:\n258\t                continue\n259\t            if path.name == Path(__file__).name:\n260\t                continue\n261\t            try:\n262\t                text = path.read_text(encoding=\"utf-8\")\n263\t            except (OSError, UnicodeDecodeError):\n264\t                continue\n265\t            if path.suffix == \".py\":\n266\t                if _python_inventories(ast.parse(text)):\n267\t                    carriers.append(str(path.relative_to(REPO_ROOT)))\n268\t            elif path.suffix == \".json\":\n269\t                if _json_inventories(json.loads(text)):\n270\t                    carriers.append(str(path.relative_to(REPO_ROOT)))\n271\t    assert carriers == [\"schemas/manifest.json\"]\n272\t\n273\t\n274\tdef test_both_inventory_modules_read_the_shared_accessor():\n275\t    for relative in INVENTORY_TEST_FILES:\n276\t        text = (REPO_ROOT / relative).read_text(encoding=\"utf-8\")\n277\t        assert \"shipped_schemas()\" in text, relative\n278\t\n279\t\n280\t# --------------------------------------------------------------------------\n281\t# The surviving assertions are exact equality, not a subset\n282\t# --------------------------------------------------------------------------\n283\t\n284\t\n285\tdef _assert_ops(path: Path, test_name: str) -> list[str]:\n286\t    tree = ast.parse(path.read_text(encoding=\"utf-8\"))\n287\t    function = next(node for node in ast.walk(tree)\n288\t                    if isinstance(node, ast.FunctionDef) and node.name == test_name)\n289\t    operators = []\n290\t    for node in ast.walk(function):\n291\t        if isinstance(node, ast.Compare):\n292\t            operators.extend(type(op).__name__ for op in node.ops)\n293\t    return operators\n294\t\n295\t\n296\t@pytest.mark.parametrize(\"node_id\", INVENTORY_TESTS)\n297\tdef test_the_inventory_assertions_are_still_exact_equality(node_id: str):\n298\t    \"\"\"Not relaxed to a subset or a containment check to make the move work.\"\"\"\n299\t    relative, test_name = node_id.split(\"::\")\n300\t    operators = _assert_ops(REPO_ROOT / relative, test_name)\n301\t    assert operators, node_id\n302\t    assert set(operators) == {\"Eq\"}, (node_id, operators)\n303\t\n304\t\n305\t# --------------------------------------------------------------------------\n306\t# Mutation: the inventory tests actually bite, in both directions\n307\t# --------------------------------------------------------------------------\n308\t\n309\t\n310\t@pytest.fixture(scope=\"module\")\n311\tdef pristine_harness(tmp_path_factory) -> Path:\n312\t    \"\"\"A copy of the shipped harness the mutation tests each clone.\"\"\"\n313\t    root = tmp_path_factory.mktemp(\"harness\")\n314\t    for name in COPIED:\n315\t        shutil.copytree(REPO_ROOT / name, root / name,\n316\t                        ignore=shutil.ignore_patterns(\"__pycache__\"))\n317\t    return root\n318\t\n319\t\n320\t@pytest.fixture\n321\tdef harness_copy(pristine_harness: Path, tmp_path: Path) -> Path:\n322\t    root = tmp_path / \"harness\"\n323\t    shutil.copytree(pristine_harness, root)\n324\t    return root\n325\t\n326\t\n327\tdef run_inventory_tests(root: Path, node_ids=INVENTORY_TESTS) -> subprocess.CompletedProcess:\n328\t    return subprocess.run(\n329\t        [sys.executable, \"-m\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\", *node_ids],\n330\t        cwd=root, capture_output=True, text=True)\n331\t\n332\t\n333\tdef read_manifest(root: Path) -> dict:\n334\t    return json.loads((root / \"schemas\" / \"manifest.json\").read_text(encoding=\"utf-8\"))\n335\t\n336\t\n337\tdef write_manifest(root: Path, names) -> None:\n338\t    (root / \"schemas\" / \"manifest.json\").write_text(\n339\t        json.dumps({schema_validator.MANIFEST_KEY: sorted(names)}, indent=2) + \"\\n\",\n340\t        encoding=\"utf-8\")\n341\t\n342\t\n343\tdef test_the_unmutated_copy_passes_the_inventory_tests(harness_copy: Path):\n344\t    \"\"\"The control. Without it, every failure below could be an artifact of\n345\t    the copy rather than of the mutation.\"\"\"\n346\t    result = run_inventory_tests(harness_copy)\n347\t    assert result.returncode == 0, result.stdout + result.stderr\n348\t\n349\t\n350\tdef test_a_schema_file_with_no_manifest_entry_fails_a_test(harness_copy: Path):\n351\t    (harness_copy / \"schemas\" / \"throwaway.schema.json\").write_text(\n352\t        json.dumps(THROWAWAY_SCHEMA, indent=2) + \"\\n\", encoding=\"utf-8\")\n353\t    result = run_inventory_tests(harness_copy)\n354\t    assert result.returncode != 0, result.stdout\n355\t\n356\t\n357\tdef test_a_manifest_entry_with_no_schema_file_fails_a_test(harness_copy: Path):\n358\t    write_manifest(harness_copy,\n359\t                   read_manifest(harness_copy)[schema_validator.MANIFEST_KEY]\n360\t                   + [\"throwaway\"])\n361\t    result = run_inventory_tests(harness_copy)\n362\t    assert result.returncode != 0, result.stdout\n363\t\n364\t\n365\tdef test_removing_a_schema_file_but_not_its_manifest_entry_fails_a_test(\n366\t        harness_copy: Path):\n367\t    (harness_copy / \"schemas\" / \"retry-guidance.schema.json\").unlink()\n368\t    result = run_inventory_tests(harness_copy)\n369\t    assert result.returncode != 0, result.stdout\n370\t\n371\t\n372\tdef test_removing_a_manifest_entry_but_not_its_schema_file_fails_a_test(\n373\t        harness_copy: Path):\n374\t    names = [n for n in read_manifest(harness_copy)[schema_validator.MANIFEST_KEY]\n375\t             if n != \"retry-guidance\"]\n376\t    write_manifest(harness_copy, names)\n377\t    result = run_inventory_tests(harness_copy)\n378\t    assert result.returncode != 0, result.stdout\n379\t\n380\t\n381\t@pytest.mark.parametrize(\"stray\", [\"README.md\", \"notes.json\", \"draft.schema.yaml\"])\n382\tdef test_a_stray_non_schema_file_in_schemas_still_fails_a_test(\n383\t        harness_copy: Path, stray: str):\n384\t    \"\"\"Narrowing the glob to *.schema.json must not open the hole glob(\"*\")\n385\t    closed.\"\"\"\n386\t    (harness_copy / \"schemas\" / stray).write_text(\"stray\\n\", encoding=\"utf-8\")\n387\t    result = run_inventory_tests(harness_copy)\n388\t    assert result.returncode != 0, result.stdout\n389\t\n390\t\n391\tdef test_a_bogus_manifest_entry_fails_the_per_schema_checks_too(harness_copy: Path):\n392\t    \"\"\"A name in the manifest whose file is not a valid schema must fail\n393\t    loudly rather than silently widening the inventory.\"\"\"\n394\t    (harness_copy / \"schemas\" / \"throwaway.schema.json\").write_text(\n395\t        json.dumps({\"type\": \"object\", \"additionalProperties\": False}) + \"\\n\",\n396\t        encoding=\"utf-8\")\n397\t    write_manifest(harness_copy,\n398\t                   read_manifest(harness_copy)[schema_validator.MANIFEST_KEY]\n399\t                   + [\"throwaway\"])\n400\t    result = run_inventory_tests(\n401\t        harness_copy,\n402\t        node_ids=(*INVENTORY_TESTS,\n403\t                  \"tests/test_story_004_validation.py\"\n404\t                  \"::test_no_schema_constrains_a_field_the_validator_cannot_check\"))\n405\t    assert result.returncode != 0, result.stdout\n406\t\n407\t\n408\t# --------------------------------------------------------------------------\n409\t# The central property, demonstrated rather than argued\n410\t# --------------------------------------------------------------------------\n411\t\n412\t\n413\tdef test_adding_a_schema_requires_edits_only_under_schemas(harness_copy: Path):\n414\t    \"\"\"Add a throwaway schema and its manifest line, touch nothing else, and\n415\t    show every inventory check passes - including the per-schema parametrized\n416\t    ones, which now expand over it. Then show tests/ is byte-identical to the\n417\t    shipped tree, so no path under tests/ was among the edits.\"\"\"\n418\t    (harness_copy / \"schemas\" / \"throwaway.schema.json\").write_text(\n419\t        json.dumps(THROWAWAY_SCHEMA, indent=2) + \"\\n\", encoding=\"utf-8\")\n420\t    write_manifest(harness_copy,\n421\t                   read_manifest(harness_copy)[schema_validator.MANIFEST_KEY]\n422\t                   + [\"throwaway\"])\n423\t\n424\t    result = run_inventory_tests(harness_copy, node_ids=INVENTORY_TEST_FILES)\n425\t    assert result.returncode == 0, result.stdout + result.stderr\n426\t    # The per-schema cases parametrize over the manifest, so the new schema\n427\t    # was actually checked rather than merely tolerated.\n428\t    parametrized = run_inventory_tests(\n429\t        harness_copy,\n430\t        node_ids=(\"tests/test_schema_validator.py\", \"tests/test_story_004_validation.py\",\n431\t                  \"-k\", \"throwaway\"))\n432\t    assert parametrized.returncode == 0, parametrized.stdout\n433\t    assert \"no tests ran\" not in parametrized.stdout, parametrized.stdout\n434\t\n435\t    differences = subprocess.run(\n436\t        [\"diff\", \"-r\", \"-x\", \"__pycache__\", str(REPO_ROOT / \"tests\"),\n437\t         str(harness_copy / \"tests\")],\n438\t        capture_output=True, text=True)\n439\t    assert differences.stdout == \"\", differences.stdout\n440\t    assert differences.returncode == 0\n441\t\n442\t\n443\t# --------------------------------------------------------------------------\n444\t# Nothing else moved\n445\t# --------------------------------------------------------------------------\n446\t\n447\t\n448\tdef test_the_injected_schema_placeholder_set_is_unchanged():\n449\t    \"\"\"schema_context globs *.schema.json, so the manifest becomes no\n450\t    placeholder.\"\"\"\n451\t    context = context_assembler.schema_context(REPO_ROOT)\n452\t    assert set(context) == {name.replace(\"-\", \"_\") + \"_schema\"\n453\t                            for name in EXPECTED_SCHEMAS}\n454\t    assert \"manifest_schema\" not in context\n455\t    assert \"manifest\" not in \" \".join(context)\n456\t\n457\t\n458\tdef test_no_prompt_template_references_a_manifest_placeholder():\n459\t    for path in sorted((REPO_ROOT / \"prompts\").glob(\"*.md\")):\n460\t        assert \"{{manifest\" not in path.read_text(encoding=\"utf-8\"), path.name\n461\t\n462\t\n463\tdef test_nothing_in_orchestration_routes_on_the_manifest():\n464\t    \"\"\"shipped_schemas has no caller inside orchestration/, and no module\n465\t    other than schema_validator names the manifest at all.\"\"\"\n466\t    for path in sorted((REPO_ROOT / \"orchestration\").glob(\"*.py\")):\n467\t        if path.name == \"schema_validator.py\":\n468\t            continue\n469\t        text = path.read_text(encoding=\"utf-8\")\n470\t        assert \"manifest\" not in text, path.name\n471\t        assert \"shipped_schemas\" not in text, path.name\n472\t\n473\t\n474\tdef test_the_coordinator_is_untouched_by_this_story():\n475\t    result = subprocess.run(\n476\t        [\"git\", \"-C\", str(REPO_ROOT), \"diff\", \"HEAD\", \"--\",\n477\t         \"orchestration/story_coordinator.py\", \"workflows/\", \"prompts/\",\n478\t         \"rules/\", \"scripts/\"],\n479\t        capture_output=True, text=True, check=True)\n480\t    assert result.stdout.strip() == \"\"\n481\t\n482\t\n483\tdef test_no_shipped_schema_was_edited_by_this_story():\n484\t    result = subprocess.run(\n485\t        [\"git\", \"-C\", str(REPO_ROOT), \"diff\", \"HEAD\", \"--\", \"schemas/\"],\n486\t        capture_output=True, text=True, check=True)\n487\t    assert result.stdout.strip() == \"\"\n488\t    assert schema_validator.SUPPORTED_KEYWORDS == frozenset(\n489\t        {\"type\", \"required\", \"properties\", \"items\", \"enum\"})\n490\t\n491\t\n492\tdef test_the_implementer_added_no_test_file_and_no_test_function():\n493\t    \"\"\"Its edits under tests/ are the two deletions and their repointing.\"\"\"\n494\t    status = subprocess.run(\n495\t        [\"git\", \"-C\", str(REPO_ROOT), \"status\", \"--porcelain\", \"--\", \"tests/\"],\n496\t        capture_output=True, text=True, check=True).stdout.splitlines()\n497\t    added = sorted(line[3:] for line in status if line[:2] in {\"??\", \"A \"})\n498\t    assert added == [f\"tests/{Path(__file__).name}\"], added\n499\t\n500\t    diff = subprocess.run(\n501\t        [\"git\", \"-C\", str(REPO_ROOT), \"diff\", \"HEAD\", \"--\", *INVENTORY_TEST_FILES],\n502\t        capture_output=True, text=True, check=True).stdout\n503\t    added_lines = [line[1:] for line in diff.splitlines()\n504\t                   if line.startswith(\"+\") and not line.startswith(\"+++\")]\n505\t    assert not [line for line in added_lines if line.startswith(\"def test\")], added_lines\n506\t"}]},"parent_tool_use_id":null,"session_id":"82dc0f29-1ff9-446a-9d67-77bc657cafda","uuid":"13271ca2-bcfd-4e4d-8183-176f97f4e924","timestamp":"2026-08-07T15:38:13.365Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jerodw/Work/AgenticProgramming/level-five/tests/test_story_013_validation.py","content":"\"\"\"story-013: the schema inventory moves out of tests/ into schemas/manifest.json.\n\nThe story's claim is that the inventory can live beside the schemas it\ndeclares without losing what made it valuable: adding an artifact shape to\nthe harness still cannot happen unnoticed. These tests hold that claim to\nits two halves.\n\nThe declaration half is checked directly - the manifest names exactly the\nsix shipped schemas, the accessor reads it, and every degradation path\nraises instead of handing back an empty inventory that would make the\nper-schema parametrized checks silently vacuous.\n\nThe enforcement half is checked by mutation rather than by reading the\nassertions and reasoning about them. A copy of the harness is made in a\ntemporary directory, one thing is changed in it - a schema file with no\nmanifest entry, a manifest entry with no schema file, a stray non-schema\nfile - and the repository's own inventory tests are run against that copy\nto show they fail. The same machinery demonstrates the story's central\nproperty: adding a schema together with its manifest line turns the suite\ngreen again while every file under tests/ stays byte-identical, so the\npaths a new schema requires editing are all under schemas/ and none are\nunder tests/.\n\"\"\"\nimport ast\nimport json\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nimport context_assembler\nimport schema_validator\n\nREPO_ROOT = Path(schema_validator.__file__).resolve().parents[1]\n\n# Named here, not read from the manifest: this is the story's own statement\n# of what the harness ships today, and it is the thing the manifest is\n# checked against. Reading it from the manifest would check nothing.\nEXPECTED_SCHEMAS = (\n    \"changed-files\",\n    \"execution-history\",\n    \"retry-guidance\",\n    \"story\",\n    \"test-results\",\n    \"verification-result\",\n)\n\n# The two tests that hold the directory to the declared inventory. Both are\n# run against mutated copies of the harness below.\nINVENTORY_TESTS = (\n    \"tests/test_schema_validator.py::test_shipped_schemas_are_exactly_the_named_ones\",\n    \"tests/test_story_004_validation.py::test_schemas_directory_holds_exactly_the_named_schemas\",\n)\n\nINVENTORY_TEST_FILES = (\"tests/test_schema_validator.py\",\n                        \"tests/test_story_004_validation.py\")\n\n# A well-formed schema in the subset the validator supports, so a mutation\n# test fails because of the inventory and never because the file it added is\n# a bad schema.\nTHROWAWAY_SCHEMA = {\n    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n    \"title\": \"throwaway\",\n    \"description\": \"A schema added by a test to exercise the inventory.\",\n    \"type\": \"object\",\n    \"required\": [\"note\"],\n    \"properties\": {\"note\": {\"type\": \"string\", \"description\": \"anything\"}},\n}\n\nCOPIED = (\"orchestration\", \"schemas\", \"tests\", \"workflows\", \"prompts\",\n          \"scripts\", \"rules\")\n\n\n# --------------------------------------------------------------------------\n# The manifest is the declaration\n# --------------------------------------------------------------------------\n\n\ndef test_manifest_names_exactly_the_six_shipped_schemas():\n    \"\"\"No schema added and none removed by this story.\"\"\"\n    manifest = json.loads(\n        (REPO_ROOT / \"schemas\" / \"manifest.json\").read_text(encoding=\"utf-8\"))\n    assert sorted(manifest[schema_validator.MANIFEST_KEY]) == sorted(EXPECTED_SCHEMAS)\n\n\ndef test_every_named_schema_has_a_file_and_every_file_is_named():\n    directory = REPO_ROOT / \"schemas\"\n    assert {p.name for p in directory.glob(\"*.schema.json\")} == \\\n        {f\"{name}.schema.json\" for name in EXPECTED_SCHEMAS}\n\n\ndef test_shipped_schemas_returns_the_declared_names():\n    assert sorted(schema_validator.shipped_schemas()) == sorted(EXPECTED_SCHEMAS)\n    assert isinstance(schema_validator.shipped_schemas(), tuple)\n\n\ndef test_shipped_schemas_accepts_a_harness_root_override(tmp_path: Path):\n    \"\"\"The override behaves like load_schema's and schemas_dir's: the caller's\n    root, not the module's.\"\"\"\n    (tmp_path / \"schemas\").mkdir()\n    (tmp_path / \"schemas\" / \"manifest.json\").write_text(\n        json.dumps({schema_validator.MANIFEST_KEY: [\"only-this-one\"]}),\n        encoding=\"utf-8\")\n    assert schema_validator.shipped_schemas(tmp_path) == (\"only-this-one\",)\n    # And the default root is untouched by the override.\n    assert sorted(schema_validator.shipped_schemas()) == sorted(EXPECTED_SCHEMAS)\n\n\ndef test_shipped_schemas_carries_type_hints():\n    annotations = schema_validator.shipped_schemas.__annotations__\n    assert \"harness_root\" in annotations\n    assert \"return\" in annotations\n    source = ast.parse((REPO_ROOT / \"orchestration\" / \"schema_validator.py\")\n                       .read_text(encoding=\"utf-8\"))\n    function = next(node for node in source.body\n                    if isinstance(node, ast.FunctionDef)\n                    and node.name == \"shipped_schemas\")\n    assert ast.unparse(function.returns) == \"tuple[str, ...]\"\n    argument = function.args.args[0]\n    assert argument.arg == \"harness_root\" and argument.annotation is not None\n\n\n# --------------------------------------------------------------------------\n# A degraded manifest raises rather than emptying the inventory\n# --------------------------------------------------------------------------\n\n\n@pytest.mark.parametrize(\"payload\", [\n    pytest.param(None, id=\"missing-file\"),\n    pytest.param(\"{ not json\", id=\"unparseable\"),\n    pytest.param('[\"changed-files\"]', id=\"top-level-array\"),\n    pytest.param('\"changed-files\"', id=\"top-level-string\"),\n    pytest.param(\"{}\", id=\"no-schemas-key\"),\n    pytest.param('{\"schemas\": \"changed-files\"}', id=\"schemas-not-a-list\"),\n    pytest.param('{\"schemas\": [\"changed-files\", 7]}', id=\"entry-not-a-string\"),\n    pytest.param('{\"schemas\": [\"changed-files\", \"\"]}', id=\"empty-entry\"),\n])\ndef test_a_degraded_manifest_raises(tmp_path: Path, payload):\n    \"\"\"An empty or partial inventory would make the per-schema parametrized\n    checks expand over nothing and pass vacuously, which is worse than the\n    loud failure.\"\"\"\n    (tmp_path / \"schemas\").mkdir()\n    if payload is not None:\n        (tmp_path / \"schemas\" / \"manifest.json\").write_text(payload, encoding=\"utf-8\")\n    with pytest.raises(Exception) as raised:\n        schema_validator.shipped_schemas(tmp_path)\n    assert not isinstance(raised.value, AssertionError)\n\n\ndef test_an_empty_inventory_is_never_returned_for_a_degraded_manifest(tmp_path: Path):\n    \"\"\"The failure mode this guards is silence, so state it as its own fact.\"\"\"\n    (tmp_path / \"schemas\").mkdir()\n    try:\n        result = schema_validator.shipped_schemas(tmp_path)\n    except Exception:\n        return\n    raise AssertionError(f\"missing manifest yielded {result!r} instead of raising\")\n\n\n# --------------------------------------------------------------------------\n# Exactly one declared inventory survives, established by search\n# --------------------------------------------------------------------------\n\n\n# A collection naming this many of the six is claiming to be the inventory.\n# Not two: tests legitimately name the pair of schemas one prompt injects,\n# or the pair of artifacts one stage writes, and those are references to\n# particular schemas rather than a statement of what the harness ships.\nINVENTORY_THRESHOLD = 4\n\nSCHEMA_NAME_LITERALS = set(EXPECTED_SCHEMAS) | {\n    f\"{name}.schema.json\" for name in EXPECTED_SCHEMAS}\n\n\ndef _python_inventories(tree: ast.AST) -> list[tuple[int, list[str]]]:\n    \"\"\"Every collection literal in the tree that reads as a schema inventory.\"\"\"\n    found = []\n    for node in ast.walk(tree):\n        elements = None\n        if isinstance(node, (ast.List, ast.Tuple, ast.Set)):\n            elements = node.elts\n        elif isinstance(node, ast.Call) and isinstance(node.func, ast.Name) \\\n                and node.func.id in {\"set\", \"frozenset\", \"tuple\", \"list\"} \\\n                and len(node.args) == 1 \\\n                and isinstance(node.args[0], (ast.List, ast.Tuple, ast.Set)):\n            elements = node.args[0].elts\n        if elements is None:\n            continue\n        literals = [e.value for e in elements\n                    if isinstance(e, ast.Constant) and e.value in SCHEMA_NAME_LITERALS]\n        if len(literals) >= INVENTORY_THRESHOLD:\n            found.append((node.lineno, literals))\n    return found\n\n\ndef _json_inventories(payload) -> list[list[str]]:\n    found = []\n    if isinstance(payload, list):\n        literals = [v for v in payload\n                    if isinstance(v, str) and v in SCHEMA_NAME_LITERALS]\n        if len(literals) >= INVENTORY_THRESHOLD:\n            found.append(literals)\n        for item in payload:\n            found.extend(_json_inventories(item))\n    elif isinstance(payload, dict):\n        keys = [k for k in payload if k in SCHEMA_NAME_LITERALS]\n        if len(keys) >= INVENTORY_THRESHOLD:\n            found.append(keys)\n        for value in payload.values():\n            found.extend(_json_inventories(value))\n    return found\n\n\ndef test_no_literal_inventory_of_schema_names_remains_in_tests_or_orchestration():\n    \"\"\"By search, not by inspection: nowhere under tests/ or orchestration/\n    does a collection of schema names still exist.\"\"\"\n    offenders = {}\n    for directory in (\"tests\", \"orchestration\"):\n        for path in sorted((REPO_ROOT / directory).rglob(\"*.py\")):\n            if path.name == Path(__file__).name:\n                continue    # this module names them on purpose, as the check\n            tree = ast.parse(path.read_text(encoding=\"utf-8\"))\n            for lineno, literals in _python_inventories(tree):\n                offenders[f\"{path.relative_to(REPO_ROOT)}:{lineno}\"] = literals\n    assert offenders == {}\n\n\ndef test_the_two_inventory_constants_are_gone_by_name():\n    \"\"\"The exact statement of the deletion, alongside the fuzzier search\n    above: no module anywhere still binds a collection literal to a name\n    that reads as a shipped-schema inventory.\"\"\"\n    survivors = {}\n    for directory in (\"tests\", \"orchestration\"):\n        for path in sorted((REPO_ROOT / directory).rglob(\"*.py\")):\n            if path.name == Path(__file__).name:\n                continue\n            tree = ast.parse(path.read_text(encoding=\"utf-8\"))\n            for node in ast.walk(tree):\n                if not isinstance(node, ast.Assign):\n                    continue\n                targets = [t.id for t in node.targets if isinstance(t, ast.Name)]\n                if not any(\"SHIPPED\" in name for name in targets):\n                    continue\n                if isinstance(node.value, (ast.List, ast.Tuple, ast.Set, ast.Dict)):\n                    survivors[str(path.relative_to(REPO_ROOT))] = targets\n    assert survivors == {}\n\n\ndef test_the_manifest_is_the_only_file_declaring_the_full_inventory():\n    \"\"\"Search the whole shipped tree rather than the two files the story\n    expected: a third copy anywhere is the thing being ruled out.\"\"\"\n    carriers = []\n    for directory in COPIED:\n        for path in sorted((REPO_ROOT / directory).rglob(\"*\")):\n            if not path.is_file() or \"__pycache__\" in path.parts:\n                continue\n            if path.name == Path(__file__).name:\n                continue\n            try:\n                text = path.read_text(encoding=\"utf-8\")\n            except (OSError, UnicodeDecodeError):\n                continue\n            if path.suffix == \".py\":\n                if _python_inventories(ast.parse(text)):\n                    carriers.append(str(path.relative_to(REPO_ROOT)))\n            elif path.suffix == \".json\":\n                if _json_inventories(json.loads(text)):\n                    carriers.append(str(path.relative_to(REPO_ROOT)))\n    assert carriers == [\"schemas/manifest.json\"]\n\n\ndef test_both_inventory_modules_read_the_shared_accessor():\n    for relative in INVENTORY_TEST_FILES:\n        text = (REPO_ROOT / relative).read_text(encoding=\"utf-8\")\n        assert \"shipped_schemas()\" in text, relative\n\n\n# --------------------------------------------------------------------------\n# The surviving assertions are exact equality, not a subset\n# --------------------------------------------------------------------------\n\n\ndef _assert_ops(path: Path, test_name: str) -> list[str]:\n    tree = ast.parse(path.read_text(encoding=\"utf-8\"))\n    function = next(node for node in ast.walk(tree)\n                    if isinstance(node, ast.FunctionDef) and node.name == test_name)\n    operators = []\n    for node in ast.walk(function):\n        if isinstance(node, ast.Compare):\n            operators.extend(type(op).__name__ for op in node.ops)\n    return operators\n\n\n@pytest.mark.parametrize(\"node_id\", INVENTORY_TESTS)\ndef test_the_inventory_assertions_are_still_exact_equality(node_id: str):\n    \"\"\"Not relaxed to a subset or a containment check to make the move work.\"\"\"\n    relative, test_name = node_id.split(\"::\")\n    operators = _assert_ops(REPO_ROOT / relative, test_name)\n    assert operators, node_id\n    assert set(operators) == {\"Eq\"}, (node_id, operators)\n\n\n# --------------------------------------------------------------------------\n# Mutation: the inventory tests actually bite, in both directions\n# --------------------------------------------------------------------------\n\n\n@pytest.fixture(scope=\"module\")\ndef pristine_harness(tmp_path_factory) -> Path:\n    \"\"\"A copy of the shipped harness the mutation tests each clone.\"\"\"\n    root = tmp_path_factory.mktemp(\"harness\")\n    for name in COPIED:\n        shutil.copytree(REPO_ROOT / name, root / name,\n                        ignore=shutil.ignore_patterns(\"__pycache__\"))\n    return root\n\n\n@pytest.fixture\ndef harness_copy(pristine_harness: Path, tmp_path: Path) -> Path:\n    root = tmp_path / \"harness\"\n    shutil.copytree(pristine_harness, root)\n    return root\n\n\ndef run_inventory_tests(root: Path, node_ids=INVENTORY_TESTS) -> subprocess.CompletedProcess:\n    return subprocess.run(\n        [sys.executable, \"-m\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\", *node_ids],\n        cwd=root, capture_output=True, text=True)\n\n\ndef read_manifest(root: Path) -> dict:\n    return json.loads((root / \"schemas\" / \"manifest.json\").read_text(encoding=\"utf-8\"))\n\n\ndef write_manifest(root: Path, names) -> None:\n    (root / \"schemas\" / \"manifest.json\").write_text(\n        json.dumps({schema_validator.MANIFEST_KEY: sorted(names)}, indent=2) + \"\\n\",\n        encoding=\"utf-8\")\n\n\ndef test_the_unmutated_copy_passes_the_inventory_tests(harness_copy: Path):\n    \"\"\"The control. Without it, every failure below could be an artifact of\n    the copy rather than of the mutation.\"\"\"\n    result = run_inventory_tests(harness_copy)\n    assert result.returncode == 0, result.stdout + result.stderr\n\n\ndef test_a_schema_file_with_no_manifest_entry_fails_a_test(harness_copy: Path):\n    (harness_copy / \"schemas\" / \"throwaway.schema.json\").write_text(\n        json.dumps(THROWAWAY_SCHEMA, indent=2) + \"\\n\", encoding=\"utf-8\")\n    result = run_inventory_tests(harness_copy)\n    assert result.returncode != 0, result.stdout\n\n\ndef test_a_manifest_entry_with_no_schema_file_fails_a_test(harness_copy: Path):\n    write_manifest(harness_copy,\n                   read_manifest(harness_copy)[schema_validator.MANIFEST_KEY]\n                   + [\"throwaway\"])\n    result = run_inventory_tests(harness_copy)\n    assert result.returncode != 0, result.stdout\n\n\ndef test_removing_a_schema_file_but_not_its_manifest_entry_fails_a_test(\n        harness_copy: Path):\n    (harness_copy / \"schemas\" / \"retry-guidance.schema.json\").unlink()\n    result = run_inventory_tests(harness_copy)\n    assert result.returncode != 0, result.stdout\n\n\ndef test_removing_a_manifest_entry_but_not_its_schema_file_fails_a_test(\n        harness_copy: Path):\n    names = [n for n in read_manifest(harness_copy)[schema_validator.MANIFEST_KEY]\n             if n != \"retry-guidance\"]\n    write_manifest(harness_copy, names)\n    result = run_inventory_tests(harness_copy)\n    assert result.returncode != 0, result.stdout\n\n\n@pytest.mark.parametrize(\"stray\", [\"README.md\", \"notes.json\", \"draft.schema.yaml\"])\ndef test_a_stray_non_schema_file_in_schemas_still_fails_a_test(\n        harness_copy: Path, stray: str):\n    \"\"\"Narrowing the glob to *.schema.json must not open the hole glob(\"*\")\n    closed.\"\"\"\n    (harness_copy / \"schemas\" / stray).write_text(\"stray\\n\", encoding=\"utf-8\")\n    result = run_inventory_tests(harness_copy)\n    assert result.returncode != 0, result.stdout\n\n\ndef test_a_bogus_manifest_entry_fails_the_per_schema_checks_too(harness_copy: Path):\n    \"\"\"A name in the manifest whose file is not a valid schema must fail\n    loudly rather than silently widening the inventory.\"\"\"\n    (harness_copy / \"schemas\" / \"throwaway.schema.json\").write_text(\n        json.dumps({\"type\": \"object\", \"additionalProperties\": False}) + \"\\n\",\n        encoding=\"utf-8\")\n    write_manifest(harness_copy,\n                   read_manifest(harness_copy)[schema_validator.MANIFEST_KEY]\n                   + [\"throwaway\"])\n    result = run_inventory_tests(\n        harness_copy,\n        node_ids=(*INVENTORY_TESTS,\n                  \"tests/test_story_004_validation.py\"\n                  \"::test_no_schema_constrains_a_field_the_validator_cannot_check\"))\n    assert result.returncode != 0, result.stdout\n\n\n# --------------------------------------------------------------------------\n# The central property, demonstrated rather than argued\n# --------------------------------------------------------------------------\n\n\ndef test_adding_a_schema_requires_edits_only_under_schemas(harness_copy: Path):\n    \"\"\"Add a throwaway schema and its manifest line, touch nothing else, and\n    show every inventory check passes - including the per-schema parametrized\n    ones, which now expand over it. Then show tests/ is byte-identical to the\n    shipped tree, so no path under tests/ was among the edits.\"\"\"\n    (harness_copy / \"schemas\" / \"throwaway.schema.json\").write_text(\n        json.dumps(THROWAWAY_SCHEMA, indent=2) + \"\\n\", encoding=\"utf-8\")\n    write_manifest(harness_copy,\n                   read_manifest(harness_copy)[schema_validator.MANIFEST_KEY]\n                   + [\"throwaway\"])\n\n    result = run_inventory_tests(harness_copy, node_ids=INVENTORY_TEST_FILES)\n    assert result.returncode == 0, result.stdout + result.stderr\n    # The per-schema cases parametrize over the manifest, so the new schema\n    # was actually checked rather than merely tolerated.\n    parametrized = run_inventory_tests(\n        harness_copy,\n        node_ids=(\"tests/test_schema_validator.py\", \"tests/test_story_004_validation.py\",\n                  \"-k\", \"throwaway\"))\n    assert parametrized.returncode == 0, parametrized.stdout\n    assert \"no tests ran\" not in parametrized.stdout, parametrized.stdout\n\n    differences = subprocess.run(\n        [\"diff\", \"-r\", \"-x\", \"__pycache__\", str(REPO_ROOT / \"tests\"),\n         str(harness_copy / \"tests\")],\n        capture_output=True, text=True)\n    assert differences.stdout == \"\", differences.stdout\n    assert differences.returncode == 0\n\n\n# --------------------------------------------------------------------------\n# Nothing else moved\n# --------------------------------------------------------------------------\n\n\ndef test_the_injected_schema_placeholder_set_is_unchanged():\n    \"\"\"schema_context globs *.schema.json, so the manifest becomes no\n    placeholder.\"\"\"\n    context = context_assembler.schema_context(REPO_ROOT)\n    assert set(context) == {name.replace(\"-\", \"_\") + \"_schema\"\n                            for name in EXPECTED_SCHEMAS}\n    assert \"manifest_schema\" not in context\n    assert \"manifest\" not in \" \".join(context)\n\n\ndef test_no_prompt_template_references_a_manifest_placeholder():\n    for path in sorted((REPO_ROOT / \"prompts\").glob(\"*.md\")):\n        assert \"{{manifest\" not in path.read_text(encoding=\"utf-8\"), path.name\n\n\ndef test_nothing_in_orchestration_routes_on_the_manifest():\n    \"\"\"shipped_schemas has no caller inside orchestration/, and no module\n    other than schema_validator names the manifest at all.\"\"\"\n    for path in sorted((REPO_ROOT / \"orchestration\").glob(\"*.py\")):\n        if path.name == \"schema_validator.py\":\n            continue\n        text = path.read_text(encoding=\"utf-8\")\n        assert \"manifest\" not in text, path.name\n        assert \"shipped_schemas\" not in text, path.name\n\n\ndef test_the_coordinator_is_untouched_by_this_story():\n    result = subprocess.run(\n        [\"git\", \"-C\", str(REPO_ROOT), \"diff\", \"HEAD\", \"--\",\n         \"orchestration/story_coordinator.py\", \"workflows/\", \"prompts/\",\n         \"rules/\", \"scripts/\"],\n        capture_output=True, text=True, check=True)\n    assert result.stdout.strip() == \"\"\n\n\ndef test_no_shipped_schema_was_edited_by_this_story():\n    result = subprocess.run(\n        [\"git\", \"-C\", str(REPO_ROOT), \"diff\", \"HEAD\", \"--\", \"schemas/\"],\n        capture_output=True, text=True, check=True)\n    assert result.stdout.strip() == \"\"\n    assert schema_validator.SUPPORTED_KEYWORDS == frozenset(\n        {\"type\", \"required\", \"properties\", \"items\", \"enum\"})\n\n\ndef test_the_implementer_added_no_test_file_and_no_test_function():\n    \"\"\"Its edits under tests/ are the two deletions and their repointing.\"\"\"\n    status = subprocess.run(\n        [\"git\", \"-C\", str(REPO_ROOT), \"status\", \"--porcelain\", \"--\", \"tests/\"],\n        capture_output=True, text=True, check=True).stdout.splitlines()\n    added = sorted(line[3:] for line in status if line[:2] in {\"??\", \"A \"})\n    assert added == [f\"tests/{Path(__file__).name}\"], added\n\n    diff = subprocess.run(\n        [\"git\", \"-C\", str(REPO_ROOT), \"diff\", \"HEAD\", \"--\", *INVENTORY_TEST_FILES],\n        capture_output=True, text=True, check=True).stdout\n    added_lines = [line[1:] for line in diff.splitlines()\n                   if line.startswith(\"+\") and not line.startswith(\"+++\")]\n    assert not [line for line in added_lines if line.startswith(\"def test\")], added_lines\n","numLines":506,"startLine":1,"totalLines":506}}}
