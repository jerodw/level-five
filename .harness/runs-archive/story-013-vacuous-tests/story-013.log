{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Sk3Pgy1xpUcwbUBfc7Hi4b","type":"tool_result","content":"diff --git a/orchestration/schema_validator.py b/orchestration/schema_validator.py\nindex e92b0a9..eb41353 100644\n--- a/orchestration/schema_validator.py\n+++ b/orchestration/schema_validator.py\n@@ -23,6 +23,11 @@ from pathlib import Path\n # module rather than to a caller-supplied root.\n HARNESS_ROOT = Path(__file__).resolve().parents[1]\n \n+# The one declared inventory of shipped schema names lives beside the schemas\n+# it declares, not in a test file.\n+MANIFEST_NAME = \"manifest.json\"\n+MANIFEST_KEY = \"schemas\"\n+\n SUPPORTED_KEYWORDS = frozenset({\"type\", \"required\", \"properties\", \"items\", \"enum\"})\n \n # Annotations carry no constraint, so ignoring them ignores nothing.\n@@ -49,6 +54,40 @@ def load_schema(name: str, harness_root: Path | None = None) -> dict:\n     return json.loads(path.read_text(encoding=\"utf-8\"))\n \n \n+def shipped_schemas(harness_root: Path | None = None) -> tuple[str, ...]:\n+    \"\"\"The declared inventory of schema names, read from schemas/manifest.json.\n+\n+    The manifest is the single source of truth for which schemas the harness\n+    ships; the tests are where that declaration is checked against the\n+    directory. A missing or malformed manifest raises rather than yielding an\n+    empty or partial inventory, which would make those checks vacuous.\n+    \"\"\"\n+    path = schemas_dir(harness_root) / MANIFEST_NAME\n+    try:\n+        text = path.read_text(encoding=\"utf-8\")\n+    except OSError as error:\n+        raise ValueError(f\"{path}: schema manifest is missing or unreadable\") from error\n+    try:\n+        manifest = json.loads(text)\n+    except json.JSONDecodeError as error:\n+        raise ValueError(f\"{path}: schema manifest is not parseable as JSON\") from error\n+    if not isinstance(manifest, dict) or not isinstance(\n+        manifest.get(MANIFEST_KEY), list\n+    ):\n+        raise ValueError(\n+            f\"{path}: schema manifest must be an object with a \"\n+            f\"{MANIFEST_KEY!r} array of schema names\"\n+        )\n+    names = manifest[MANIFEST_KEY]\n+    for name in names:\n+        if not isinstance(name, str) or not name:\n+            raise ValueError(\n+                f\"{path}: every {MANIFEST_KEY} entry must be a non-empty string, \"\n+                f\"found {name!r}\"\n+            )\n+    return tuple(names)\n+\n+\n def unsupported_keywords(schema: dict) -> list[str]:\n     \"\"\"Every keyword anywhere in the schema that this validator cannot honor.\"\"\"\n     found: list[str] = []\ndiff --git a/tests/test_schema_validator.py b/tests/test_schema_validator.py\nindex 8c51fde..a8edcd6 100644\n--- a/tests/test_schema_validator.py\n+++ b/tests/test_schema_validator.py\n@@ -9,16 +9,10 @@ import pytest\n \n import schema_validator\n \n-SHIPPED = (\n-    \"changed-files\",\n-    \"test-results\",\n-    \"verification-result\",\n-    \"retry-guidance\",\n-    \"story\",\n-    # Coordinator-written rather than stage-written, so no workflow stage maps\n-    # to it; it is shipped and validator-checked like every other schema.\n-    \"execution-history\",\n-)\n+# The inventory is declared once, in schemas/manifest.json. This module is\n+# where it is checked, not where it is stored. Read at collection time so the\n+# per-schema cases below still parametrize over it.\n+SHIPPED = schema_validator.shipped_schemas()\n \n OBJECT_SCHEMA = {\n     \"type\": \"object\",\n@@ -136,8 +130,14 @@ def test_unknown_type_name_raises():\n \n \n def test_shipped_schemas_are_exactly_the_named_ones():\n-    names = sorted(p.name for p in schema_validator.schemas_dir().glob(\"*\"))\n+    directory = schema_validator.schemas_dir()\n+    names = sorted(p.name for p in directory.glob(\"*.schema.json\"))\n     assert names == sorted(f\"{name}.schema.json\" for name in SHIPPED)\n+    # The narrowed glob would ignore a stray file the old glob(\"*\") caught, so\n+    # the directory itself is still held to schemas plus the manifest.\n+    assert sorted(p.name for p in directory.iterdir()) == sorted(\n+        names + [schema_validator.MANIFEST_NAME]\n+    )\n \n \n @pytest.mark.parametrize(\"name\", SHIPPED)\ndiff --git a/tests/test_story_004_validation.py b/tests/test_story_004_validation.py\nindex f57accd..26a7b8a 100644\n--- a/tests/test_story_004_validation.py\n+++ b/tests/test_story_004_validation.py\n@@ -19,16 +19,9 @@ import story_coordinator\n import story_parser\n from agent_runner import AgentResult\n \n-SHIPPED_SCHEMAS = {\n-    \"changed-files\",\n-    \"test-results\",\n-    \"verification-result\",\n-    \"retry-guidance\",\n-    \"story\",\n-    # story-011: the coordinator's own execution-history.json. No stage maps\n-    # to it, and the inventory below stays exact.\n-    \"execution-history\",\n-}\n+# Declared once in schemas/manifest.json; this module checks that declaration\n+# against the directory rather than holding a second copy of it.\n+SHIPPED_SCHEMAS = set(schema_validator.shipped_schemas())\n \n ORIGINAL_STORY_SECTIONS = (\n     \"story\",\n@@ -118,8 +111,13 @@ def test_the_validation_step_hard_codes_no_artifact_or_schema_name():\n \n \n def test_schemas_directory_holds_exactly_the_named_schemas(harness_root):\n-    present = {p.name for p in (harness_root / \"schemas\").iterdir()}\n+    directory = harness_root / \"schemas\"\n+    present = {p.name for p in directory.glob(\"*.schema.json\")}\n     assert present == {f\"{name}.schema.json\" for name in SHIPPED_SCHEMAS}\n+    # Nothing else may sit in schemas/ except the manifest that declares them.\n+    assert {p.name for p in directory.iterdir()} == present | {\n+        schema_validator.MANIFEST_NAME\n+    }\n \n \n def test_every_required_field_is_also_a_declared_property(harness_root):","is_error":false}]},"parent_tool_use_id":null,"session_id":"82dc0f29-1ff9-446a-9d67-77bc657cafda","uuid":"0ba1f3bc-84ab-4