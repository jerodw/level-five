{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RkGLC4ipLF6p1cYxbLZFtC","type":"tool_result","content":"1\t\"\"\"Validate structured artifacts against the schemas in schemas/.\n2\t\n3\tschemas/ is the single source of truth for every artifact shape the harness\n4\troutes on: the same file is injected into the prompt that asks an agent to\n5\tproduce the artifact and read here to check what the agent produced.\n6\t\n7\tThis is a deliberately small subset of JSON Schema — type, required,\n8\tproperties, items, enum — because the harness depends on the standard\n9\tlibrary only. A schema keyword outside that subset raises rather than being\n10\tsilently ignored, so a schema can never claim a constraint the validator\n11\tdoes not enforce.\n12\t\n13\tadditionalProperties is not enforced by design: the failure mode that\n14\tmatters is a missing or mistyped field a later stage routes on, and an\n15\textra harmless key should not end a run.\n16\t\"\"\"\n17\tfrom __future__ import annotations\n18\t\n19\timport json\n20\tfrom pathlib import Path\n21\t\n22\t# Schemas ship with the harness code, so they are resolved relative to this\n23\t# module rather than to a caller-supplied root.\n24\tHARNESS_ROOT = Path(__file__).resolve().parents[1]\n25\t\n26\tSUPPORTED_KEYWORDS = frozenset({\"type\", \"required\", \"properties\", \"items\", \"enum\"})\n27\t\n28\t# Annotations carry no constraint, so ignoring them ignores nothing.\n29\tANNOTATION_KEYWORDS = frozenset({\"$schema\", \"$id\", \"title\", \"description\"})\n30\t\n31\t_TYPES: dict[str, type | tuple[type, ...]] = {\n32\t    \"object\": dict,\n33\t    \"array\": list,\n34\t    \"string\": str,\n35\t    \"integer\": int,\n36\t    \"number\": (int, float),\n37\t    \"boolean\": bool,\n38\t    \"null\": type(None),\n39\t}\n40\t\n41\t\n42\tdef schemas_dir(harness_root: Path | None = None) -> Path:\n43\t    return (harness_root or HARNESS_ROOT) / \"schemas\"\n44\t\n45\t\n46\tdef load_schema(name: str, harness_root: Path | None = None) -> dict:\n47\t    \"\"\"Read schemas/<name>.schema.json. Missing or malformed schemas raise.\"\"\"\n48\t    path = schemas_dir(harness_root) / f\"{name}.schema.json\"\n49\t    return json.loads(path.read_text(encoding=\"utf-8\"))\n50\t\n51\t\n52\tdef unsupported_keywords(schema: dict) -> list[str]:\n53\t    \"\"\"Every keyword anywhere in the schema that this validator cannot honor.\"\"\"\n54\t    found: list[str] = []\n55\t\n56\t    def walk(node: dict, path: str) -> None:\n57\t        for keyword, value in node.items():\n58\t            if keyword in ANNOTATION_KEYWORDS:\n59\t                continue\n60\t            if keyword not in SUPPORTED_KEYWORDS:\n61\t                found.append(f\"{path}{keyword}\")\n62\t                continue\n63\t            if keyword == \"properties\":\n64\t                for prop, subschema in value.items():\n65\t                    walk(subschema, f\"{path}properties.{prop}.\")\n66\t            elif keyword == \"items\":\n67\t                walk(value, f\"{path}items.\")\n68\t\n69\t    walk(schema, \"\")\n70\t    return found\n71\t\n72\t\n73\tdef validate(instance: object, schema: dict) -> list[str]:\n74\t    \"\"\"Check instance against schema; return human-readable error strings.\n75\t\n76\t    Each error names the failing JSON path, what the schema expected, and\n77\t    what was found, so an escalation message is actionable on its own.\n78\t    \"\"\"\n79\t    unsupported = unsupported_keywords(schema)\n80\t    if unsupported:\n81\t        raise ValueError(\n82\t            \"schema uses keyword(s) this validator does not support: \"\n83\t            + \", \".join(unsupported)\n84\t        )\n85\t    errors: list[str] = []\n86\t    _validate(instance, schema, \"$\", errors)\n87\t    return errors\n88\t\n89\t\n90\tdef _describe(value: object) -> str:\n91\t    return f\"{_type_name(value)} ({json.dumps(value, default=str)})\"\n92\t\n93\t\n94\tdef _type_name(value: object) -> str:\n95\t    if isinstance(value, bool):\n96\t        return \"boolean\"\n97\t    if isinstance(value, int):\n98\t        return \"integer\"\n99\t    if isinstance(value, float):\n100\t        return \"number\"\n101\t    for name, py_type in _TYPES.items():\n102\t        if name in (\"integer\", \"number\", \"boolean\"):\n103\t            continue\n104\t        if isinstance(value, py_type):\n105\t            return name\n106\t    return type(value).__name__\n107\t\n108\t\n109\tdef _matches_type(value: object, expected: str) -> bool:\n110\t    py_type = _TYPES.get(expected)\n111\t    if py_type is None:\n112\t        raise ValueError(f\"schema declares unknown type {expected!r}\")\n113\t    if expected in (\"integer\", \"number\") and isinstance(value, bool):\n114\t        return False\n115\t    if expected == \"boolean\":\n116\t        return isinstance(value, bool)\n117\t    return isinstance(value, py_type)\n118\t\n119\t\n120\tdef _validate(value: object, schema: dict, path: str, errors: list[str]) -> None:\n121\t    expected_type = schema.get(\"type\")\n122\t    if expected_type is not None and not _matches_type(value, expected_type):\n123\t        errors.append(\n124\t            f\"{path}: expected type {expected_type}, found {_describe(value)}\"\n125\t        )\n126\t        return\n127\t\n128\t    if \"enum\" in schema and value not in schema[\"enum\"]:\n129\t        allowed = \", \".join(json.dumps(option) for option in schema[\"enum\"])\n130\t        errors.append(f\"{path}: expected one of [{allowed}], found {_describe(value)}\")\n131\t\n132\t    if isinstance(value, dict):\n133\t        for key in schema.get(\"required\", []):\n134\t            if key not in value:\n135\t                errors.append(\n136\t                    f\"{path}.{key}: expected a required property, found it missing\"\n137\t                )\n138\t        for key, subschema in schema.get(\"properties\", {}).items():\n139\t            if key in value:\n140\t                _validate(value[key], subschema, f\"{path}.{key}\", errors)\n141\t\n142\t    if isinstance(value, list) and \"items\" in schema:\n143\t        for index, item in enumerate(value):\n144\t            _validate(item, schema[\"items\"], f\"{path}[{index}]\", errors)\n145\t"}]},"parent_tool_use_id":null,"session_id":"860e5b06-6762-482a-8924-2f0b0be9dbf2","uuid":"a954f1f6-55bc-46b7-ba2f-739a8355d7c0","timestamp":"2026-08-07T15:31:05.414Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jerodw/Work/AgenticProgramming/level-five/orchestration/schema_validator.py","content":"\"\"\"Validate structured artifacts against the schemas in schemas/.\n\nschemas/ is the single source of truth for every artifact shape the harness\nroutes on: the same file is injected into the prompt that asks an agent to\nproduce the artifact and read here to check what the agent produced.\n\nThis is a deliberately small subset of JSON Schema — type, required,\nproperties, items, enum — because the harness depends on the standard\nlibrary only. A schema keyword outside that subset raises rather than being\nsilently ignored, so a schema can never claim a constraint the validator\ndoes not enforce.\n\nadditionalProperties is not enforced by design: the failure mode that\nmatters is a missing or mistyped field a later stage routes on, and an\nextra harmless key should not end a run.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\n\n# Schemas ship with the harness code, so they are resolved relative to this\n# module rather than to a caller-supplied root.\nHARNESS_ROOT = Path(__file__).resolve().parents[1]\n\nSUPPORTED_KEYWORDS = frozenset({\"type\", \"required\", \"properties\", \"items\", \"enum\"})\n\n# Annotations carry no constraint, so ignoring them ignores nothing.\nANNOTATION_KEYWORDS = frozenset({\"$schema\", \"$id\", \"title\", \"description\"})\n\n_TYPES: dict[str, type | tuple[type, ...]] = {\n    \"object\": dict,\n    \"array\": list,\n    \"string\": str,\n    \"integer\": int,\n    \"number\": (int, float),\n    \"boolean\": bool,\n    \"null\": type(None),\n}\n\n\ndef schemas_dir(harness_root: Path | None = None) -> Path:\n    return (harness_root or HARNESS_ROOT) / \"schemas\"\n\n\ndef load_schema(name: str, harness_root: Path | None = None) -> dict:\n    \"\"\"Read schemas/<name>.schema.json. Missing or malformed schemas raise.\"\"\"\n    path = schemas_dir(harness_root) / f\"{name}.schema.json\"\n    return json.loads(path.read_text(encoding=\"utf-8\"))\n\n\ndef unsupported_keywords(schema: dict) -> list[str]:\n    \"\"\"Every keyword anywhere in the schema that this validator cannot honor.\"\"\"\n    found: list[str] = []\n\n    def walk(node: dict, path: str) -> None:\n        for keyword, value in node.items():\n            if keyword in ANNOTATION_KEYWORDS:\n                continue\n            if keyword not in SUPPORTED_KEYWORDS:\n                found.append(f\"{path}{keyword}\")\n                continue\n            if keyword == \"properties\":\n                for prop, subschema in value.items():\n                    walk(subschema, f\"{path}properties.{prop}.\")\n            elif keyword == \"items\":\n                walk(value, f\"{path}items.\")\n\n    walk(schema, \"\")\n    return found\n\n\ndef validate(instance: object, schema: dict) -> list[str]:\n    \"\"\"Check instance against schema; return human-readable error strings.\n\n    Each error names the failing JSON path, what the schema expected, and\n    what was found, so an escalation message is actionable on its own.\n    \"\"\"\n    unsupported = unsupported_keywords(schema)\n    if unsupported:\n        raise ValueError(\n            \"schema uses keyword(s) this validator does not support: \"\n            + \", \".join(unsupported)\n        )\n    errors: list[str] = []\n    _validate(instance, schema, \"$\", errors)\n    return errors\n\n\ndef _describe(value: object) -> str:\n    return f\"{_type_name(value)} ({json.dumps(value, default=str)})\"\n\n\ndef _type_name(value: object) -> str:\n    if isinstance(value, bool):\n        return \"boolean\"\n    if isinstance(value, int):\n        return \"integer\"\n    if isinstance(value, float):\n        return \"number\"\n    for name, py_type in _TYPES.items():\n        if name in (\"integer\", \"number\", \"boolean\"):\n            continue\n        if isinstance(value, py_type):\n            return name\n    return type(value).__name__\n\n\ndef _matches_type(value: object, expected: str) -> bool:\n    py_type = _TYPES.get(expected)\n    if py_type is None:\n        raise ValueError(f\"schema declares unknown type {expected!r}\")\n    if expected in (\"integer\", \"number\") and isinstance(value, bool):\n        return False\n    if expected == \"boolean\":\n        return isinstance(value, bool)\n    return isinstance(value, py_type)\n\n\ndef _validate(value: object, schema: dict, path: str, errors: list[str]) -> None:\n    expected_type = schema.get(\"type\")\n    if expected_type is not None and not _matches_type(value, expected_type):\n        errors.append(\n            f\"{path}: expected type {expected_type}, found {_describe(value)}\"\n        )\n        return\n\n    if \"enum\" in schema and value not in schema[\"enum\"]:\n        allowed = \", \".join(json.dumps(option) for option in schema[\"enum\"])\n        errors.append(f\"{path}: expected one of [{allowed}], found {_describe(value)}\")\n\n    if isinstance(value, dict):\n        for key in schema.get(\"required\", []):\n            if key not in value:\n                errors.append(\n                    f\"{path}.{key}: expected a required property, found it missing\"\n                )\n        for key, subschema in schema.get(\"properties\", {}).items():\n            if key in value:\n                _validate(value[key], subschema, f\"{path}.{key}\", errors)\n\n    if isinstance(value, list) and \"items\" in schema:\n        for index, item in enumerate(value):\n            _validate(item, schema[\"items\"], f\"{path}[{index}]\", errors)\n","numLines":145,"startLine":1,"totalLines":145}}}
