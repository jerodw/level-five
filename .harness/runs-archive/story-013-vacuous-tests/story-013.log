{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XakwJhPheGQamMT7LEKYCM","type":"tool_result","content":"160\t\n161\t\n162\t# --------------------------------------------------------------------------\n163\t# Exactly one declared inventory survives, established by search\n164\t# --------------------------------------------------------------------------\n165\t\n166\t\n167\tdef _schema_name_literals(tree: ast.AST) -> list[tuple[int, list[str]]]:\n168\t    \"\"\"Every collection literal in the tree holding two or more schema names.\n169\t\n170\t    Two or more, because a single name is a reference to one schema - a test\n171\t    loading changed-files.schema.json - while a collection of them is an\n172\t    inventory. The manifest is the only place an inventory may live.\n173\t    \"\"\"\n174\t    names = set(EXPECTED_SCHEMAS) | {f\"{n}.schema.json\" for n in EXPECTED_SCHEMAS}\n175\t    found = []\n176\t    for node in ast.walk(tree):\n177\t        elements = None\n178\t        if isinstance(node, (ast.List, ast.Tuple, ast.Set)):\n179\t            elements = node.elts\n180\t        elif isinstance(node, ast.Call) and isinstance(node.func, ast.Name) \\\n181\t                and node.func.id in {\"set\", \"frozenset\", \"tuple\", \"list\"} \\\n182\t                and len(node.args) == 1 \\\n183\t                and isinstance(node.args[0], (ast.List, ast.Tuple, ast.Set)):\n184\t            elements = node.args[0].elts\n185\t        if elements is None:\n186\t            continue\n187\t        literals = [e.value for e in elements\n188\t                    if isinstance(e, ast.Constant) and e.value in names]\n189\t        if len(literals) >= 2:\n190\t            found.append((node.lineno, literals))\n191\t    return found\n192\t\n193\t\n194\tdef test_no_literal_inventory_of_schema_names_remains_in_tests_or_orchestration():\n195\t    \"\"\"By search, not by inspection: nowhere under tests/ or orchestration/\n196\t    does a collection of schema names still exist.\"\"\"\n197\t    offenders = {}\n198\t    for directory in (\"tests\", \"orchestration\"):\n199\t        for path in sorted((REPO_ROOT / directory).rglob(\"*.py\")):\n200\t            if path.name == Path(__file__).name:\n201\t                continue    # this module names them on purpose, as the check\n202\t            tree = ast.parse(path.read_text(encoding=\"utf-8\"))\n203\t            for lineno, literals in _schema_name_literals(tree):\n204\t                offenders[f\"{path.relative_to(REPO_ROOT)}:{lineno}\"] = literals\n205\t    assert offenders == {}\n206\t\n207\t\n208\tdef test_the_manifest_is_the_only_file_declaring_the_full_inventory():\n209\t    \"\"\"Search the whole tree rather than the two files the story expected:\n210\t    a third copy anywhere in the shipped harness is the thing being ruled\n211\t    out.\"\"\"\n212\t    carriers = []\n213\t    for directory in COPIED:\n214\t        for path in sorted((REPO_ROOT / directory).rglob(\"*\")):\n215\t            if not path.is_file() or \"__pycache__\" in path.parts:\n216\t                continue\n217\t            if path.name == Path(__file__).name:\n218\t                continue\n219\t            try:\n220\t                text = path.read_text(encoding=\"utf-8\")\n221\t            except (OSError, UnicodeDecodeError):\n222\t                continue\n223\t            if all(name in text for name in EXPECTED_SCHEMAS):\n224\t                carriers.append(str(path.relative_to(REPO_ROOT)))\n225\t    assert carriers == [\"schemas/manifest.json\"]\n226\t\n227\t\n228\tdef test_both_inventory_modules_read_the_shared_accessor():\n229\t    for relative in INVENTORY_TEST_FILES:\n230\t        text = (REPO_ROOT / relative).read_text(encoding=\"utf-8\")\n231\t        assert \"shipped_schemas()\" in text, relative\n232\t\n233\t\n234\t# --------------------------------------------------------------------------"}]},"parent_tool_use_id":null,"session_id":"52369af0-63d7-4574-8e75-bf536bf2278f","uuid":"243623c8-1508-4399-979f-7d4421eb2538","timestamp":"2026-08-07T15:36:13.204Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jerodw/Work/AgenticProgramming/level-five/tests/test_story_013_validation.py","content":"\n\n# --------------------------------------------------------------------------\n# Exactly one declared inventory survives, established by search\n# --------------------------------------------------------------------------\n\n\ndef _schema_name_literals(tree: ast.AST) -> list[tuple[int, list[str]]]:\n    \"\"\"Every collection literal in the tree holding two or more schema names.\n\n    Two or more, because a single name is a reference to one schema - a test\n    loading changed-files.schema.json - while a collection of them is an\n    inventory. The manifest is the only place an inventory may live.\n    \"\"\"\n    names = set(EXPECTED_SCHEMAS) | {f\"{n}.schema.json\" for n in EXPECTED_SCHEMAS}\n    found = []\n    for node in ast.walk(tree):\n        elements = None\n        if isinstance(node, (ast.List, ast.Tuple, ast.Set)):\n            elements = node.elts\n        elif isinstance(node, ast.Call) and isinstance(node.func, ast.Name) \\\n                and node.func.id in {\"set\", \"frozenset\", \"tuple\", \"list\"} \\\n                and len(node.args) == 1 \\\n                and isinstance(node.args[0], (ast.List, ast.Tuple, ast.Set)):\n            elements = node.args[0].elts\n        if elements is None:\n            continue\n        literals = [e.value for e in elements\n                    if isinstance(e, ast.Constant) and e.value in names]\n        if len(literals) >= 2:\n            found.append((node.lineno, literals))\n    return found\n\n\ndef test_no_literal_inventory_of_schema_names_remains_in_tests_or_orchestration():\n    \"\"\"By search, not by inspection: nowhere under tests/ or orchestration/\n    does a collection of schema names still exist.\"\"\"\n    offenders = {}\n    for directory in (\"tests\", \"orchestration\"):\n        for path in sorted((REPO_ROOT / directory).rglob(\"*.py\")):\n            if path.name == Path(__file__).name:\n                continue    # this module names them on purpose, as the check\n            tree = ast.parse(path.read_text(encoding=\"utf-8\"))\n            for lineno, literals in _schema_name_literals(tree):\n                offenders[f\"{path.relative_to(REPO_ROOT)}:{lineno}\"] = literals\n    assert offenders == {}\n\n\ndef test_the_manifest_is_the_only_file_declaring_the_full_inventory():\n    \"\"\"Search the whole tree rather than the two files the story expected:\n    a third copy anywhere in the shipped harness is the thing being ruled\n    out.\"\"\"\n    carriers = []\n    for directory in COPIED:\n        for path in sorted((REPO_ROOT / directory).rglob(\"*\")):\n            if not path.is_file() or \"__pycache__\" in path.parts:\n                continue\n            if path.name == Path(__file__).name:\n                continue\n            try:\n                text = path.read_text(encoding=\"utf-8\")\n            except (OSError, UnicodeDecodeError):\n                continue\n            if all(name in text for name in EXPECTED_SCHEMAS):\n                carriers.append(str(path.relative_to(REPO_ROOT)))\n    assert carriers == [\"schemas/manifest.json\"]\n\n\ndef test_both_inventory_modules_read_the_shared_accessor():\n    for relative in INVENTORY_TEST_FILES:\n        text = (REPO_ROOT / relative).read_text(encoding=\"utf-8\")\n        assert \"shipped_schemas()\" in text, relative\n\n\n# --------------------------------------------------------------------------","numLines":75,"startLine":160,"totalLines":458}}}
