{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0168a47uFbntLKbHR74kkQ8Q","type":"tool_result","content":"1\t\"\"\"Independent validation for story-004: machine-readable artifact schemas.\n2\t\n3\tValidates the acceptance criteria from the artifacts outward — the shipped\n4\tschema files, the workflow declaration, the validator's error strings, and\n5\tthe coordinator's escalation path — using its own fake runner rather than\n6\tthe ones in test_story_coordinator.py or test_story_002_validation.py.\n7\t\n8\tEvery fixture here is inline. Nothing reads the repository's .harness/runs/,\n9\twhich is gitignored and absent in CI.\n10\t\"\"\"\n11\timport inspect\n12\timport json\n13\timport re\n14\tfrom pathlib import Path\n15\t\n16\timport context_assembler\n17\timport schema_validator\n18\timport story_coordinator\n19\timport story_parser\n20\tfrom agent_runner import AgentResult\n21\t\n22\tSHIPPED_SCHEMAS = {\n23\t    \"changed-files\",\n24\t    \"test-results\",\n25\t    \"verification-result\",\n26\t    \"retry-guidance\",\n27\t    \"story\",\n28\t    # story-011: the coordinator's own execution-history.json. No stage maps\n29\t    # to it, and the inventory below stays exact.\n30\t    \"execution-history\",\n31\t}\n32\t\n33\tORIGINAL_STORY_SECTIONS = (\n34\t    \"story\",\n35\t    \"tasks\",\n36\t    \"acceptance_criteria\",\n37\t    \"scope\",\n38\t    \"verification_requirements\",\n39\t    \"constraints\",\n40\t)\n41\t\n42\tPLACEHOLDER = re.compile(r\"\\{\\{[a-z_]+\\}\\}\")\n43\t\n44\t\n45\tdef _write(path: Path, payload) -> None:\n46\t    if isinstance(payload, str):\n47\t        path.write_text(payload, encoding=\"utf-8\")\n48\t    else:\n49\t        path.write_text(json.dumps(payload, indent=2) + \"\\n\", encoding=\"utf-8\")\n50\t\n51\t\n52\tdef _workflow(harness_root: Path) -> dict:\n53\t    text = (harness_root / \"workflows\" / \"story-workflow.json\").read_text()\n54\t    return {stage[\"name\"]: stage for stage in json.loads(text)[\"stages\"]}\n55\t\n56\t\n57\t# --------------------------------------------------------------------------\n58\t# The workflow definition owns the artifact-to-schema mapping\n59\t# --------------------------------------------------------------------------\n60\t\n61\t\n62\tdef test_writing_stages_declare_a_schema_for_every_json_artifact(harness_root):\n63\t    stages = _workflow(harness_root)\n64\t    for name in (\"implementer\", \"tester\", \"verifier\"):\n65\t        declared = stages[name].get(\"schemas\")\n66\t        assert declared, f\"{name} declares no schemas map\"\n67\t        for artifact, schema_name in declared.items():\n68\t            assert artifact.endswith(\".json\"), (name, artifact)\n69\t            assert schema_name in SHIPPED_SCHEMAS, (name, schema_name)\n70\t        json_outputs = [o for o in stages[name].get(\"outputs\", []) if o.endswith(\".json\")]\n71\t        assert set(json_outputs) <= set(declared), name\n72\t\n73\t\n74\tdef test_both_changed_files_records_share_one_schema_definition(harness_root):\n75\t    stages = _workflow(harness_root)\n76\t    implementer = stages[\"implementer\"][\"schemas\"][\"changed-files.json\"]\n77\t    tester = stages[\"tester\"][\"schemas\"][\"tester-changed-files.json\"]\n78\t    assert implementer == tester == \"changed-files\"\n79\t\n80\t\n81\tdef test_verifier_declares_its_conditional_artifact(harness_root):\n82\t    verifier = _workflow(harness_root)[\"verifier\"]\n83\t    assert verifier[\"schemas\"][\"verification-result.json\"] == \"verification-result\"\n84\t    assert verifier[\"schemas\"][\"retry-guidance.json\"] == \"retry-guidance\"\n85\t    # The conditional artifact is declared for validation but never required.\n86\t    assert \"retry-guidance.json\" not in verifier[\"outputs\"]\n87\t\n88\t\n89\tdef test_declared_schema_names_all_resolve_to_shipped_files(harness_root):\n90\t    for stage in _workflow(harness_root).values():\n91\t        for schema_name in stage.get(\"schemas\", {}).values():\n92\t            path = harness_root / \"schemas\" / f\"{schema_name}.schema.json\"\n93\t            assert path.is_file(), schema_name\n94\t            assert json.loads(path.read_text())[\"title\"] == schema_name\n95\t\n96\t\n97\tdef test_the_validation_step_hard_codes_no_artifact_or_schema_name():\n98\t    \"\"\"The mapping lives in the workflow, so the coordinator names nothing.\"\"\"\n99\t    source = inspect.getsource(story_coordinator._schema_violation)\n100\t    # Prose is free to name examples; only executable lines are constrained.\n101\t    lines, in_docstring = [], False\n102\t    for line in source.splitlines():\n103\t        if line.lstrip().startswith('\"\"\"'):\n104\t            in_docstring = not in_docstring\n105\t            continue\n106\t        if not in_docstring and not line.lstrip().startswith(\"#\"):\n107\t            lines.append(line)\n108\t    body = \"\\n\".join(lines)\n109\t    assert 'stage.get(\"schemas\"' in body    # the stripping left the real code\n110\t    assert \".json\" not in body\n111\t    for schema_name in SHIPPED_SCHEMAS:\n112\t        assert schema_name not in body\n113\t\n114\t\n115\t# --------------------------------------------------------------------------\n116\t# The shipped schemas\n117\t# --------------------------------------------------------------------------\n118\t\n119\t\n120\tdef test_schemas_directory_holds_exactly_the_named_schemas(harness_root):\n121\t    present = {p.name for p in (harness_root / \"schemas\").iterdir()}\n122\t    assert present == {f\"{name}.schema.json\" for name in SHIPPED_SCHEMAS}\n123\t\n124\t\n125\tdef test_every_required_field_is_also_a_declared_property(harness_root):\n126\t    \"\"\"A required name absent from properties would be an unenforceable typo.\"\"\"\n127\t\n128\t    def check(schema: dict, where: str) -> None:\n129\t        properties = schema.get(\"properties\", {})\n130\t        for name in schema.get(\"required\", []):"}]},"parent_tool_use_id":null,"session_id":"12dae280-dcd3-4d46-9098-a5267a2d04b4","uuid":"1c1a6923-2145-4a0c-b7bd-0d27b5b71e18","timestamp":"2026-08-07T18:55:49.360Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jerodw/Work/AgenticProgramming/level-five/tests/test_story_004_validation.py","content":"\"\"\"Independent validation for story-004: machine-readable artifact schemas.\n\nValidates the acceptance criteria from the artifacts outward — the shipped\nschema files, the workflow declaration, the validator's error strings, and\nthe coordinator's escalation path — using its own fake runner rather than\nthe ones in test_story_coordinator.py or test_story_002_validation.py.\n\nEvery fixture here is inline. Nothing reads the repository's .harness/runs/,\nwhich is gitignored and absent in CI.\n\"\"\"\nimport inspect\nimport json\nimport re\nfrom pathlib import Path\n\nimport context_assembler\nimport schema_validator\nimport story_coordinator\nimport story_parser\nfrom agent_runner import AgentResult\n\nSHIPPED_SCHEMAS = {\n    \"changed-files\",\n    \"test-results\",\n    \"verification-result\",\n    \"retry-guidance\",\n    \"story\",\n    # story-011: the coordinator's own execution-history.json. No stage maps\n    # to it, and the inventory below stays exact.\n    \"execution-history\",\n}\n\nORIGINAL_STORY_SECTIONS = (\n    \"story\",\n    \"tasks\",\n    \"acceptance_criteria\",\n    \"scope\",\n    \"verification_requirements\",\n    \"constraints\",\n)\n\nPLACEHOLDER = re.compile(r\"\\{\\{[a-z_]+\\}\\}\")\n\n\ndef _write(path: Path, payload) -> None:\n    if isinstance(payload, str):\n        path.write_text(payload, encoding=\"utf-8\")\n    else:\n        path.write_text(json.dumps(payload, indent=2) + \"\\n\", encoding=\"utf-8\")\n\n\ndef _workflow(harness_root: Path) -> dict:\n    text = (harness_root / \"workflows\" / \"story-workflow.json\").read_text()\n    return {stage[\"name\"]: stage for stage in json.loads(text)[\"stages\"]}\n\n\n# --------------------------------------------------------------------------\n# The workflow definition owns the artifact-to-schema mapping\n# --------------------------------------------------------------------------\n\n\ndef test_writing_stages_declare_a_schema_for_every_json_artifact(harness_root):\n    stages = _workflow(harness_root)\n    for name in (\"implementer\", \"tester\", \"verifier\"):\n        declared = stages[name].get(\"schemas\")\n        assert declared, f\"{name} declares no schemas map\"\n        for artifact, schema_name in declared.items():\n            assert artifact.endswith(\".json\"), (name, artifact)\n            assert schema_name in SHIPPED_SCHEMAS, (name, schema_name)\n        json_outputs = [o for o in stages[name].get(\"outputs\", []) if o.endswith(\".json\")]\n        assert set(json_outputs) <= set(declared), name\n\n\ndef test_both_changed_files_records_share_one_schema_definition(harness_root):\n    stages = _workflow(harness_root)\n    implementer = stages[\"implementer\"][\"schemas\"][\"changed-files.json\"]\n    tester = stages[\"tester\"][\"schemas\"][\"tester-changed-files.json\"]\n    assert implementer == tester == \"changed-files\"\n\n\ndef test_verifier_declares_its_conditional_artifact(harness_root):\n    verifier = _workflow(harness_root)[\"verifier\"]\n    assert verifier[\"schemas\"][\"verification-result.json\"] == \"verification-result\"\n    assert verifier[\"schemas\"][\"retry-guidance.json\"] == \"retry-guidance\"\n    # The conditional artifact is declared for validation but never required.\n    assert \"retry-guidance.json\" not in verifier[\"outputs\"]\n\n\ndef test_declared_schema_names_all_resolve_to_shipped_files(harness_root):\n    for stage in _workflow(harness_root).values():\n        for schema_name in stage.get(\"schemas\", {}).values():\n            path = harness_root / \"schemas\" / f\"{schema_name}.schema.json\"\n            assert path.is_file(), schema_name\n            assert json.loads(path.read_text())[\"title\"] == schema_name\n\n\ndef test_the_validation_step_hard_codes_no_artifact_or_schema_name():\n    \"\"\"The mapping lives in the workflow, so the coordinator names nothing.\"\"\"\n    source = inspect.getsource(story_coordinator._schema_violation)\n    # Prose is free to name examples; only executable lines are constrained.\n    lines, in_docstring = [], False\n    for line in source.splitlines():\n        if line.lstrip().startswith('\"\"\"'):\n            in_docstring = not in_docstring\n            continue\n        if not in_docstring and not line.lstrip().startswith(\"#\"):\n            lines.append(line)\n    body = \"\\n\".join(lines)\n    assert 'stage.get(\"schemas\"' in body    # the stripping left the real code\n    assert \".json\" not in body\n    for schema_name in SHIPPED_SCHEMAS:\n        assert schema_name not in body\n\n\n# --------------------------------------------------------------------------\n# The shipped schemas\n# --------------------------------------------------------------------------\n\n\ndef test_schemas_directory_holds_exactly_the_named_schemas(harness_root):\n    present = {p.name for p in (harness_root / \"schemas\").iterdir()}\n    assert present == {f\"{name}.schema.json\" for name in SHIPPED_SCHEMAS}\n\n\ndef test_every_required_field_is_also_a_declared_property(harness_root):\n    \"\"\"A required name absent from properties would be an unenforceable typo.\"\"\"\n\n    def check(schema: dict, where: str) -> None:\n        properties = schema.get(\"properties\", {})\n        for name in schema.get(\"required\", []):","numLines":130,"startLine":1,"totalLines":512}}}
