e here.\n+                clean_clone_artifact = stage.get(\"clean_clone\")\n+                if clean_clone_artifact:\n+                    clean = _clean_clone_check(\n+                        run_dir, target_root, config, clean_clone_artifact\n+                    )\n+                    if clean.exit_code == 0:\n+                        _clean_clone_passed(\n+                            run_dir, stage, clean_clone_artifact, elapsed()\n+                        )\n+                    elif state.retry_count < rules[\"max_retries\"]:\n+                        # The same retry path a failed verification takes:\n+                        # archive above the increment, so state.retry_count + 1\n+                        # still names the attempt that just ended.\n+                        archive_attempt(\n+                            run_dir, archivable_artifacts(stages), state.retry_count + 1\n+                        )\n+                        state.retry_count += 1\n+                        save_state(run_dir, state)\n+                        _clean_clone_failed(\n+                            run_dir, state, rules, stage, clean_clone_artifact, elapsed()\n+                        )\n+                        index = stage_names.index(stage[\"on_failure\"][\"retry_stage\"])\n+                        continue\n+                    else:\n+                        return _escalate(\n+                            run_dir,\n+                            state,\n+                            _clean_clone_escalation_reason(clean),\n+                            duration_seconds=elapsed(),\n+                            retry_decision=\"escalate\",\n+                            retry_reason=f\"the retry ceiling of {rules['max_retries']} was reached\",\n+                        )\n             elif verdict.get(\"retry_recommended\") and state.retry_count < rules[\"max_retries\"]:\n                 # Archive before the retry begins, while the root artifacts\n                 # still describe the attempt that just failed. The attempt\ndiff --git a/prompts/implementer.md b/prompts/implementer.md\nindex 244c879..45321c6 100644\n--- a/prompts/implementer.md\n+++ b/prompts/implementer.md\n@@ -77,5 +77,10 @@ Most recent verifier finding:\n Retry guidance:\n {{retry_guidance}}\n \n+Clean-clone suite result (the suite run in a fresh clone with the story\n+committed into it; a non-zero exit_code here is why this retry exists, even\n+though the verifier passed):\n+{{clean_clone_result}}\n+\n Retry state:\n {{retry_state}}\ndiff --git a/schemas/execution-history.schema.json b/schemas/execution-history.schema.json\nindex 890e35c..72fd20c 100644\n--- a/schemas/execution-history.schema.json\n+++ b/schemas/execution-history.schema.json\n@@ -27,6 +27,8 @@\n           \"stage-exception-applied\",\n           \"verification-passed\",\n           \"verification-failed\",\n+          \"clean-clone-passed\",\n+          \"clean-clone-failed\",\n           \"escalated\",\n           \"story-completed\",\n           \"note\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
