{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RboiTGAzoatAnm7CcEKgvT","type":"tool_result","content":"1\t\"\"\"Assemble stage context and inject it into prompt templates.\n2\t\n3\tThe coordinator selects what each stage sees and delivers it by\n4\tinjection: artifact content is substituted into {{placeholder}} fields in\n5\ta fixed template. Optional placeholders with nothing to inject render as\n6\tNone so the prompt stays coherent. Source code is never injected; agents\n7\tread it by reference because the coordinator cannot enumerate it in\n8\tadvance.\n9\t\"\"\"\n10\tfrom __future__ import annotations\n11\t\n12\timport json\n13\timport re\n14\tfrom pathlib import Path\n15\t\n16\tPLACEHOLDER = re.compile(r\"\\{\\{([a-z_]+)\\}\\}\")\n17\t\n18\t\n19\tdef render(template: str, context: dict[str, str | None]) -> str:\n20\t    def substitute(match: re.Match[str]) -> str:\n21\t        value = context.get(match.group(1))\n22\t        return value if value else \"None\"\n23\t\n24\t    return PLACEHOLDER.sub(substitute, template)\n25\t\n26\t\n27\tdef load_template(harness_root: Path, prompt_file: str) -> str:\n28\t    return (harness_root / \"prompts\" / prompt_file).read_text(encoding=\"utf-8\")\n29\t\n30\t\n31\tdef schema_context(harness_root: Path) -> dict[str, str]:\n32\t    \"\"\"Map every artifact schema to its injectable placeholder name.\n33\t\n34\t    Artifact schemas are injected rather than restated inline in prompts, so\n35\t    the definition an agent is asked to satisfy is the same file the\n36\t    coordinator enforces. schemas/verification-result.schema.json becomes\n37\t    {{verification_result_schema}}. A new schema file becomes an injectable\n38\t    placeholder with no code change.\n39\t\n40\t    This is the one place the glob lives: build_context calls it for workflow\n41\t    stages, and l5-plan calls it for the planner template, which no\n42\t    coordinator renders.\n43\t    \"\"\"\n44\t    context: dict[str, str] = {}\n45\t    for schema_path in sorted((harness_root / \"schemas\").glob(\"*.schema.json\")):\n46\t        stem = schema_path.name[: -len(\".schema.json\")]\n47\t        context[stem.replace(\"-\", \"_\") + \"_schema\"] = schema_path.read_text(\n48\t            encoding=\"utf-8\"\n49\t        )\n50\t    return context\n51\t\n52\t\n53\tdef workflow_context(workflow: dict, rules: dict) -> dict[str, str | None]:\n54\t    \"\"\"Map the workflow's stage facts to injectable placeholder names.\n55\t\n56\t    The stage list, each stage's may_not_create prefixes, and the rules'\n57\t    repository-wide blocked_paths are injected rather than restated in\n58\t    prose, so the facts a planner is told are the definitions the\n59\t    coordinator enforces. l5-plan calls this for the planner template,\n60\t    which no coordinator renders.\n61\t    \"\"\"\n62\t    stages = workflow[\"stages\"]\n63\t    restrictions = [\n64\t        f\"{stage['name']} may not create files under {prefix}\"\n65\t        for stage in stages\n66\t        for prefix in stage.get(\"may_not_create\", [])\n67\t    ]\n68\t    return {\n69\t        \"workflow_stages\": _dashed_lines([stage[\"name\"] for stage in stages]),\n70\t        \"stage_create_restrictions\": _dashed_lines(restrictions),\n71\t        \"blocked_paths\": _dashed_lines(rules.get(\"blocked_paths\")),\n72\t    }\n73\t\n74\t\n75\tdef _read(path: Path) -> str | None:\n76\t    return path.read_text(encoding=\"utf-8\") if path.is_file() else None\n77\t\n78\t\n79\tdef _read_files(root: Path, paths: list[str]) -> str | None:\n80\t    sections = []\n81\t    for rel in paths:\n82\t        text = _read(root / rel)\n83\t        if text:\n84\t            sections.append(f\"--- {rel} ---\\n{text}\")\n85\t    return \"\\n\".join(sections) if sections else None\n86\t\n87\t\n88\tdef _dashed_lines(items: object) -> str | None:\n89\t    \"\"\"Render a parsed list of criteria as one dash-prefixed line each.\n90\t\n91\t    The list comes from the parse, so each item is already one whole\n92\t    criterion: no YAML indentation, no quoting, no hand-wrapping. An absent\n93\t    or empty list renders as None, the optional-placeholder convention.\n94\t    \"\"\"\n95\t    if not items:\n96\t        return None\n97\t    return \"\\n\".join(f\"- {item}\" for item in items)\n98\t\n99\t\n100\tdef _exception_lines(exceptions: object) -> str | None:\n101\t    \"\"\"Render the story's stage exceptions, one dash-prefixed line each.\n102\t\n103\t    The reason travels with the grant: a stage told a rule is lifted should\n104\t    also be told why, so it can tell whether its own work is the case the\n105\t    story had in mind. Absent or empty renders as None.\n106\t    \"\"\"\n107\t    if not exceptions:\n108\t        return None\n109\t    return \"\\n\".join(\n110\t        f\"- {item['stage']} may create {item['create']}: {item['reason']}\"\n111\t        for item in exceptions\n112\t    )\n113\t\n114\t\n115\tdef latest_verifier_finding(run_dir: Path) -> str | None:\n116\t    iterations = sorted((run_dir / \"verification\").glob(\"iteration-*.json\"))\n117\t    return _read(iterations[-1]) if iterations else None\n118\t\n119\t\n120\tdef build_context(\n121\t    *,\n122\t    story_text: str,\n123\t    story: dict,\n124\t    run_dir: Path,\n125\t    target_root: Path,\n126\t    harness_root: Path,\n127\t    config: dict,\n128\t    rules: dict,\n129\t    retry_count: int,\n130\t) -> dict[str, str | None]:\n131\t    standards_dir = target_root / config.get(\"standards_dir\", \".harness/standards\")\n132\t    standards = _read_files(\n133\t        standards_dir, sorted(p.name for p in standards_dir.glob(\"*.md\"))\n134\t    ) if standards_dir.is_dir() else None\n135\t    doc_paths = config.get(\"architecture_docs\", [])\n136\t\n137\t    retry_state = None\n138\t    if retry_count > 0:\n139\t        retry_state = json.dumps(\n140\t            {\"retry_iteration\": retry_count, \"max_retries\": rules[\"max_retries\"]},\n141\t            indent=2,\n142\t        )\n143\t\n144\t    # {{story}} stays the raw artifact, byte-identical to the file on disk, so\n145\t    # agents read the story as authored. Every *structural* value is taken from\n146\t    # the parse instead, so nothing reads the artifact a second way.\n147\t    context: dict[str, str | None] = {\n148\t        \"story\": story_text,\n149\t        \"acceptance_criteria\": _dashed_lines(story.get(\"acceptance_criteria\")),\n150\t        \"stage_exceptions\": _exception_lines(story.get(\"stage_exceptions\")),\n151\t        \"blocked_paths\": _dashed_lines(rules.get(\"blocked_paths\")),\n152\t        \"test_command\": config.get(\"test_command\"),\n153\t        \"repository_standards\": standards,\n154\t        \"architecture_docs\": _read_files(target_root, doc_paths),\n155\t        \"architecture_doc_paths\": \"\\n\".join(f\"- {p}\" for p in doc_paths) or None,\n156\t        \"run_dir\": str(run_dir),\n157\t        \"changed_files\": _read(run_dir / \"changed-files.json\"),\n158\t        \"tester_changed_files\": _read(run_dir / \"tester-changed-files.json\"),\n159\t        \"implementation_summary\": _read(run_dir / \"implementation-summary.md\"),\n160\t        \"test_results\": _read(run_dir / \"test-results.json\"),\n161\t        \"verification_result\": _read(run_dir / \"verification-result.json\"),\n162\t        \"latest_verifier_finding\": latest_verifier_finding(run_dir),\n163\t        \"retry_guidance\": _read(run_dir / \"retry-guidance.json\"),\n164\t        \"retry_state\": retry_state,\n165\t        \"testing_standards\": _read(standards_dir / \"testing.md\"),\n166\t    }\n167\t\n168\t    context.update(schema_context(harness_root))\n169\t\n170\t    # Two-pass render: resolve the shared harness-layer partial (including its\n171\t    # own {{blocked_paths}} placeholder) against the assembled context before\n172\t    # injecting it, because render() is single-pass and does not re-scan\n173\t    # substituted text. Absent partial leaves harness_layer unset -> None.\n174\t    harness_layer_path = harness_root / \"prompts\" / \"harness-layer.md\"\n175\t    if harness_layer_path.is_file():\n176\t        partial = load_template(harness_root, \"harness-layer.md\")\n177\t        context[\"harness_layer\"] = render(partial, context)\n178\t\n179\t    return context\n180\t"}]},"parent_tool_use_id":null,"session_id":"12dae280-dcd3-4d46-9098-a5267a2d04b4","uuid":"d1e62c8d-7845-48ed-a517-a3c1a4d25b96","timestamp":"2026-08-07T18:55:34.006Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jerodw/Work/AgenticProgramming/level-five/orchestration/context_assembler.py","content":"\"\"\"Assemble stage context and inject it into prompt templates.\n\nThe coordinator selects what each stage sees and delivers it by\ninjection: artifact content is substituted into {{placeholder}} fields in\na fixed template. Optional placeholders with nothing to inject render as\nNone so the prompt stays coherent. Source code is never injected; agents\nread it by reference because the coordinator cannot enumerate it in\nadvance.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport re\nfrom pathlib import Path\n\nPLACEHOLDER = re.compile(r\"\\{\\{([a-z_]+)\\}\\}\")\n\n\ndef render(template: str, context: dict[str, str | None]) -> str:\n    def substitute(match: re.Match[str]) -> str:\n        value = context.get(match.group(1))\n        return value if value else \"None\"\n\n    return PLACEHOLDER.sub(substitute, template)\n\n\ndef load_template(harness_root: Path, prompt_file: str) -> str:\n    return (harness_root / \"prompts\" / prompt_file).read_text(encoding=\"utf-8\")\n\n\ndef schema_context(harness_root: Path) -> dict[str, str]:\n    \"\"\"Map every artifact schema to its injectable placeholder name.\n\n    Artifact schemas are injected rather than restated inline in prompts, so\n    the definition an agent is asked to satisfy is the same file the\n    coordinator enforces. schemas/verification-result.schema.json becomes\n    {{verification_result_schema}}. A new schema file becomes an injectable\n    placeholder with no code change.\n\n    This is the one place the glob lives: build_context calls it for workflow\n    stages, and l5-plan calls it for the planner template, which no\n    coordinator renders.\n    \"\"\"\n    context: dict[str, str] = {}\n    for schema_path in sorted((harness_root / \"schemas\").glob(\"*.schema.json\")):\n        stem = schema_path.name[: -len(\".schema.json\")]\n        context[stem.replace(\"-\", \"_\") + \"_schema\"] = schema_path.read_text(\n            encoding=\"utf-8\"\n        )\n    return context\n\n\ndef workflow_context(workflow: dict, rules: dict) -> dict[str, str | None]:\n    \"\"\"Map the workflow's stage facts to injectable placeholder names.\n\n    The stage list, each stage's may_not_create prefixes, and the rules'\n    repository-wide blocked_paths are injected rather than restated in\n    prose, so the facts a planner is told are the definitions the\n    coordinator enforces. l5-plan calls this for the planner template,\n    which no coordinator renders.\n    \"\"\"\n    stages = workflow[\"stages\"]\n    restrictions = [\n        f\"{stage['name']} may not create files under {prefix}\"\n        for stage in stages\n        for prefix in stage.get(\"may_not_create\", [])\n    ]\n    return {\n        \"workflow_stages\": _dashed_lines([stage[\"name\"] for stage in stages]),\n        \"stage_create_restrictions\": _dashed_lines(restrictions),\n        \"blocked_paths\": _dashed_lines(rules.get(\"blocked_paths\")),\n    }\n\n\ndef _read(path: Path) -> str | None:\n    return path.read_text(encoding=\"utf-8\") if path.is_file() else None\n\n\ndef _read_files(root: Path, paths: list[str]) -> str | None:\n    sections = []\n    for rel in paths:\n        text = _read(root / rel)\n        if text:\n            sections.append(f\"--- {rel} ---\\n{text}\")\n    return \"\\n\".join(sections) if sections else None\n\n\ndef _dashed_lines(items: object) -> str | None:\n    \"\"\"Render a parsed list of criteria as one dash-prefixed line each.\n\n    The list comes from the parse, so each item is already one whole\n    criterion: no YAML indentation, no quoting, no hand-wrapping. An absent\n    or empty list renders as None, the optional-placeholder convention.\n    \"\"\"\n    if not items:\n        return None\n    return \"\\n\".join(f\"- {item}\" for item in items)\n\n\ndef _exception_lines(exceptions: object) -> str | None:\n    \"\"\"Render the story's stage exceptions, one dash-prefixed line each.\n\n    The reason travels with the grant: a stage told a rule is lifted should\n    also be told why, so it can tell whether its own work is the case the\n    story had in mind. Absent or empty renders as None.\n    \"\"\"\n    if not exceptions:\n        return None\n    return \"\\n\".join(\n        f\"- {item['stage']} may create {item['create']}: {item['reason']}\"\n        for item in exceptions\n    )\n\n\ndef latest_verifier_finding(run_dir: Path) -> str | None:\n    iterations = sorted((run_dir / \"verification\").glob(\"iteration-*.json\"))\n    return _read(iterations[-1]) if iterations else None\n\n\ndef build_context(\n    *,\n    story_text: str,\n    story: dict,\n    run_dir: Path,\n    target_root: Path,\n    harness_root: Path,\n    config: dict,\n    rules: dict,\n    retry_count: int,\n) -> dict[str, str | None]:\n    standards_dir = target_root / config.get(\"standards_dir\", \".harness/standards\")\n    standards = _read_files(\n        standards_dir, sorted(p.name for p in standards_dir.glob(\"*.md\"))\n    ) if standards_dir.is_dir() else None\n    doc_paths = config.get(\"architecture_docs\", [])\n\n    retry_state = None\n    if retry_count > 0:\n        retry_state = json.dumps(\n            {\"retry_iteration\": retry_count, \"max_retries\": rules[\"max_retries\"]},\n            indent=2,\n        )\n\n    # {{story}} stays the raw artifact, byte-identical to the file on disk, so\n    # agents read the story as authored. Every *structural* value is taken from\n    # the parse instead, so nothing reads the artifact a second way.\n    context: dict[str, str | None] = {\n        \"story\": story_text,\n        \"acceptance_criteria\": _dashed_lines(story.get(\"acceptance_criteria\")),\n        \"stage_exceptions\": _exception_lines(story.get(\"stage_exceptions\")),\n        \"blocked_paths\": _dashed_lines(rules.get(\"blocked_paths\")),\n        \"test_command\": config.get(\"test_command\"),\n        \"repository_standards\": standards,\n        \"architecture_docs\": _read_files(target_root, doc_paths),\n        \"architecture_doc_paths\": \"\\n\".join(f\"- {p}\" for p in doc_paths) or None,\n        \"run_dir\": str(run_dir),\n        \"changed_files\": _read(run_dir / \"changed-files.json\"),\n        \"tester_changed_files\": _read(run_dir / \"tester-changed-files.json\"),\n        \"implementation_summary\": _read(run_dir / \"implementation-summary.md\"),\n        \"test_results\": _read(run_dir / \"test-results.json\"),\n        \"verification_result\": _read(run_dir / \"verification-result.json\"),\n        \"latest_verifier_finding\": latest_verifier_finding(run_dir),\n        \"retry_guidance\": _read(run_dir / \"retry-guidance.json\"),\n        \"retry_state\": retry_state,\n        \"testing_standards\": _read(standards_dir / \"testing.md\"),\n    }\n\n    context.update(schema_context(harness_root))\n\n    # Two-pass render: resolve the shared harness-layer partial (including its\n    # own {{blocked_paths}} placeholder) against the assembled context before\n    # injecting it, because render() is single-pass and does not re-scan\n    # substituted text. Absent partial leaves harness_layer unset -> None.\n    harness_layer_path = harness_root / \"prompts\" / \"harness-layer.md\"\n    if harness_layer_path.is_file():\n        partial = load_template(harness_root, \"harness-layer.md\")\n        context[\"harness_layer\"] = render(partial, context)\n\n    return context\n","numLines":180,"startLine":1,"totalLines":180}}}
