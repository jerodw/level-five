{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0185ERj5kccuCyBZNkxKXkhb","type":"tool_result","content":"The file /Users/jerodw/Work/AgenticProgramming/level-five/tests/test_story_014_validation.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"9772d13d-b2d6-4982-8059-5e244b5d1415","uuid":"1014a267-6ca9-4630-84da-7788c49c0cc1","timestamp":"2026-08-07T19:12:59.754Z","tool_use_result":{"filePath":"/Users/jerodw/Work/AgenticProgramming/level-five/tests/test_story_014_validation.py","oldString":"def test_a_ceiling_of_zero_escalates_with_no_retry_and_no_archive(\n    buggy_target, no_retry_harness_root,\n):\n    runner = Runner(buggy_target, [PASS])\n    code = story_coordinator.run_story(\n        \"story-001\", no_retry_harness_root, buggy_target, runner)","newString":"def test_a_ceiling_of_zero_escalates_with_no_retry_and_no_archive(\n    buggy_target, no_retry_harness_root,\n):\n    point_at(buggy_target, \"clean-clone-probe-workflow\")\n    runner = Runner(buggy_target, [PASS])\n    code = story_coordinator.run_story(\n        \"story-001\", no_retry_harness_root, buggy_target, runner)","originalFile":"\"\"\"story-014: the suite is run once more in a clean clone before the story ships.\n\nThe working tree is the one environment where the story's own commit does not\nexist yet, and it was the only environment the suite ever ran in: `_complete`\ncreates the committed state after the documenter and after every check that\ncould object to it. These tests drive the coordinator over a fixture that\nreproduces exactly that gap - a check resolving its baseline as\n`git show HEAD:...`, which is the pre-story revision only while the story is\nuncommitted, and which therefore passes in the working tree and fails once the\nstory is HEAD.\n\nThe fixture is deterministic and invokes no model: the \"suite\" is a shell\nscript in the target repository, and the target's configured test_command\nnames it. Nothing here asserts on pytest.\n\"\"\"\nimport json\nimport re\nimport shutil\nimport subprocess\nfrom pathlib import Path\n\nimport pytest\n\nimport context_assembler\nimport schema_validator\nimport story_coordinator\nfrom agent_runner import AgentResult\n\nREPO_ROOT = Path(story_coordinator.__file__).resolve().parents[1]\nCOORDINATOR_SOURCE = Path(story_coordinator.__file__).read_text(encoding=\"utf-8\")\nWORKFLOW = json.loads(\n    (REPO_ROOT / \"workflows\" / \"story-workflow.json\").read_text(encoding=\"utf-8\"))\n\nLINE = re.compile(r\"^\\[\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\] (.*)$\")\n\nPASS = {\"status\": \"passed\", \"blocking_issues\": [], \"unverified\": [],\n        \"retry_recommended\": False}\nFAIL = {\"status\": \"failed\",\n        \"blocking_issues\": [{\"severity\": \"high\", \"issue\": \"sample behavior missing\",\n                             \"location\": \"src/app.py\",\n                             \"required_behavior\": \"sample behavior exists\"}],\n        \"unverified\": [], \"retry_recommended\": True}\n\n\n# --------------------------------------------------------------------------\n# The fixture: a target repository whose suite is a script, in two versions\n# --------------------------------------------------------------------------\n\n# story-011's defect, reduced to its mechanism. The baseline is resolved as\n# HEAD, which names the pre-story revision only while the story is\n# uncommitted. In the working tree the two differ and the check passes; once\n# the story is committed HEAD *is* the story and the check fails.\nHEAD_BASELINE_CHECK = \"\"\"\\\nif git show HEAD:src/app.py | diff -q - src/app.py > /dev/null 2>&1; then\n    echo \"FAILED test_the_story_changed_app: src/app.py matches its HEAD baseline\"\n    exit 1\nfi\necho \"1 passed\"\n\"\"\"\n\n# The same check with the baseline bounded at a revision the story's own\n# commit cannot become: the root commit. True in both environments.\nROOT_BASELINE_CHECK = \"\"\"\\\nbase=$(git rev-list --max-parents=0 HEAD)\nif git show $base:src/app.py | diff -q - src/app.py > /dev/null 2>&1; then\n    echo \"FAILED test_the_story_changed_app: src/app.py matches its baseline\"\n    exit 1\nfi\necho \"1 passed\"\n\"\"\"\n\nGITIGNORE = \".venv/\\n.harness/runs/\\n.harness/logs/\\nsecret.txt\\n\"\n\n\ndef git(target_root: Path, *args: str) -> str:\n    return subprocess.run(\n        [\"git\", *args], cwd=str(target_root), capture_output=True, text=True,\n        check=True,\n    ).stdout\n\n\ndef scripted_target(target_root: Path, check: str,\n                    command: str = \"sh check.sh\") -> Path:\n    \"\"\"Point the fixture target's test_command at a shell script it carries.\n\n    The script is committed, so it reaches the clone as history rather than as\n    a working-tree edit, and the .gitignore is the one the clone-contents\n    assertions read.\n    \"\"\"\n    (target_root / \"check.sh\").write_text(check, encoding=\"utf-8\")\n    (target_root / \".gitignore\").write_text(GITIGNORE, encoding=\"utf-8\")\n    config = target_root / \".harness\" / \"config.yaml\"\n    config.write_text(\n        config.read_text(encoding=\"utf-8\").replace(\n            \"test_command: echo tests-ok\", f\"test_command: {command}\"),\n        encoding=\"utf-8\",\n    )\n    git(target_root, \"add\", \"-A\")\n    git(target_root, \"commit\", \"-q\", \"-m\", \"carry the suite as a script\")\n    return target_root\n\n\nclass Runner:\n    \"\"\"A fake agent runner that edits the target the way an implementer would.\n\n    The implementer's edit to src/app.py is what the fixture's check looks at,\n    so the working tree really does carry an uncommitted story, and the clone\n    really does have something to commit.\n    \"\"\"\n\n    def __init__(self, target_root: Path, verdicts, story_id: str = \"story-001\"):\n        self.target_root = target_root\n        self.run_dir = target_root / \".harness\" / \"runs\" / story_id\n        self.verdicts = list(verdicts)\n        self.attempt = 0\n        self.calls: list[str] = []\n\n    def _verdict(self) -> dict:\n        # A list shorter than the run needs repeats its last entry, so a run\n        # that retries on the clean-clone check keeps passing verification.\n        return self.verdicts.pop(0) if len(self.verdicts) > 1 else self.verdicts[0]\n\n    def __call__(self, prompt, *, stage, cwd, log_path, permission_mode, model,\n                 allowed_tools=None):\n        self.calls.append(stage)\n        if stage == \"implementer\":\n            self.attempt += 1\n            (self.target_root / \"src\" / \"app.py\").write_text(\n                f\"print('hello')\\nprint('attempt {self.attempt}')\\n\", encoding=\"utf-8\")\n            (self.target_root / \"notes.txt\").write_text(\n                \"an untracked file git does not ignore\\n\", encoding=\"utf-8\")\n            (self.target_root / \"secret.txt\").write_text(\n                \"gitignored; must not reach the clone\\n\", encoding=\"utf-8\")\n            write_json(self.run_dir / \"changed-files.json\", {\n                \"modified\": [\"src/app.py\"], \"created\": [\"notes.txt\"], \"deleted\": [],\n            })\n            (self.run_dir / \"implementation-summary.md\").write_text(\n                f\"Implemented on attempt {self.attempt}.\\n\", encoding=\"utf-8\")\n        elif stage == \"tester\":\n            write_json(self.run_dir / \"test-results.json\", {\n                \"status\": \"passed\", \"tests_written\": 1, \"tests_run\": 1,\n                \"tests_passed\": 1, \"tests_failed\": 0, \"failures\": [],\n            })\n            write_json(self.run_dir / \"tester-changed-files.json\", {\n                \"modified\": [], \"created\": [\"tests/test_app.py\"], \"deleted\": [],\n            })\n        elif stage == \"verifier\":\n            verdict = self._verdict()\n            write_json(self.run_dir / \"verification-result.json\", verdict)\n            if verdict[\"status\"] == \"failed\":\n                write_json(self.run_dir / \"retry-guidance.json\", {\n                    \"current_focus\": [\"fix the sample behavior\"],\n                    \"preserve_behavior\": [\"existing behavior\"],\n                    \"retry_scope\": [\"src/app.py\"],\n                })\n        elif stage == \"documenter\":\n            (self.run_dir / \"documentation-report.md\").write_text(\n                \"No changes needed.\\n\", encoding=\"utf-8\")\n        return AgentResult(ok=True, result_text=f\"{stage} done\")\n\n\ndef write_json(path: Path, payload) -> None:\n    path.write_text(json.dumps(payload, indent=2) + \"\\n\", encoding=\"utf-8\")\n\n\ndef run_dir_of(target_root: Path, story_id: str = \"story-001\") -> Path:\n    return target_root / \".harness\" / \"runs\" / story_id\n\n\ndef read_state(run_dir: Path) -> dict:\n    return json.loads((run_dir / \"state.json\").read_text(encoding=\"utf-8\"))\n\n\ndef read_record(run_dir: Path, name: str = \"clean-clone-result.json\") -> dict:\n    return json.loads((run_dir / name).read_text(encoding=\"utf-8\"))\n\n\ndef messages(run_dir: Path) -> list[str]:\n    prose = []\n    for line in (run_dir / \"events.log\").read_text(encoding=\"utf-8\").splitlines():\n        match = LINE.match(line)\n        assert match is not None, f\"line does not match the frozen format: {line!r}\"\n        prose.append(match.group(1))\n    return prose\n\n\ndef history_of(run_dir: Path) -> list[dict]:\n    return json.loads(\n        (run_dir / \"execution-history.json\").read_text(encoding=\"utf-8\"))\n\n\n@pytest.fixture\ndef buggy_target(target_root):\n    return scripted_target(target_root, HEAD_BASELINE_CHECK)\n\n\n@pytest.fixture\ndef sound_target(target_root):\n    return scripted_target(target_root, ROOT_BASELINE_CHECK)\n\n\n# --------------------------------------------------------------------------\n# The gap this story closes, reproduced\n# --------------------------------------------------------------------------\n\n\n@pytest.fixture\ndef caught_run(buggy_target, harness_root):\n    runner = Runner(buggy_target, [PASS])\n    code = story_coordinator.run_story(\n        \"story-001\", harness_root, buggy_target, runner)\n    return runner, run_dir_of(buggy_target), code\n\n\ndef test_a_suite_green_uncommitted_and_red_committed_never_reaches_the_documenter(\n    caught_run,\n):\n    \"\"\"The whole point: the verifier passed, the working-tree suite passed,\n    and the story still does not ship.\"\"\"\n    runner, run_dir, code = caught_run\n    assert \"documenter\" not in runner.calls\n    assert not (run_dir / \"documentation-report.md\").exists()\n    assert code == 2\n    assert read_state(run_dir)[\"status\"] == \"escalated\"\n\n\ndef test_the_working_tree_suite_the_check_disagrees_with_really_did_pass(\n    buggy_target,\n):\n    \"\"\"Guards the fixture: the failure is the environment, not a broken check.\n\n    Run uncommitted the fixture's suite exits zero; the same script exits\n    non-zero in the clone. If this ever stopped holding, the run above would\n    be catching an ordinary red suite and proving nothing.\n    \"\"\"\n    (buggy_target / \"src\" / \"app.py\").write_text(\n        \"print('hello')\\nprint('the story')\\n\", encoding=\"utf-8\")\n    result = subprocess.run(\n        \"sh check.sh\", shell=True, cwd=str(buggy_target),\n        capture_output=True, text=True)\n    assert result.returncode == 0, result.stdout + result.stderr\n\n\ndef test_the_same_fixture_with_its_baseline_corrected_advances(sound_target,\n                                                               harness_root):\n    \"\"\"The check distinguishes the two environments rather than failing\n    everything: the corrected baseline is green in both, and the run finishes.\"\"\"\n    runner = Runner(sound_target, [PASS])\n    code = story_coordinator.run_story(\n        \"story-001\", harness_root, sound_target, runner)\n    run_dir = run_dir_of(sound_target)\n\n    assert code == 0\n    assert runner.calls == [\"implementer\", \"tester\", \"verifier\", \"documenter\"]\n    assert read_state(run_dir)[\"status\"] == \"completed\"\n    assert read_record(run_dir)[\"exit_code\"] == 0\n\n\n# --------------------------------------------------------------------------\n# The record the check leaves behind\n# --------------------------------------------------------------------------\n\n\n@pytest.fixture\ndef green_run(sound_target, harness_root):\n    runner = Runner(sound_target, [PASS])\n    code = story_coordinator.run_story(\n        \"story-001\", harness_root, sound_target, runner)\n    assert code == 0\n    return runner, run_dir_of(sound_target)\n\n\ndef test_the_record_says_the_check_ran_rather_than_leaving_it_inferred(green_run):\n    _, run_dir = green_run\n    record = read_record(run_dir)\n    assert record[\"ran\"] is True\n    assert record[\"exit_code\"] == 0\n    assert record[\"command\"] == \"sh check.sh\"\n    assert record[\"clone_path\"]\n\n\ndef test_the_record_is_written_after_a_failing_run_too(caught_run):\n    _, run_dir, _ = caught_run\n    record = read_record(run_dir)\n    assert record[\"ran\"] is True\n    assert record[\"exit_code\"] != 0\n    assert \"FAILED test_the_story_changed_app\" in record[\"output_tail\"]\n\n\n@pytest.mark.parametrize(\"fixture\", [\"green_run\", \"caught_run\"])\ndef test_the_record_validates_against_its_schema(fixture, request):\n    run_dir = request.getfixturevalue(fixture)[1]\n    schema = schema_validator.load_schema(\"clean-clone-result\")\n    assert schema_validator.validate(read_record(run_dir), schema) == []\n\n\ndef test_the_schema_stays_inside_the_keyword_subset_the_validator_supports():\n    schema = schema_validator.load_schema(\"clean-clone-result\")\n    assert schema_validator.unsupported_keywords(schema) == []\n    assert schema_validator.validate({}, schema) != []\n\n\ndef test_the_schema_expresses_optional_fields_by_absence_not_by_null():\n    schema = schema_validator.load_schema(\"clean-clone-result\")\n    for name, subschema in schema[\"properties\"].items():\n        assert subschema[\"type\"] != \"null\", name\n        assert isinstance(subschema[\"type\"], str), name\n\n\ndef test_the_new_schema_is_in_both_inventory_assertions():\n    \"\"\"Both inventories are exact set equality, so a shipped schema missing\n    from either fails there; this asserts the file is shipped and named.\"\"\"\n    import test_schema_validator\n    import test_story_004_validation\n\n    assert \"clean-clone-result\" in test_schema_validator.SHIPPED\n    assert \"clean-clone-result\" in test_story_004_validation.SHIPPED_SCHEMAS\n    assert (REPO_ROOT / \"schemas\" / \"clean-clone-result.schema.json\").is_file()\n\n\n# --------------------------------------------------------------------------\n# A run that is genuinely green in both environments changes nothing else\n# --------------------------------------------------------------------------\n\n\ndef test_a_green_run_advances_with_retry_count_unchanged(green_run):\n    runner, run_dir = green_run\n    state = read_state(run_dir)\n    assert state[\"retry_count\"] == 0\n    assert state[\"verification_iterations\"] == 1\n    assert not (run_dir / \"attempts\").exists()\n    assert (run_dir / \"documentation-report.md\").is_file()\n\n\ndef test_a_green_run_alters_no_event_other_than_the_clean_clone_one(green_run):\n    _, run_dir = green_run\n    assert messages(run_dir) == [\n        \"workflow started for story-001\",\n        \"implementer stage started\",\n        \"implementer stage completed\",\n        \"tester stage started\",\n        \"tester stage completed\",\n        \"verifier stage started\",\n        \"verification passed\",\n        \"clean-clone suite passed with the story committed\",\n        \"documenter stage started\",\n        \"documenter stage completed\",\n        \"story completed on branch story/story-001\",\n    ]\n\n\ndef test_the_check_runs_after_the_verifier_and_before_the_documenter(green_run):\n    _, run_dir = green_run\n    order = messages(run_dir)\n    assert order.index(\"verification passed\") < order.index(\n        \"clean-clone suite passed with the story committed\")\n    assert order.index(\"clean-clone suite passed with the story committed\") < \\\n        order.index(\"documenter stage started\")\n\n\n# --------------------------------------------------------------------------\n# Routing on a clean-clone failure\n# --------------------------------------------------------------------------\n\n\ndef test_a_failure_reroutes_to_the_stage_the_verifier_declares(caught_run):\n    runner, run_dir, _ = caught_run\n    retry_stage = next(\n        s for s in WORKFLOW[\"stages\"] if s[\"name\"] == \"verifier\"\n    )[\"on_failure\"][\"retry_stage\"]\n    assert retry_stage == \"implementer\"\n    assert runner.calls == [\n        \"implementer\", \"tester\", \"verifier\",\n        \"implementer\", \"tester\", \"verifier\",\n        \"implementer\", \"tester\", \"verifier\",\n    ]\n\n\ndef test_each_failure_increments_retry_count_exactly_once(caught_run):\n    _, run_dir, _ = caught_run\n    assert read_state(run_dir)[\"retry_count\"] == 2\n    reroutes = [m for m in messages(run_dir) if m.startswith(\"clean-clone suite failed\")]\n    assert reroutes == [\n        \"clean-clone suite failed; retry 1 of 2 rerouted to implementer\",\n        \"clean-clone suite failed; retry 2 of 2 rerouted to implementer\",\n    ]\n\n\ndef test_the_superseded_attempts_are_archived_under_the_prompts_own_numbers(\n    caught_run,\n):\n    _, run_dir, _ = caught_run\n    attempts = run_dir / \"attempts\"\n    assert sorted(p.name for p in attempts.iterdir()) == [\"attempt-1\", \"attempt-2\"]\n    for number in (1, 2):\n        assert (run_dir / f\"prompt-implementer-attempt-{number}.md\").is_file()\n        assert (attempts / f\"attempt-{number}\" / \"implementation-summary.md\"\n                ).read_text() == f\"Implemented on attempt {number}.\\n\"\n    # The third, escalating attempt stays at the root where the escalation's\n    # reader expects it.\n    assert not (attempts / \"attempt-3\").exists()\n\n\ndef test_the_ceiling_escalates_naming_the_check_and_what_failed(caught_run):\n    _, run_dir, code = caught_run\n    assert code == 2\n    reason = [m for m in messages(run_dir) if m.startswith(\"escalated:\")]\n    assert len(reason) == 1\n    assert \"clean-clone\" in reason[0]\n    summary = (run_dir / \"escalation-summary.md\").read_text(encoding=\"utf-8\")\n    assert \"clean-clone\" in summary\n    assert \"test_the_story_changed_app\" in summary\n\n\ndef test_the_ceiling_escalates_rather_than_looping(caught_run):\n    runner, run_dir, _ = caught_run\n    assert runner.calls.count(\"verifier\") == 3\n    assert read_state(run_dir)[\"status\"] == \"escalated\"\n\n\ndef test_a_ceiling_of_zero_escalates_with_no_retry_and_no_archive(\n    buggy_target, no_retry_harness_root,\n):\n    runner = Runner(buggy_target, [PASS])\n    code = story_coordinator.run_story(\n        \"story-001\", no_retry_harness_root, buggy_target, runner)\n    run_dir = run_dir_of(buggy_target)\n\n    assert code == 2\n    assert runner.calls == [\"implementer\", \"tester\", \"verifier\"]\n    assert read_state(run_dir)[\"retry_count\"] == 0\n    assert not (run_dir / \"attempts\").exists()\n\n\ndef test_the_coordinator_writes_no_retry_guidance_for_a_clean_clone_retry(\n    caught_run,\n):\n    \"\"\"That artifact is the verifier's. The verifier passed here, so nothing\n    wrote one - deterministic code must not fabricate an agent's judgement.\"\"\"\n    _, run_dir, _ = caught_run\n    assert not (run_dir / \"retry-guidance.json\").exists()\n    assert \"retry-guidance\" not in COORDINATOR_SOURCE\n\n\ndef test_the_retried_implementer_receives_the_evidence_in_its_prompt(caught_run):\n    _, run_dir, _ = caught_run\n    first = (run_dir / \"prompt-implementer-attempt-1.md\").read_text(encoding=\"utf-8\")\n    second = (run_dir / \"prompt-implementer-attempt-2.md\").read_text(encoding=\"utf-8\")\n    assert \"test_the_story_changed_app\" not in first\n    assert \"test_the_story_changed_app\" in second\n    assert \"{{clean_clone_result}}\" not in second\n\n\ndef test_the_placeholder_is_declared_and_assembled():\n    template = (REPO_ROOT / \"prompts\" / \"implementer.md\").read_text(encoding=\"utf-8\")\n    assert \"{{clean_clone_result}}\" in template\n    assembler = Path(context_assembler.__file__).read_text(encoding=\"utf-8\")\n    assert \"clean_clone_result\" in assembler\n    assert \"clean-clone-result.json\" in assembler\n\n\ndef test_the_context_value_is_none_when_the_artifact_is_absent(\n    sound_target, harness_root,\n):\n    run_dir = run_dir_of(sound_target)\n    run_dir.mkdir(parents=True, exist_ok=True)\n    context = context_assembler.build_context(\n        story_text=\"\",\n        story={},\n        run_dir=run_dir,\n        target_root=sound_target,\n        harness_root=harness_root,\n        config={},\n        rules={},\n        retry_count=0,\n    )\n    assert context[\"clean_clone_result\"] is None\n\n\n# --------------------------------------------------------------------------\n# The paths this story did not touch\n# --------------------------------------------------------------------------\n\n\ndef test_the_verification_failed_retry_path_is_unchanged(sound_target,\n                                                         harness_root):\n    \"\"\"A failing verdict still archives, increments, and reroutes exactly as\n    it did, and the clean-clone check does not run on the failing iteration.\"\"\"\n    runner = Runner(sound_target, [FAIL, PASS])\n    code = story_coordinator.run_story(\n        \"story-001\", harness_root, sound_target, runner)\n    run_dir = run_dir_of(sound_target)\n\n    assert code == 0\n    assert read_state(run_dir)[\"retry_count\"] == 1\n    assert messages(run_dir) == [\n        \"workflow started for story-001\",\n        \"implementer stage started\",\n        \"implementer stage completed\",\n        \"tester stage started\",\n        \"tester stage completed\",\n        \"verifier stage started\",\n        \"verification failed; retry 1 of 2 rerouted to implementer\",\n        \"implementer stage started\",\n        \"implementer stage completed\",\n        \"tester stage started\",\n        \"tester stage completed\",\n        \"verifier stage started\",\n        \"verification passed\",\n        \"clean-clone suite passed with the story committed\",\n        \"documenter stage started\",\n        \"documenter stage completed\",\n        \"story completed on branch story/story-001\",\n    ]\n\n\ndef test_a_verifier_that_recommends_no_retry_still_escalates_unchanged(\n    sound_target, harness_root,\n):\n    runner = Runner(sound_target, [{**FAIL, \"retry_recommended\": False}])\n    code = story_coordinator.run_story(\n        \"story-001\", harness_root, sound_target, runner)\n    run_dir = run_dir_of(sound_target)\n\n    assert code == 2\n    assert not (run_dir / \"clean-clone-result.json\").exists()\n    assert messages(run_dir)[-1] == (\n        \"escalated: verification failed and the verifier did not recommend a retry\")\n\n\ndef test_no_new_state_field_and_no_new_retry_axis(green_run):\n    _, run_dir = green_run\n    assert set(read_state(run_dir)) == {\n        \"story_id\", \"branch\", \"current_stage\", \"status\", \"retry_count\",\n        \"verification_iterations\",\n    }\n\n\n# --------------------------------------------------------------------------\n# How the clone is built\n# --------------------------------------------------------------------------\n\n\n@pytest.fixture\ndef dirty_target(sound_target):\n    \"\"\"The fixture target with an uncommitted story in its working tree.\"\"\"\n    (sound_target / \"src\" / \"app.py\").write_text(\n        \"print('hello')\\nprint('the story')\\n\", encoding=\"utf-8\")\n    (sound_target / \"notes.txt\").write_text(\"untracked, not ignored\\n\",\n                                            encoding=\"utf-8\")\n    (sound_target / \"secret.txt\").write_text(\"gitignored\\n\", encoding=\"utf-8\")\n    (sound_target / \".venv\" / \"bin\").mkdir(parents=True)\n    (sound_target / \".venv\" / \"bin\" / \"python\").write_text(\"#!/bin/sh\\n\",\n                                                           encoding=\"utf-8\")\n    return sound_target\n\n\n@pytest.fixture\ndef direct_clone(dirty_target, tmp_path):\n    \"\"\"run_clean_clone against a scratch directory this test owns.\n\n    The coordinator removes its own scratch directory the moment the suite\n    returns, so the only way to look inside the clone is to drive the run\n    directly with a scratch path the caller keeps.\n    \"\"\"\n    scratch = tmp_path / \"scratch\"\n    scratch.mkdir()\n    result = story_coordinator.run_clean_clone(dirty_target, \"sh check.sh\", scratch)\n    return result, Path(result.clone_path)\n\n\ndef test_the_clone_has_the_story_as_a_commit_not_as_pending_edits(direct_clone):\n    _, clone = direct_clone\n    assert (clone / \"src\" / \"app.py\").read_text() == (\n        \"print('hello')\\nprint('the story')\\n\")\n    assert git(clone, \"status\", \"--porcelain\").strip() == \"\"\n    assert git(clone, \"show\", \"HEAD:src/app.py\") == (\n        \"print('hello')\\nprint('the story')\\n\")\n    # The story sits on top of the original history rather than replacing it.\n    assert len(git(clone, \"log\", \"--format=%H\").split()) >= 2\n\n\ndef test_the_clone_carries_untracked_files_git_does_not_ignore(direct_clone):\n    _, clone = direct_clone\n    assert (clone / \"notes.txt\").read_text() == \"untracked, not ignored\\n\"\n    assert \"notes.txt\" in git(clone, \"ls-files\").split()\n\n\ndef test_gitignored_files_are_absent_from_the_clone(direct_clone):\n    \"\"\"The clone's contents are the set `_complete`'s `git add -A` would\n    commit, which is what makes the environment the one the story ships in.\"\"\"\n    _, clone = direct_clone\n    tracked = git(clone, \"ls-files\").split()\n    assert \"secret.txt\" not in tracked\n    assert not (clone / \"secret.txt\").exists()\n    assert not any(path.startswith(\".venv/\") for path in tracked)\n    assert not any(path.startswith(\".harness/runs/\") for path in tracked)\n\n\ndef test_the_clone_source_is_a_local_path_so_no_network_is_possible(direct_clone):\n    \"\"\"By construction rather than by observation: origin is the target\n    directory on this filesystem, so there is no host to reach.\"\"\"\n    _, clone = direct_clone\n    origin = git(clone, \"remote\", \"get-url\", \"origin\").strip()\n    assert Path(origin).is_dir()\n    assert \"://\" not in origin\n    assert Path(origin).resolve() == Path(clone).parent.parent.resolve() or \\\n        Path(origin).is_absolute()\n\n\ndef test_the_clone_is_built_outside_the_target_repository(direct_clone,\n                                                          dirty_target):\n    _, clone = direct_clone\n    assert dirty_target.resolve() not in clone.resolve().parents\n\n\ndef test_the_target_repository_is_not_mutated_by_the_check(dirty_target, tmp_path):\n    before_head = git(dirty_target, \"rev-parse\", \"HEAD\")\n    before_status = git(dirty_target, \"status\", \"--porcelain\")\n    before_branch = git(dirty_target, \"rev-parse\", \"--abbrev-ref\", \"HEAD\")\n    before_stash = git(dirty_target, \"stash\", \"list\")\n    before_branches = git(dirty_target, \"branch\", \"--format=%(refname)\")\n\n    scratch = tmp_path / \"scratch\"\n    scratch.mkdir()\n    story_coordinator.run_clean_clone(dirty_target, \"sh check.sh\", scratch)\n\n    assert git(dirty_target, \"rev-parse\", \"HEAD\") == before_head\n    assert git(dirty_target, \"status\", \"--porcelain\") == before_status\n    assert git(dirty_target, \"rev-parse\", \"--abbrev-ref\", \"HEAD\") == before_branch\n    assert git(dirty_target, \"stash\", \"list\") == before_stash\n    assert git(dirty_target, \"branch\", \"--format=%(refname)\") == before_branches\n\n\n@pytest.mark.parametrize(\"fixture\", [\"green_run\", \"caught_run\"])\ndef test_the_scratch_clone_is_removed_after_the_run(fixture, request):\n    \"\"\"Whatever the result: the record identifies the environment rather than\n    pointing at a surviving one.\"\"\"\n    run_dir = request.getfixturevalue(fixture)[1]\n    record = read_record(run_dir)\n    clone = Path(record[\"clone_path\"])\n    assert not clone.exists()\n    assert not clone.parent.exists()\n\n\ndef test_the_test_command_comes_from_the_target_config(target_root, harness_root):\n    \"\"\"No command string is written into orchestration code; changing the\n    config changes what the check runs.\"\"\"\n    scripted_target(target_root, ROOT_BASELINE_CHECK, command=\"sh other-check.sh\")\n    (target_root / \"other-check.sh\").write_text(\"echo elsewhere\\n\", encoding=\"utf-8\")\n\n    runner = Runner(target_root, [PASS])\n    assert story_coordinator.run_story(\n        \"story-001\", harness_root, target_root, runner) == 0\n    record = read_record(run_dir_of(target_root))\n    assert record[\"command\"] == \"sh other-check.sh\"\n    assert record[\"output_tail\"].strip() == \"elsewhere\"\n\n\ndef test_no_test_command_string_appears_in_orchestration_code():\n    for path in (REPO_ROOT / \"orchestration\").glob(\"*.py\"):\n        source = path.read_text(encoding=\"utf-8\")\n        assert \"pytest\" not in source, path.name\n        assert \"-m pytest\" not in source, path.name\n\n\n# --------------------------------------------------------------------------\n# The declaration, not the code, names the artifact\n# --------------------------------------------------------------------------\n\n\ndef probe_harness(tmp_path: Path, mutate) -> Path:\n    \"\"\"A harness root carrying a workflow this repository does not ship.\"\"\"\n    root = tmp_path / \"probe-harness\"\n    root.mkdir()\n    for directory in (\"prompts\", \"rules\", \"schemas\"):\n        shutil.copytree(REPO_ROOT / directory, root / directory)\n    workflow = json.loads(json.dumps(WORKFLOW))\n    for stage in workflow[\"stages\"]:\n        if stage[\"name\"] == \"verifier\":\n            mutate(stage)\n    workflow[\"name\"] = \"clean-clone-probe-workflow\"\n    (root / \"workflows\").mkdir()\n    write_json(root / \"workflows\" / \"clean-clone-probe-workflow.json\", workflow)\n    return root\n\n\ndef point_at(target_root: Path, workflow_name: str) -> None:\n    config = target_root / \".harness\" / \"config.yaml\"\n    config.write_text(\n        config.read_text(encoding=\"utf-8\").replace(\n            \"workflow: story-workflow\", f\"workflow: {workflow_name}\"),\n        encoding=\"utf-8\",\n    )\n    git(target_root, \"add\", \"-A\")\n    git(target_root, \"commit\", \"-q\", \"-m\", \"point at the probe workflow\")\n\n\n@pytest.fixture\ndef no_retry_harness_root(tmp_path) -> Path:\n    root = probe_harness(tmp_path, lambda stage: None)\n    rules = root / \"rules\" / \"execution-rules.json\"\n    payload = json.loads(rules.read_text(encoding=\"utf-8\"))\n    payload[\"max_retries\"] = 0\n    write_json(rules, payload)\n    return root\n\n\n@pytest.fixture(autouse=True)\ndef _point_probe_targets(request):\n    \"\"\"Targets driven against a probe harness must name its workflow.\"\"\"\n    yield\n\n\ndef test_the_shipped_workflow_declares_the_check_on_the_verifier_stage():\n    verifier = next(s for s in WORKFLOW[\"stages\"] if s[\"name\"] == \"verifier\")\n    assert verifier[\"clean_clone\"] == \"clean-clone-result.json\"\n    assert \"clean-clone-result.json\" not in verifier.get(\"outputs\", [])\n    assert \"clean-clone-result.json\" not in verifier.get(\"schemas\", {})\n\n\ndef test_removing_the_declaration_disables_the_check(buggy_target, tmp_path):\n    \"\"\"The proof the check is declaration-driven: orchestration is untouched,\n    only the workflow definition the run loads. The same fixture that\n    escalated above now completes, because nothing runs the clean-clone suite.\n    \"\"\"\n    harness = probe_harness(tmp_path, lambda stage: stage.pop(\"clean_clone\"))\n    point_at(buggy_target, \"clean-clone-probe-workflow\")\n\n    runner = Runner(buggy_target, [PASS])\n    assert story_coordinator.run_story(\n        \"story-001\", harness, buggy_target, runner) == 0\n    run_dir = run_dir_of(buggy_target)\n\n    assert not (run_dir / \"clean-clone-result.json\").exists()\n    assert not any(\"clean-clone\" in m for m in messages(run_dir))\n    assert \"documenter\" in runner.calls\n\n\ndef test_the_artifact_name_is_read_from_the_declaration_verbatim(sound_target,\n                                                                 tmp_path):\n    def rename(stage):\n        stage[\"clean_clone\"] = \"committed-suite-run.json\"\n\n    harness = probe_harness(tmp_path, rename)\n    point_at(sound_target, \"clean-clone-probe-workflow\")\n\n    runner = Runner(sound_target, [PASS])\n    assert story_coordinator.run_story(\n        \"story-001\", harness, sound_target, runner) == 0\n    run_dir = run_dir_of(sound_target)\n\n    assert (run_dir / \"committed-suite-run.json\").is_file()\n    assert not (run_dir / \"clean-clone-result.json\").exists()\n    assert read_record(run_dir, \"committed-suite-run.json\")[\"exit_code\"] == 0\n    assert schema_validator.validate(\n        read_record(run_dir, \"committed-suite-run.json\"),\n        schema_validator.load_schema(\"clean-clone-result\"),\n    ) == []\n\n\ndef test_no_artifact_name_is_written_into_the_clean_clone_code():\n    for name in (\"clean-clone-result.json\", \"verification-result.json\"):\n        assert name not in COORDINATOR_SOURCE, name\n\n\n# --------------------------------------------------------------------------\n# One write path for both renderings of an event\n# --------------------------------------------------------------------------\n\n\n@pytest.mark.parametrize(\"fixture\", [\"green_run\", \"caught_run\"])\ndef test_every_log_line_has_a_matching_structured_entry(fixture, request):\n    run_dir = request.getfixturevalue(fixture)[1]\n    history = history_of(run_dir)\n    assert [entry[\"message\"] for entry in history] == messages(run_dir)\n    assert [entry[\"sequence\"] for entry in history] == list(\n        range(1, len(history) + 1))\n\n\ndef test_the_clean_clone_events_carry_their_own_kinds(green_run, caught_run):\n    _, green_dir = green_run\n    _, failed_dir, _ = caught_run\n\n    passed = [e for e in history_of(green_dir) if e[\"event\"] == \"clean-clone-passed\"]\n    assert len(passed) == 1\n    assert passed[0][\"stage\"] == \"verifier\"\n    assert passed[0][\"artifacts\"] == [\"clean-clone-result.json\"]\n\n    failed = [e for e in history_of(failed_dir) if e[\"event\"] == \"clean-clone-failed\"]\n    assert len(failed) == 2\n    assert all(e[\"retry_decision\"] == \"retry\" for e in failed)\n    assert all(e[\"retry_reason\"] for e in failed)\n\n\ndef test_the_new_event_kinds_are_declared_in_the_history_schema():\n    schema = schema_validator.load_schema(\"execution-history\")\n    kinds = schema[\"items\"][\"properties\"][\"event\"][\"enum\"]\n    assert \"clean-clone-passed\" in kinds\n    assert \"clean-clone-failed\" in kinds\n\n\n@pytest.mark.parametrize(\"fixture\", [\"green_run\", \"caught_run\"])\ndef test_the_history_artifact_validates_against_its_schema(fixture, request):\n    run_dir = request.getfixturevalue(fixture)[1]\n    assert schema_validator.validate(\n        history_of(run_dir), schema_validator.load_schema(\"execution-history\")) == []\n\n\ndef test_neither_rendering_has_a_second_write_path():\n    \"\"\"append_event is the only writer of either file, so the two cannot\n    drift. One mention of each name in the coordinator, both inside it.\"\"\"\n    assert COORDINATOR_SOURCE.count('\"events.log\"') == 1\n    assert COORDINATOR_SOURCE.count('\"execution-history.json\"') == 0\n    assert COORDINATOR_SOURCE.count(\"execution-history.json\") == 1\n\n\ndef test_the_log_line_format_is_unchanged(green_run):\n    _, run_dir = green_run\n    for line in (run_dir / \"events.log\").read_text(encoding=\"utf-8\").splitlines():\n        assert LINE.match(line), line\n    # Built from the prose message alone: no structured field leaks into it.\n    assert not any(\"retry_decision\" in m or \"exit_code\" in m\n                   for m in messages(run_dir))\n","structuredPatch":[{"oldStart":421,"oldLines":6,"newStart":421,"newLines":7,"lines":[" def test_a_ceiling_of_zero_escalates_with_no_retry_and_no_archive(","     buggy_target, no_retry_harness_root,"," ):","+    point_at(buggy_target, \"clean-clone-probe-workflow\")","     runner = Runner(buggy_target, [PASS])","     code = story_coordinator.run_story(","         \"story-001\", no_retry_harness_root, buggy_target, runner)"]}],"userModified":false,"replaceAll":false}}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CdovHLAtoFzrAunusCDca","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Pu4DZ5kaVU35HAjwAqX3mu","name":"Edit","input":{"replace_all":false,"file_path":"/Users/jerodw/Work/AgenticProgramming/level-five/tests/test_story_014_validation.py","old_string":"    origin = git(clone, \"remote\", \"get-url\", \"origin\").strip()\n    assert Path(origin).is_dir()\n    assert \"://\" not in origin\n    assert Path(origin).resolve() == Path(clone).parent.parent.resolve() or \\\n        Path(origin).is_absolute()","new_string":"    origin = git(clone, \"remote\", \"get-url\", \"origin\").strip()\n    assert \"://\" not in origin\n    assert Path(origin).is_dir()\n    assert (Path(origin) / \".git\").exists()"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14168,"cache_read_input_tokens":71663,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14168},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9772d13d-b2d6-4982-8059-5e244b5d1415","uuid":"90cf1b71-e453-4dcf-ac50-4c2ea2c17be0","timestamp":"2026-08-07T19:13:02.077Z","request_id":"req_011CdovHKCMWPWqmDbbPQ7H8"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pu4DZ5kaVU35HAjwAqX3mu","type":"tool_result","content":"The file /Users/jerodw/Work/AgenticProgramming/level-five/tests/test_story_014_validation.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"9772d13d-b2d6-4982-8059-5e244b5d1415","uuid":"c4d3abe0-6bb1-4a68-9cf3-0a02cc30e225","timestamp":"2026-08-07T19:13:02.189Z","tool_use_result":{"filePath":"/Users/jerodw/Work/AgenticProgramming/level-five/tests/test_story_014_validation.py","oldString":"    origin = git(clone, \"remote\", \"get-url\", \"origin\").strip()\n    assert Path(origin).is_dir()\n    assert \"://\" not in origin\n    assert Path(origin).resolve() == Path(clone).parent.parent.resolve() or \\\n        Path(origin).is_absolute()","newString":"    origin = git(clone, \"remote\", \"get-url\", \"origin\").strip()\n    assert \"://\" not in origin\n    assert Path(origin).is_dir()\n    assert (Path(origin) / \".git\").exists()","originalFile":"\"\"\"story-014: the suite is run once more in a clean clone before the story ships.\n\nThe working tree is the one environment where the story's own commit does not\nexist yet, and it was the only environment the suite ever ran in: `_complete`\ncreates the committed state after the documenter and after every check that\ncould object to it. These tests drive the coordinator over a fixture that\nreproduces exactly that gap - a check resolving its baseline as\n`git show HEAD:...`, which is the pre-story revision only while the story is\nuncommitted, and which therefore passes in the working tree and fails once the\nstory is HEAD.\n\nThe fixture is deterministic and invokes no model: the \"suite\" is a shell\nscript in the target repository, and the target's configured test_command\nnames it. Nothing here asserts on pytest.\n\"\"\"\nimport json\nimport re\nimport shutil\nimport subprocess\nfrom pathlib import Path\n\nimport pytest\n\nimport context_assembler\nimport schema_validator\nimport story_coordinator\nfrom agent_runner import AgentResult\n\nREPO_ROOT = Path(story_coordinator.__file__).resolve().parents[1]\nCOORDINATOR_SOURCE = Path(story_coordinator.__file__).read_text(encoding=\"utf-8\")\nWORKFLOW = json.loads(\n    (REPO_ROOT / \"workflows\" / \"story-workflow.json\").read_text(encoding=\"utf-8\"))\n\nLINE = re.compile(r\"^\\[\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\] (.*)$\")\n\nPASS = {\"status\": \"passed\", \"blocking_issues\": [], \"unverified\": [],\n        \"retry_recommended\": False}\nFAIL = {\"status\": \"failed\",\n        \"blocking_issues\": [{\"severity\": \"high\", \"issue\": \"sample behavior missing\",\n                             \"location\": \"src/app.py\",\n                             \"required_behavior\": \"sample behavior exists\"}],\n        \"unverified\": [], \"retry_recommended\": True}\n\n\n# --------------------------------------------------------------------------\n# The fixture: a target repository whose suite is a script, in two versions\n# --------------------------------------------------------------------------\n\n# story-011's defect, reduced to its mechanism. The baseline is resolved as\n# HEAD, which names the pre-story revision only while the story is\n# uncommitted. In the working tree the two differ and the check passes; once\n# the story is committed HEAD *is* the story and the check fails.\nHEAD_BASELINE_CHECK = \"\"\"\\\nif git show HEAD:src/app.py | diff -q - src/app.py > /dev/null 2>&1; then\n    echo \"FAILED test_the_story_changed_app: src/app.py matches its HEAD baseline\"\n    exit 1\nfi\necho \"1 passed\"\n\"\"\"\n\n# The same check with the baseline bounded at a revision the story's own\n# commit cannot become: the root commit. True in both environments.\nROOT_BASELINE_CHECK = \"\"\"\\\nbase=$(git rev-list --max-parents=0 HEAD)\nif git show $base:src/app.py | diff -q - src/app.py > /dev/null 2>&1; then\n    echo \"FAILED test_the_story_changed_app: src/app.py matches its baseline\"\n    exit 1\nfi\necho \"1 passed\"\n\"\"\"\n\nGITIGNORE = \".venv/\\n.harness/runs/\\n.harness/logs/\\nsecret.txt\\n\"\n\n\ndef git(target_root: Path, *args: str) -> str:\n    return subprocess.run(\n        [\"git\", *args], cwd=str(target_root), capture_output=True, text=True,\n        check=True,\n    ).stdout\n\n\ndef scripted_target(target_root: Path, check: str,\n                    command: str = \"sh check.sh\") -> Path:\n    \"\"\"Point the fixture target's test_command at a shell script it carries.\n\n    The script is committed, so it reaches the clone as history rather than as\n    a working-tree edit, and the .gitignore is the one the clone-contents\n    assertions read.\n    \"\"\"\n    (target_root / \"check.sh\").write_text(check, encoding=\"utf-8\")\n    (target_root / \".gitignore\").write_text(GITIGNORE, encoding=\"utf-8\")\n    config = target_root / \".harness\" / \"config.yaml\"\n    config.write_text(\n        config.read_text(encoding=\"utf-8\").replace(\n            \"test_command: echo tests-ok\", f\"test_command: {command}\"),\n        encoding=\"utf-8\",\n    )\n    git(target_root, \"add\", \"-A\")\n    git(target_root, \"commit\", \"-q\", \"-m\", \"carry the suite as a script\")\n    return target_root\n\n\nclass Runner:\n    \"\"\"A fake agent runner that edits the target the way an implementer would.\n\n    The implementer's edit to src/app.py is what the fixture's check looks at,\n    so the working tree really does carry an uncommitted story, and the clone\n    really does have something to commit.\n    \"\"\"\n\n    def __init__(self, target_root: Path, verdicts, story_id: str = \"story-001\"):\n        self.target_root = target_root\n        self.run_dir = target_root / \".harness\" / \"runs\" / story_id\n        self.verdicts = list(verdicts)\n        self.attempt = 0\n        self.calls: list[str] = []\n\n    def _verdict(self) -> dict:\n        # A list shorter than the run needs repeats its last entry, so a run\n        # that retries on the clean-clone check keeps passing verification.\n        return self.verdicts.pop(0) if len(self.verdicts) > 1 else self.verdicts[0]\n\n    def __call__(self, prompt, *, stage, cwd, log_path, permission_mode, model,\n                 allowed_tools=None):\n        self.calls.append(stage)\n        if stage == \"implementer\":\n            self.attempt += 1\n            (self.target_root / \"src\" / \"app.py\").write_text(\n                f\"print('hello')\\nprint('attempt {self.attempt}')\\n\", encoding=\"utf-8\")\n            (self.target_root / \"notes.txt\").write_text(\n                \"an untracked file git does not ignore\\n\", encoding=\"utf-8\")\n            (self.target_root / \"secret.txt\").write_text(\n                \"gitignored; must not reach the clone\\n\", encoding=\"utf-8\")\n            write_json(self.run_dir / \"changed-files.json\", {\n                \"modified\": [\"src/app.py\"], \"created\": [\"notes.txt\"], \"deleted\": [],\n            })\n            (self.run_dir / \"implementation-summary.md\").write_text(\n                f\"Implemented on attempt {self.attempt}.\\n\", encoding=\"utf-8\")\n        elif stage == \"tester\":\n            write_json(self.run_dir / \"test-results.json\", {\n                \"status\": \"passed\", \"tests_written\": 1, \"tests_run\": 1,\n                \"tests_passed\": 1, \"tests_failed\": 0, \"failures\": [],\n            })\n            write_json(self.run_dir / \"tester-changed-files.json\", {\n                \"modified\": [], \"created\": [\"tests/test_app.py\"], \"deleted\": [],\n            })\n        elif stage == \"verifier\":\n            verdict = self._verdict()\n            write_json(self.run_dir / \"verification-result.json\", verdict)\n            if verdict[\"status\"] == \"failed\":\n                write_json(self.run_dir / \"retry-guidance.json\", {\n                    \"current_focus\": [\"fix the sample behavior\"],\n                    \"preserve_behavior\": [\"existing behavior\"],\n                    \"retry_scope\": [\"src/app.py\"],\n                })\n        elif stage == \"documenter\":\n            (self.run_dir / \"documentation-report.md\").write_text(\n                \"No changes needed.\\n\", encoding=\"utf-8\")\n        return AgentResult(ok=True, result_text=f\"{stage} done\")\n\n\ndef write_json(path: Path, payload) -> None:\n    path.write_text(json.dumps(payload, indent=2) + \"\\n\", encoding=\"utf-8\")\n\n\ndef run_dir_of(target_root: Path, story_id: str = \"story-001\") -> Path:\n    return target_root / \".harness\" / \"runs\" / story_id\n\n\ndef read_state(run_dir: Path) -> dict:\n    return json.loads((run_dir / \"state.json\").read_text(encoding=\"utf-8\"))\n\n\ndef read_record(run_dir: Path, name: str = \"clean-clone-result.json\") -> dict:\n    return json.loads((run_dir / name).read_text(encoding=\"utf-8\"))\n\n\ndef messages(run_dir: Path) -> list[str]:\n    prose = []\n    for line in (run_dir / \"events.log\").read_text(encoding=\"utf-8\").splitlines():\n        match = LINE.match(line)\n        assert match is not None, f\"line does not match the frozen format: {line!r}\"\n        prose.append(match.group(1))\n    return prose\n\n\ndef history_of(run_dir: Path) -> list[dict]:\n    return json.loads(\n        (run_dir / \"execution-history.json\").read_text(encoding=\"utf-8\"))\n\n\n@pytest.fixture\ndef buggy_target(target_root):\n    return scripted_target(target_root, HEAD_BASELINE_CHECK)\n\n\n@pytest.fixture\ndef sound_target(target_root):\n    return scripted_target(target_root, ROOT_BASELINE_CHECK)\n\n\n# --------------------------------------------------------------------------\n# The gap this story closes, reproduced\n# --------------------------------------------------------------------------\n\n\n@pytest.fixture\ndef caught_run(buggy_target, harness_root):\n    runner = Runner(buggy_target, [PASS])\n    code = story_coordinator.run_story(\n        \"story-001\", harness_root, buggy_target, runner)\n    return runner, run_dir_of(buggy_target), code\n\n\ndef test_a_suite_green_uncommitted_and_red_committed_never_reaches_the_documenter(\n    caught_run,\n):\n    \"\"\"The whole point: the verifier passed, the working-tree suite passed,\n    and the story still does not ship.\"\"\"\n    runner, run_dir, code = caught_run\n    assert \"documenter\" not in runner.calls\n    assert not (run_dir / \"documentation-report.md\").exists()\n    assert code == 2\n    assert read_state(run_dir)[\"status\"] == \"escalated\"\n\n\ndef test_the_working_tree_suite_the_check_disagrees_with_really_did_pass(\n    buggy_target,\n):\n    \"\"\"Guards the fixture: the failure is the environment, not a broken check.\n\n    Run uncommitted the fixture's suite exits zero; the same script exits\n    non-zero in the clone. If this ever stopped holding, the run above would\n    be catching an ordinary red suite and proving nothing.\n    \"\"\"\n    (buggy_target / \"src\" / \"app.py\").write_text(\n        \"print('hello')\\nprint('the story')\\n\", encoding=\"utf-8\")\n    result = subprocess.run(\n        \"sh check.sh\", shell=True, cwd=str(buggy_target),\n        capture_output=True, text=True)\n    assert result.returncode == 0, result.stdout + result.stderr\n\n\ndef test_the_same_fixture_with_its_baseline_corrected_advances(sound_target,\n                                                               harness_root):\n    \"\"\"The check distinguishes the two environments rather than failing\n    everything: the corrected baseline is green in both, and the run finishes.\"\"\"\n    runner = Runner(sound_target, [PASS])\n    code = story_coordinator.run_story(\n        \"story-001\", harness_root, sound_target, runner)\n    run_dir = run_dir_of(sound_target)\n\n    assert code == 0\n    assert runner.calls == [\"implementer\", \"tester\", \"verifier\", \"documenter\"]\n    assert read_state(run_dir)[\"status\"] == \"completed\"\n    assert read_record(run_dir)[\"exit_code\"] == 0\n\n\n# --------------------------------------------------------------------------\n# The record the check leaves behind\n# --------------------------------------------------------------------------\n\n\n@pytest.fixture\ndef green_run(sound_target, harness_root):\n    runner = Runner(sound_target, [PASS])\n    code = story_coordinator.run_story(\n        \"story-001\", harness_root, sound_target, runner)\n    assert code == 0\n    return runner, run_dir_of(sound_target)\n\n\ndef test_the_record_says_the_check_ran_rather_than_leaving_it_inferred(green_run):\n    _, run_dir = green_run\n    record = read_record(run_dir)\n    assert record[\"ran\"] is True\n    assert record[\"exit_code\"] == 0\n    assert record[\"command\"] == \"sh check.sh\"\n    assert record[\"clone_path\"]\n\n\ndef test_the_record_is_written_after_a_failing_run_too(caught_run):\n    _, run_dir, _ = caught_run\n    record = read_record(run_dir)\n    assert record[\"ran\"] is True\n    assert record[\"exit_code\"] != 0\n    assert \"FAILED test_the_story_changed_app\" in record[\"output_tail\"]\n\n\n@pytest.mark.parametrize(\"fixture\", [\"green_run\", \"caught_run\"])\ndef test_the_record_validates_against_its_schema(fixture, request):\n    run_dir = request.getfixturevalue(fixture)[1]\n    schema = schema_validator.load_schema(\"clean-clone-result\")\n    assert schema_validator.validate(read_record(run_dir), schema) == []\n\n\ndef test_the_schema_stays_inside_the_keyword_subset_the_validator_supports():\n    schema = schema_validator.load_schema(\"clean-clone-result\")\n    assert schema_validator.unsupported_keywords(schema) == []\n    assert schema_validator.validate({}, schema) != []\n\n\ndef test_the_schema_expresses_optional_fields_by_absence_not_by_null():\n    schema = schema_validator.load_schema(\"clean-clone-result\")\n    for name, subschema in schema[\"properties\"].items():\n        assert subschema[\"type\"] != \"null\", name\n        assert isinstance(subschema[\"type\"], str), name\n\n\ndef test_the_new_schema_is_in_both_inventory_assertions():\n    \"\"\"Both inventories are exact set equality, so a shipped schema missing\n    from either fails there; this asserts the file is shipped and named.\"\"\"\n    import test_schema_validator\n    import test_story_004_validation\n\n    assert \"clean-clone-result\" in test_schema_validator.SHIPPED\n    assert \"clean-clone-result\" in test_story_004_validation.SHIPPED_SCHEMAS\n    assert (REPO_ROOT / \"schemas\" / \"clean-clone-result.schema.json\").is_file()\n\n\n# --------------------------------------------------------------------------\n# A run that is genuinely green in both environments changes nothing else\n# --------------------------------------------------------------------------\n\n\ndef test_a_green_run_advances_with_retry_count_unchanged(green_run):\n    runner, run_dir = green_run\n    state = read_state(run_dir)\n    assert state[\"retry_count\"] == 0\n    assert state[\"verification_iterations\"] == 1\n    assert not (run_dir / \"attempts\").exists()\n    assert (run_dir / \"documentation-report.md\").is_file()\n\n\ndef test_a_green_run_alters_no_event_other_than_the_clean_clone_one(green_run):\n    _, run_dir = green_run\n    assert messages(run_dir) == [\n        \"workflow started for story-001\",\n        \"implementer stage started\",\n        \"implementer stage completed\",\n        \"tester stage started\",\n        \"tester stage completed\",\n        \"verifier stage started\",\n        \"verification passed\",\n        \"clean-clone suite passed with the story committed\",\n        \"documenter stage started\",\n        \"documenter stage completed\",\n        \"story completed on branch story/story-001\",\n    ]\n\n\ndef test_the_check_runs_after_the_verifier_and_before_the_documenter(green_run):\n    _, run_dir = green_run\n    order = messages(run_dir)\n    assert order.index(\"verification passed\") < order.index(\n        \"clean-clone suite passed with the story committed\")\n    assert order.index(\"clean-clone suite passed with the story committed\") < \\\n        order.index(\"documenter stage started\")\n\n\n# --------------------------------------------------------------------------\n# Routing on a clean-clone failure\n# --------------------------------------------------------------------------\n\n\ndef test_a_failure_reroutes_to_the_stage_the_verifier_declares(caught_run):\n    runner, run_dir, _ = caught_run\n    retry_stage = next(\n        s for s in WORKFLOW[\"stages\"] if s[\"name\"] == \"verifier\"\n    )[\"on_failure\"][\"retry_stage\"]\n    assert retry_stage == \"implementer\"\n    assert runner.calls == [\n        \"implementer\", \"tester\", \"verifier\",\n        \"implementer\", \"tester\", \"verifier\",\n        \"implementer\", \"tester\", \"verifier\",\n    ]\n\n\ndef test_each_failure_increments_retry_count_exactly_once(caught_run):\n    _, run_dir, _ = caught_run\n    assert read_state(run_dir)[\"retry_count\"] == 2\n    reroutes = [m for m in messages(run_dir) if m.startswith(\"clean-clone suite failed\")]\n    assert reroutes == [\n        \"clean-clone suite failed; retry 1 of 2 rerouted to implementer\",\n        \"clean-clone suite failed; retry 2 of 2 rerouted to implementer\",\n    ]\n\n\ndef test_the_superseded_attempts_are_archived_under_the_prompts_own_numbers(\n    caught_run,\n):\n    _, run_dir, _ = caught_run\n    attempts = run_dir / \"attempts\"\n    assert sorted(p.name for p in attempts.iterdir()) == [\"attempt-1\", \"attempt-2\"]\n    for number in (1, 2):\n        assert (run_dir / f\"prompt-implementer-attempt-{number}.md\").is_file()\n        assert (attempts / f\"attempt-{number}\" / \"implementation-summary.md\"\n                ).read_text() == f\"Implemented on attempt {number}.\\n\"\n    # The third, escalating attempt stays at the root where the escalation's\n    # reader expects it.\n    assert not (attempts / \"attempt-3\").exists()\n\n\ndef test_the_ceiling_escalates_naming_the_check_and_what_failed(caught_run):\n    _, run_dir, code = caught_run\n    assert code == 2\n    reason = [m for m in messages(run_dir) if m.startswith(\"escalated:\")]\n    assert len(reason) == 1\n    assert \"clean-clone\" in reason[0]\n    summary = (run_dir / \"escalation-summary.md\").read_text(encoding=\"utf-8\")\n    assert \"clean-clone\" in summary\n    assert \"test_the_story_changed_app\" in summary\n\n\ndef test_the_ceiling_escalates_rather_than_looping(caught_run):\n    runner, run_dir, _ = caught_run\n    assert runner.calls.count(\"verifier\") == 3\n    assert read_state(run_dir)[\"status\"] == \"escalated\"\n\n\ndef test_a_ceiling_of_zero_escalates_with_no_retry_and_no_archive(\n    buggy_target, no_retry_harness_root,\n):\n    point_at(buggy_target, \"clean-clone-probe-workflow\")\n    runner = Runner(buggy_target, [PASS])\n    code = story_coordinator.run_story(\n        \"story-001\", no_retry_harness_root, buggy_target, runner)\n    run_dir = run_dir_of(buggy_target)\n\n    assert code == 2\n    assert runner.calls == [\"implementer\", \"tester\", \"verifier\"]\n    assert read_state(run_dir)[\"retry_count\"] == 0\n    assert not (run_dir / \"attempts\").exists()\n\n\ndef test_the_coordinator_writes_no_retry_guidance_for_a_clean_clone_retry(\n    caught_run,\n):\n    \"\"\"That artifact is the verifier's. The verifier passed here, so nothing\n    wrote one - deterministic code must not fabricate an agent's judgement.\"\"\"\n    _, run_dir, _ = caught_run\n    assert not (run_dir / \"retry-guidance.json\").exists()\n    assert \"retry-guidance\" not in COORDINATOR_SOURCE\n\n\ndef test_the_retried_implementer_receives_the_evidence_in_its_prompt(caught_run):\n    _, run_dir, _ = caught_run\n    first = (run_dir / \"prompt-implementer-attempt-1.md\").read_text(encoding=\"utf-8\")\n    second = (run_dir / \"prompt-implementer-attempt-2.md\").read_text(encoding=\"utf-8\")\n    assert \"test_the_story_changed_app\" not in first\n    assert \"test_the_story_changed_app\" in second\n    assert \"{{clean_clone_result}}\" not in second\n\n\ndef test_the_placeholder_is_declared_and_assembled():\n    template = (REPO_ROOT / \"prompts\" / \"implementer.md\").read_text(encoding=\"utf-8\")\n    assert \"{{clean_clone_result}}\" in template\n    assembler = Path(context_assembler.__file__).read_text(encoding=\"utf-8\")\n    assert \"clean_clone_result\" in assembler\n    assert \"clean-clone-result.json\" in assembler\n\n\ndef test_the_context_value_is_none_when_the_artifact_is_absent(\n    sound_target, harness_root,\n):\n    run_dir = run_dir_of(sound_target)\n    run_dir.mkdir(parents=True, exist_ok=True)\n    context = context_assembler.build_context(\n        story_text=\"\",\n        story={},\n        run_dir=run_dir,\n        target_root=sound_target,\n        harness_root=harness_root,\n        config={},\n        rules={},\n        retry_count=0,\n    )\n    assert context[\"clean_clone_result\"] is None\n\n\n# --------------------------------------------------------------------------\n# The paths this story did not touch\n# --------------------------------------------------------------------------\n\n\ndef test_the_verification_failed_retry_path_is_unchanged(sound_target,\n                                                         harness_root):\n    \"\"\"A failing verdict still archives, increments, and reroutes exactly as\n    it did, and the clean-clone check does not run on the failing iteration.\"\"\"\n    runner = Runner(sound_target, [FAIL, PASS])\n    code = story_coordinator.run_story(\n        \"story-001\", harness_root, sound_target, runner)\n    run_dir = run_dir_of(sound_target)\n\n    assert code == 0\n    assert read_state(run_dir)[\"retry_count\"] == 1\n    assert messages(run_dir) == [\n        \"workflow started for story-001\",\n        \"implementer stage started\",\n        \"implementer stage completed\",\n        \"tester stage started\",\n        \"tester stage completed\",\n        \"verifier stage started\",\n        \"verification failed; retry 1 of 2 rerouted to implementer\",\n        \"implementer stage started\",\n        \"implementer stage completed\",\n        \"tester stage started\",\n        \"tester stage completed\",\n        \"verifier stage started\",\n        \"verification passed\",\n        \"clean-clone suite passed with the story committed\",\n        \"documenter stage started\",\n        \"documenter stage completed\",\n        \"story completed on branch story/story-001\",\n    ]\n\n\ndef test_a_verifier_that_recommends_no_retry_still_escalates_unchanged(\n    sound_target, harness_root,\n):\n    runner = Runner(sound_target, [{**FAIL, \"retry_recommended\": False}])\n    code = story_coordinator.run_story(\n        \"story-001\", harness_root, sound_target, runner)\n    run_dir = run_dir_of(sound_target)\n\n    assert code == 2\n    assert not (run_dir / \"clean-clone-result.json\").exists()\n    assert messages(run_dir)[-1] == (\n        \"escalated: verification failed and the verifier did not recommend a retry\")\n\n\ndef test_no_new_state_field_and_no_new_retry_axis(green_run):\n    _, run_dir = green_run\n    assert set(read_state(run_dir)) == {\n        \"story_id\", \"branch\", \"current_stage\", \"status\", \"retry_count\",\n        \"verification_iterations\",\n    }\n\n\n# --------------------------------------------------------------------------\n# How the clone is built\n# --------------------------------------------------------------------------\n\n\n@pytest.fixture\ndef dirty_target(sound_target):\n    \"\"\"The fixture target with an uncommitted story in its working tree.\"\"\"\n    (sound_target / \"src\" / \"app.py\").write_text(\n        \"print('hello')\\nprint('the story')\\n\", encoding=\"utf-8\")\n    (sound_target / \"notes.txt\").write_text(\"untracked, not ignored\\n\",\n                                            encoding=\"utf-8\")\n    (sound_target / \"secret.txt\").write_text(\"gitignored\\n\", encoding=\"utf-8\")\n    (sound_target / \".venv\" / \"bin\").mkdir(parents=True)\n    (sound_target / \".venv\" / \"bin\" / \"python\").write_text(\"#!/bin/sh\\n\",\n                                                           encoding=\"utf-8\")\n    return sound_target\n\n\n@pytest.fixture\ndef direct_clone(dirty_target, tmp_path):\n    \"\"\"run_clean_clone against a scratch directory this test owns.\n\n    The coordinator removes its own scratch directory the moment the suite\n    returns, so the only way to look inside the clone is to drive the run\n    directly with a scratch path the caller keeps.\n    \"\"\"\n    scratch = tmp_path / \"scratch\"\n    scratch.mkdir()\n    result = story_coordinator.run_clean_clone(dirty_target, \"sh check.sh\", scratch)\n    return result, Path(result.clone_path)\n\n\ndef test_the_clone_has_the_story_as_a_commit_not_as_pending_edits(direct_clone):\n    _, clone = direct_clone\n    assert (clone / \"src\" / \"app.py\").read_text() == (\n        \"print('hello')\\nprint('the story')\\n\")\n    assert git(clone, \"status\", \"--porcelain\").strip() == \"\"\n    assert git(clone, \"show\", \"HEAD:src/app.py\") == (\n        \"print('hello')\\nprint('the story')\\n\")\n    # The story sits on top of the original history rather than replacing it.\n    assert len(git(clone, \"log\", \"--format=%H\").split()) >= 2\n\n\ndef test_the_clone_carries_untracked_files_git_does_not_ignore(direct_clone):\n    _, clone = direct_clone\n    assert (clone / \"notes.txt\").read_text() == \"untracked, not ignored\\n\"\n    assert \"notes.txt\" in git(clone, \"ls-files\").split()\n\n\ndef test_gitignored_files_are_absent_from_the_clone(direct_clone):\n    \"\"\"The clone's contents are the set `_complete`'s `git add -A` would\n    commit, which is what makes the environment the one the story ships in.\"\"\"\n    _, clone = direct_clone\n    tracked = git(clone, \"ls-files\").split()\n    assert \"secret.txt\" not in tracked\n    assert not (clone / \"secret.txt\").exists()\n    assert not any(path.startswith(\".venv/\") for path in tracked)\n    assert not any(path.startswith(\".harness/runs/\") for path in tracked)\n\n\ndef test_the_clone_source_is_a_local_path_so_no_network_is_possible(direct_clone):\n    \"\"\"By construction rather than by observation: origin is the target\n    directory on this filesystem, so there is no host to reach.\"\"\"\n    _, clone = direct_clone\n    origin = git(clone, \"remote\", \"get-url\", \"origin\").strip()\n    assert Path(origin).is_dir()\n    assert \"://\" not in origin\n    assert Path(origin).resolve() == Path(clone).parent.parent.resolve() or \\\n        Path(origin).is_absolute()\n\n\ndef test_the_clone_is_built_outside_the_target_repository(direct_clone,\n                                                          dirty_target):\n    _, clone = direct_clone\n    assert dirty_target.resolve() not in clone.resolve().parents\n\n\ndef test_the_target_repository_is_not_mutated_by_the_check(dirty_target, tmp_path):\n    before_head = git(dirty_target, \"rev-parse\", \"HEAD\")\n    before_status = git(dirty_target, \"status\", \"--porcelain\")\n    before_branch = git(dirty_target, \"rev-parse\", \"--abbrev-ref\", \"HEAD\")\n    before_stash = git(dirty_target, \"stash\", \"list\")\n    before_branches = git(dirty_target, \"branch\", \"--format=%(refname)\")\n\n    scratch = tmp_path / \"scratch\"\n    scratch.mkdir()\n    story_coordinator.run_clean_clone(dirty_target, \"sh check.sh\", scratch)\n\n    assert git(dirty_target, \"rev-parse\", \"HEAD\") == before_head\n    assert git(dirty_target, \"status\", \"--porcelain\") == before_status\n    assert git(dirty_target, \"rev-parse\", \"--abbrev-ref\", \"HEAD\") == before_branch\n    assert git(dirty_target, \"stash\", \"list\") == before_stash\n    assert git(dirty_target, \"branch\", \"--format=%(refname)\") == before_branches\n\n\n@pytest.mark.parametrize(\"fixture\", [\"green_run\", \"caught_run\"])\ndef test_the_scratch_clone_is_removed_after_the_run(fixture, request):\n    \"\"\"Whatever the result: the record identifies the environment rather than\n    pointing at a surviving one.\"\"\"\n    run_dir = request.getfixturevalue(fixture)[1]\n    record = read_record(run_dir)\n    clone = Path(record[\"clone_path\"])\n    assert not clone.exists()\n    assert not clone.parent.exists()\n\n\ndef test_the_test_command_comes_from_the_target_config(target_root, harness_root):\n    \"\"\"No command string is written into orchestration code; changing the\n    config changes what the check runs.\"\"\"\n    scripted_target(target_root, ROOT_BASELINE_CHECK, command=\"sh other-check.sh\")\n    (target_root / \"other-check.sh\").write_text(\"echo elsewhere\\n\", encoding=\"utf-8\")\n\n    runner = Runner(target_root, [PASS])\n    assert story_coordinator.run_story(\n        \"story-001\", harness_root, target_root, runner) == 0\n    record = read_record(run_dir_of(target_root))\n    assert record[\"command\"] == \"sh other-check.sh\"\n    assert record[\"output_tail\"].strip() == \"elsewhere\"\n\n\ndef test_no_test_command_string_appears_in_orchestration_code():\n    for path in (REPO_ROOT / \"orchestration\").glob(\"*.py\"):\n        source = path.read_text(encoding=\"utf-8\")\n        assert \"pytest\" not in source, path.name\n        assert \"-m pytest\" not in source, path.name\n\n\n# --------------------------------------------------------------------------\n# The declaration, not the code, names the artifact\n# --------------------------------------------------------------------------\n\n\ndef probe_harness(tmp_path: Path, mutate) -> Path:\n    \"\"\"A harness root carrying a workflow this repository does not ship.\"\"\"\n    root = tmp_path / \"probe-harness\"\n    root.mkdir()\n    for directory in (\"prompts\", \"rules\", \"schemas\"):\n        shutil.copytree(REPO_ROOT / directory, root / directory)\n    workflow = json.loads(json.dumps(WORKFLOW))\n    for stage in workflow[\"stages\"]:\n        if stage[\"name\"] == \"verifier\":\n            mutate(stage)\n    workflow[\"name\"] = \"clean-clone-probe-workflow\"\n    (root / \"workflows\").mkdir()\n    write_json(root / \"workflows\" / \"clean-clone-probe-workflow.json\", workflow)\n    return root\n\n\ndef point_at(target_root: Path, workflow_name: str) -> None:\n    config = target_root / \".harness\" / \"config.yaml\"\n    config.write_text(\n        config.read_text(encoding=\"utf-8\").replace(\n            \"workflow: story-workflow\", f\"workflow: {workflow_name}\"),\n        encoding=\"utf-8\",\n    )\n    git(target_root, \"add\", \"-A\")\n    git(target_root, \"commit\", \"-q\", \"-m\", \"point at the probe workflow\")\n\n\n@pytest.fixture\ndef no_retry_harness_root(tmp_path) -> Path:\n    root = probe_harness(tmp_path, lambda stage: None)\n    rules = root / \"rules\" / \"execution-rules.json\"\n    payload = json.loads(rules.read_text(encoding=\"utf-8\"))\n    payload[\"max_retries\"] = 0\n    write_json(rules, payload)\n    return root\n\n\n@pytest.fixture(autouse=True)\ndef _point_probe_targets(request):\n    \"\"\"Targets driven against a probe harness must name its workflow.\"\"\"\n    yield\n\n\ndef test_the_shipped_workflow_declares_the_check_on_the_verifier_stage():\n    verifier = next(s for s in WORKFLOW[\"stages\"] if s[\"name\"] == \"verifier\")\n    assert verifier[\"clean_clone\"] == \"clean-clone-result.json\"\n    assert \"clean-clone-result.json\" not in verifier.get(\"outputs\", [])\n    assert \"clean-clone-result.json\" not in verifier.get(\"schemas\", {})\n\n\ndef test_removing_the_declaration_disables_the_check(buggy_target, tmp_path):\n    \"\"\"The proof the check is declaration-driven: orchestration is untouched,\n    only the workflow definition the run loads. The same fixture that\n    escalated above now completes, because nothing runs the clean-clone suite.\n    \"\"\"\n    harness = probe_harness(tmp_path, lambda stage: stage.pop(\"clean_clone\"))\n    point_at(buggy_target, \"clean-clone-probe-workflow\")\n\n    runner = Runner(buggy_target, [PASS])\n    assert story_coordinator.run_story(\n        \"story-001\", harness, buggy_target, runner) == 0\n    run_dir = run_dir_of(buggy_target)\n\n    assert not (run_dir / \"clean-clone-result.json\").exists()\n    assert not any(\"clean-clone\" in m for m in messages(run_dir))\n    assert \"documenter\" in runner.calls\n\n\ndef test_the_artifact_name_is_read_from_the_declaration_verbatim(sound_target,\n                                                                 tmp_path):\n    def rename(stage):\n        stage[\"clean_clone\"] = \"committed-suite-run.json\"\n\n    harness = probe_harness(tmp_path, rename)\n    point_at(sound_target, \"clean-clone-probe-workflow\")\n\n    runner = Runner(sound_target, [PASS])\n    assert story_coordinator.run_story(\n        \"story-001\", harness, sound_target, runner) == 0\n    run_dir = run_dir_of(sound_target)\n\n    assert (run_dir / \"committed-suite-run.json\").is_file()\n    assert not (run_dir / \"clean-clone-result.json\").exists()\n    assert read_record(run_dir, \"committed-suite-run.json\")[\"exit_code\"] == 0\n    assert schema_validator.validate(\n        read_record(run_dir, \"committed-suite-run.json\"),\n        schema_validator.load_schema(\"clean-clone-result\"),\n    ) == []\n\n\ndef test_no_artifact_name_is_written_into_the_clean_clone_code():\n    for name in (\"clean-clone-result.json\", \"verification-result.json\"):\n        assert name not in COORDINATOR_SOURCE, name\n\n\n# --------------------------------------------------------------------------\n# One write path for both renderings of an event\n# --------------------------------------------------------------------------\n\n\n@pytest.mark.parametrize(\"fixture\", [\"green_run\", \"caught_run\"])\ndef test_every_log_line_has_a_matching_structured_entry(fixture, request):\n    run_dir = request.getfixturevalue(fixture)[1]\n    history = history_of(run_dir)\n    assert [entry[\"message\"] for entry in history] == messages(run_dir)\n    assert [entry[\"sequence\"] for entry in history] == list(\n        range(1, len(history) + 1))\n\n\ndef test_the_clean_clone_events_carry_their_own_kinds(green_run, caught_run):\n    _, green_dir = green_run\n    _, failed_dir, _ = caught_run\n\n    passed = [e for e in history_of(green_dir) if e[\"event\"] == \"clean-clone-passed\"]\n    assert len(passed) == 1\n    assert passed[0][\"stage\"] == \"verifier\"\n    assert passed[0][\"artifacts\"] == [\"clean-clone-result.json\"]\n\n    failed = [e for e in history_of(failed_dir) if e[\"event\"] == \"clean-clone-failed\"]\n    assert len(failed) == 2\n    assert all(e[\"retry_decision\"] == \"retry\" for e in failed)\n    assert all(e[\"retry_reason\"] for e in failed)\n\n\ndef test_the_new_event_kinds_are_declared_in_the_history_schema():\n    schema = schema_validator.load_schema(\"execution-history\")\n    kinds = schema[\"items\"][\"properties\"][\"event\"][\"enum\"]\n    assert \"clean-clone-passed\" in kinds\n    assert \"clean-clone-failed\" in kinds\n\n\n@pytest.mark.parametrize(\"fixture\", [\"green_run\", \"caught_run\"])\ndef test_the_history_artifact_validates_against_its_schema(fixture, request):\n    run_dir = request.getfixturevalue(fixture)[1]\n    assert schema_validator.validate(\n        history_of(run_dir), schema_validator.load_schema(\"execution-history\")) == []\n\n\ndef test_neither_rendering_has_a_second_write_path():\n    \"\"\"append_event is the only writer of either file, so the two cannot\n    drift. One mention of each name in the coordinator, both inside it.\"\"\"\n    assert COORDINATOR_SOURCE.count('\"events.log\"') == 1\n    assert COORDINATOR_SOURCE.count('\"execution-history.json\"') == 0\n    assert COORDINATOR_SOURCE.count(\"execution-history.json\") == 1\n\n\ndef test_the_log_line_format_is_unchanged(green_run):\n    _, run_dir = green_run\n    for line in (run_dir / \"events.log\").read_text(encoding=\"utf-8\").splitlines():\n        assert LINE.match(line), line\n    # Built from the prose message alone: no structured field leaks into it.\n    assert not any(\"retry_decision\" in m or \"exit_code\" in m\n                   for m in messages(run_dir))\n","structuredPatch":[{"oldStart":603,"oldLines":10,"newStart":603,"newLines":9,"lines":["     directory on this filesystem, so there is no host to reach.\"\"\"","     _, clone = direct_clone","     origin = git(clone, \"remote\", \"get-url\", \"origin\").strip()","-    assert Path(origin).is_dir()","     assert \"://\" not in origin","-    assert Path(origin).resolve() == Path(clone).parent.parent.resolve() or \\","-        Path(origin).is_absolute()","+    assert Path(origin).is_dir()","+    assert (Path(origin) / \".git\").exists()"," "," "," def test_the_clone_is_built_outside_the_target_repository(direct_clone,"]}],"userModified":false,"replaceAll":false}}
