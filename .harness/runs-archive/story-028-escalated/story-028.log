,\n    \"description\": \"One event. sequence, timestamp, event and message are present on every entry; the remaining fields appear only on the events that have them.\",\n    \"required\": [\"sequence\", \"timestamp\", \"event\", \"message\"],\n    \"properties\": {\n      \"sequence\": {\n        \"type\": \"integer\",\n        \"description\": \"1-based position in the stream, matching the line number in events.log.\"\n      },\n      \"timestamp\": {\n        \"type\": \"string\",\n        \"description\": \"Wall-clock time the event was appended, in the same YYYY-MM-DD HH:MM:SS form events.log uses.\"\n      },\n      \"event\": {\n        \"type\": \"string\",\n        \"description\": \"What kind of event this is.\",\n        \"enum\": [\n          \"workflow-started\",\n          \"resumed\",\n          \"stage-started\",\n          \"stage-completed\",\n          \"stage-exception-applied\",\n          \"verification-passed\",\n          \"verification-failed\",\n          \"clean-clone-passed\",\n          \"clean-clone-failed\",\n          \"escalated\",\n          \"story-completed\",\n          \"note\"\n        ]\n      },\n      \"message\": {\n        \"type\": \"string\",\n        \"description\": \"The prose line as it was written to events.log, without the timestamp prefix.\"\n      },\n      \"stage\": {\n        \"type\": \"string\",\n        \"description\": \"The workflow stage the event belongs to. Absent on events that belong to the run rather than a stage.\"\n      },\n      \"artifacts\": {\n        \"type\": \"array\",\n        \"description\": \"The artifacts the stage produced, taken from that stage's declared outputs in the workflow definition.\",\n        \"items\": { \"type\": \"string\" }\n      },\n      \"duration_seconds\": {\n        \"type\": \"number\",\n        \"description\": \"Elapsed seconds since the stage started, on the event that ends a stage.\"\n      },\n      \"verifier_outcome\": {\n        \"type\": \"string\",\n        \"description\": \"The verifier's verdict, on events that carry one.\",\n        \"enum\": [\"passed\", \"failed\"]\n      },\n      \"retry_decision\": {\n        \"type\": \"string\",\n        \"description\": \"The routing decision taken after a failed verification.\",\n        \"enum\": [\"retry\", \"escalate\"]\n      },\n      \"retry_reason\": {\n        \"type\": \"string\",\n        \"description\": \"Why that retry decision was taken.\"\n      }\n    }\n  }\n}\n","structuredPatch":[{"oldStart":64,"oldLines":6,"newStart":64,"newLines":14,"lines":["       \"retry_reason\": {","         \"type\": \"string\",","         \"description\": \"Why that retry decision was taken.\"","+      },","+      \"retry_category\": {","+        \"type\": \"string\",","+        \"description\": \"The retry category the verifier reported, as the workflow's retry_routing table declares it. Absent on a retry that carries no category, such as a clean-clone failure, and on events that route nothing.\"","+      },","+      \"retry_stage\": {","+        \"type\": \"string\",","+        \"description\": \"The stage the retry was routed to, read off the workflow's declared route rather than a constant. With retry_category it makes the route a reader can reconstruct from the history alone.\"","       }","     }","   }"]}],"userModified":false,"replaceAll":false}}
