{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HLmtMF4ynpA1RaDfC51BJh","type":"tool_result","content":"1802\tdef run_story(\n1803\t    story_id: str,\n1804\t    harness_root: Path,\n1805\t    target_root: Path,\n1806\t    runner=agent_runner.run_agent,\n1807\t    start_stage: str | None = None,\n1808\t) -> int:\n1809\t    \"\"\"Execute one story, from a fresh run or from where a run left off.\n1810\t\n1811\t    `start_stage` overrides where execution enters — the recorded stage on a\n1812\t    resume, the workflow's first stage on a fresh run. It is named\n1813\t    `start_stage` rather than `stage` because `stage` is the loop's name for\n1814\t    the stage being executed, and one name for two things is how this\n1815\t    repository has repeatedly confused itself.\n1816\t    \"\"\"\n1817\t    config = harness_config.load_config(target_root)\n1818\t    workflow = harness_config.load_workflow(harness_root, config.get(\"workflow\", \"story-workflow\"))\n1819\t    rules = harness_config.load_rules(harness_root)\n1820\t    stages = workflow[\"stages\"]\n1821\t    stage_names = [s[\"name\"] for s in stages]\n1822\t\n1823\t    # A stage the developer named overrides where execution enters, which is\n1824\t    # what makes a resume useful: an escalation caused by an amended story is\n1825\t    # re-entered at the implementer rather than at the verifier that recorded\n1826\t    # it. Refused above everything else, in the shape the other pre-flight\n1827\t    # refusals take — exit 1, one message, nothing created and no agent run.\n1828\t    if start_stage is not None and start_stage not in stage_names:\n1829\t        print(\n1830\t            f\"'{start_stage}' is not a stage the loaded workflow defines. \"\n1831\t            f\"{workflow['name']} defines: {', '.join(stage_names)}.\",\n1832\t            file=sys.stderr,\n1833\t        )\n1834\t        return 1\n1835\t\n1836\t    story_path = target_root / config.get(\"stories_dir\", \".harness/stories\") / f\"{story_id}.yaml\"\n1837\t    if not story_path.is_file():\n1838\t        print(f\"No story artifact at {story_path}. Run l5-plan first.\", file=sys.stderr)\n1839\t        return 1\n1840\t    story_text = story_path.read_text(encoding=\"utf-8\")\n1841\t\n1842\t    # Pre-flight: refuse a bad story before any run state exists, so a\n1843\t    # rejection leaves no run directory, no state.json, and no new branch.\n1844\t    # The schema ships with the harness code, so it is resolved by\n1845\t    # schema_validator relative to its own module, not from harness_root.\n1846\t    reading = read_story(story_text)\n1847\t    if reading.problems:\n1848\t        return refuse_bad_story(story_path, reading.problems)\n1849\t\n1850\t    # Conformance is one question, agreement with this workflow another. A\n1851\t    # stage exception is checked here rather than inside read_story so schema\n1852\t    # reading stays schema reading, and both refusals stay above run-directory\n1853\t    # creation.\n1854\t    exception_problems = stage_exception_problems(reading.parsed, stages)\n1855\t    if exception_problems:\n1856\t        return refuse_bad_story(story_path, exception_problems)\n1857\t\n1858\t    run_dir = target_root / config.get(\"runs_dir\", \".harness/runs\") / story_id\n1859\t    state = load_state(run_dir)\n1860\t\n1861\t    # Pre-flight: refuse a run onto a branch that already holds this story's\n1862\t    # finished work. `_checkout_story_branch` reuses an existing branch rather\n1863\t    # than resetting it, so deleting only the run directory puts the implementer\n1864\t    # in a repository where the story is already done, the tester finds the\n1865\t    # tests written and passing, the verifier verifies a tree that genuinely\n1866\t    # satisfies the story, and the run reports success having changed nothing.\n1867\t    #\n1868\t    # The evidence is deliberately a *finished run* — `_complete`'s own commit,\n1869\t    # recognized by its subject and marker — and not the existence of commits on\n1870\t    # the branch. Those are different statements, and only the first is what\n1871\t    # makes a re-run pointless: an escalation already leaves two commits, so an\n1872\t    # ahead-of-base test would refuse every escalated resume, and a later design\n1873\t    # that commits partial progress would have to unpick a check written that\n1874\t    # way. It is base-free for the same reason, so it still holds when the\n1875\t    # developer is standing on the branch a completed run left them on.\n1876\t    #\n1877\t    # A loaded state recording `completed` keeps its own refusal below: that one\n1878\t    # has the run directory to point at and says more.\n1879\t    if not (state and state.status == \"completed\"):\n1880\t        branch = state.branch if state else story_branch(config, story_id)\n1881\t        finished = completion_commits(target_root, branch, story_id)\n1882\t        if finished:\n1883\t            return _refuse_finished_branch(branch, run_dir, finished)\n1884\t\n1885\t    # Pre-flight: a run commits the tree it ends on, so it has to start from a\n1886\t    # tree it can account for. Which runs this applies to is decided by the\n1887\t    # state the run is *starting from*, which is already loaded above for the\n1888\t    # resume decision. No state is a fresh run; an escalated state is a resume\n1889\t    # of a run that left the tree clean when it escalated, so anything\n1890\t    # uncommitted now is the developer's own fix and committing it deliberately\n1891\t    # is what this check is for. A `running` state is the one exclusion, and it\n1892\t    # is not an exception to the rule so much as a different tree: nothing\n1893\t    # commits when a process dies, so that working tree holds the run's own\n1894\t    # unfinished work and refusing it would refuse the run its own state.\n1895\t    #\n1896\t    # It sits above the run-directory creation and the branch checkout, so a\n1897\t    # refusal leaves no run directory, no state.json, no log, no new branch,\n1898\t    # and invokes no agent. There is deliberately no flag, environment variable\n1899\t    # or configuration key that skips it: a bypass on a correctness guard\n1900\t    # becomes the default invocation.\n1901\t    if state is None or state.status == \"escalated\":\n1902\t        dirty = dirty_paths(target_root)\n1903\t        if dirty:\n1904\t            return _refuse_dirty_tree(target_root, dirty)\n1905\t\n1906\t    run_dir.mkdir(parents=True, exist_ok=True)\n1907\t    (run_dir / \"verification\").mkdir(exist_ok=True)\n1908\t    log_path = target_root / config.get(\"logs_dir\", \".harness/logs\") / f\"{story_id}.log\"\n1909\t\n1910\t    if state and state.status == \"completed\":\n1911\t        # Name the branch as well as the run directory. _checkout_story_branch\n1912\t        # reuses an existing branch rather than resetting it, so deleting only\n1913\t        # the run directory re-runs the story on top of the finished work — the\n1914\t        # implementer opens a repository where the story is already done, and\n1915\t        # the run reports success having changed nothing. This guard is about\n1916\t        # finished work; an escalated run resumes below, because its work is\n1917\t        # not finished and its evidence is what the resume exists to keep.\n1918\t        print(\n1919\t            f\"{story_id} already ended with status '{state.status}'. \"\n1920\t            f\"Inspect {run_dir} to review it.\\n\"\n1921\t            f\"To run the story again, delete {run_dir} *and* reset branch \"\n1922\t            f\"{state.branch}, which still holds the finished work. Archive both \"\n1923\t            f\"first if the run is worth keeping — {run_dir} is gitignored.\",\n1924\t            file=sys.stderr,\n1925\t        )\n1926\t        return 1\n1927\t    if state:\n1928\t        # A resume, of a crashed run or an escalated one. Chapter 18 treats\n1929\t        # the two identically and so does this: restore nothing, because the\n1930\t        # artifacts and the state are already here, and continue at the\n1931\t        # recorded stage. Nothing is reinitialized — retry_count and\n1932\t        # verification_iterations key the rendered prompt and verification\n1933\t        # iteration filenames, so resetting them would overwrite the evidence\n1934\t        # of the attempt being resumed.\n1935\t        if state.status == \"escalated\":\n1936\t            # Resuming is inferred from the recorded status and from nothing\n1937\t            # else. What the guard adds is a refusal in the one case where a\n1938\t            # resume is knowably pointless: the story, the tree and the harness\n1939\t            # are all establishably what they were when the run escalated.\n1940\t            evidence = unchanged_since_escalation(\n1941\t                state, story_text, target_root, harness_root\n1942\t            )\n1943\t            if evidence:\n1944\t                print(\n1945\t                    _resume_refusal(story_path, run_dir, state, evidence),\n1946\t                    file=sys.stderr,\n1947\t                )\n1948\t                return 1\n1949\t        if start_stage:\n1950\t            state.current_stage = start_stage\n1951\t        if state.status == \"escalated\":\n1952\t            # The interrupted attempt is archived before the resumed stage\n1953\t            # runs, under the attempt number it was written with. Refuse rather\n1954\t            # than overwrite: the archive is the evidence a resume exists to\n1955\t            # preserve, and story-010 recorded exactly this case as open.\n1956\t            attempt = state.retry_count + 1\n1957\t            destination = attempt_dir(run_dir, attempt)\n1958\t            if destination.exists():\n1959\t                print(\n1960\t                    f\"{destination} already holds an archived attempt, and \"\n1961\t                    f\"resuming {story_id} would write attempt {attempt} over \"\n1962\t                    f\"it. Move or remove it if that attempt is not worth \"\n1963\t                    f\"keeping, then run the story again.\",\n1964\t                    file=sys.stderr,\n1965\t                )\n1966\t                return 1\n1967\t            archive_attempt(\n1968\t                run_dir, interrupted_attempt_artifacts(stages, attempt), attempt\n1969\t            )\n1970\t            state.status = \"running\"\n1971\t            save_state(run_dir, state)\n1972\t        append_event(\n1973\t            run_dir,\n1974\t            f\"resumed at stage {state.current_stage}\",\n1975\t            kind=\"resumed\",\n1976\t            stage=state.current_stage,\n1977\t        )\n1978\t    else:\n1979\t        state = RunState(\n1980\t            story_id=story_id,\n1981\t            branch=story_branch(config, story_id),\n1982\t            current_stage=start_stage or stage_names[0],\n1983\t            # Recorded from the same text read_story was given, so the digest\n1984\t            # and the run's one reading describe one artifact.\n1985\t            story_digest=story_digest(story_text),\n1986\t        )\n1987\t        save_state(run_dir, state)\n1988\t        append_event(\n1989\t            run_dir, f\"workflow started for {story_id}\", kind=\"workflow-started\"\n1990\t        )\n1991\t\n1992\t    _checkout_story_branch(target_root, state.branch)\n1993\t\n1994\t    # Stage timing: started where the stage-started event is appended, read at\n1995\t    # whichever event ends the stage, so a completed stage carries an elapsed\n1996\t    # duration the log only made derivable.\n1997\t    stage_started_at: float | None = None\n1998\t\n1999\t    def elapsed() -> float | None:\n2000\t        if stage_started_at is None:\n2001\t            return None\n2002\t        return round(time.monotonic() - stage_started_at, 3)\n2003\t\n2004\t    index = stage_names.index(state.current_stage)\n2005\t    while index < len(stages):\n2006\t        stage = stages[index]\n2007\t        name = stage[\"name\"]\n2008\t        state.current_stage = name\n2009\t        save_state(run_dir, state)\n2010\t        stage_started_at = time.monotonic()\n2011\t        append_event(run_dir, f\"{name} stage started\", kind=\"stage-started\", stage=name)\n2012\t\n2013\t        context = context_assembler.build_context(\n2014\t            story_text=story_text,\n2015\t            story=reading.parsed,\n2016\t            run_dir=run_dir,\n2017\t            target_root=target_root,\n2018\t            harness_root=harness_root,\n2019\t            config=config,\n2020\t            rules=rules,\n2021\t            retry_count=state.retry_count,\n2022\t        )\n2023\t        template = context_assembler.load_template(harness_root, stage[\"prompt\"])\n2024\t        prompt = context_assembler.render(template, context)\n2025\t        attempt = state.retry_count + 1\n2026\t        (run_dir / f\"prompt-{name}-attempt-{attempt}.md\").write_text(prompt, encoding=\"utf-8\")\n2027\t\n2028\t        # What this stage's artifacts looked like before it ran. One snapshot,\n2029\t        # covering the conditional artifacts and the required ones together,\n2030\t        # feeding one comparison function. The conditional readers ask which\n2031\t        # of them this attempt wrote — nothing clears the retry guidance\n2032\t        # between attempts — and the required reader below asks the same\n2033\t        # question of the outputs, because a retry that leaves one untouched\n2034\t        # satisfies a presence check with a superseded attempt's file.\n2035\t        # artifacts_written_since narrows by the names its caller passes, so\n2036\t        # widening what is covered here changes neither conditional reader.\n2037\t        conditional = conditional_artifacts(stage)\n2038\t        required = required_artifacts(stage)\n2039\t        artifacts_before = artifact_signatures(run_dir, conditional + required)\n2040\t\n2041\t        # What the tree held under this stage's governed prefixes before it\n2042\t        # ran, which is the baseline the revert check below decides against.\n2043\t        # Both names come off the stage's declaration, so removing that one\n2044\t        # key disables the capture and the check together. Captured over the\n2045\t        # declared prefixes rather than the grant-subtracted list: the\n2046\t        # enforced list is computed after the stage, and capturing a superset\n2047\t        # costs a few file copies while the restore set stays narrowed.\n2048\t        declaration = stage.get(\"revert_check\") or {}\n2049\t        baseline_dir = (\n2050\t            capture_stage_baseline(\n2051\t                run_dir,\n2052\t                target_root,\n2053\t                declaration[\"baseline\"],\n2054\t                name,\n2055\t                attempt,\n2056\t                stage.get(\"may_not_create\", []),\n2057\t            )\n2058\t            if declaration\n2059\t            else None\n2060\t        )\n2061\t\n2062\t        result = runner(\n2063\t            prompt,\n2064\t            stage=name,\n2065\t            cwd=target_root,\n2066\t            log_path=log_path,\n2067\t            permission_mode=config.get(\"permission_mode\", \"acceptEdits\"),\n2068\t            model=config.get(\"model\"),\n2069\t            allowed_tools=config.get(\"allowed_tools\"),\n2070\t        )\n2071\t        if not result.ok:\n2072\t            return _escalate(\n2073\t                run_dir,\n2074\t                state,\n2075\t                f\"{name} agent process failed\",\n2076\t                target_root=target_root,\n2077\t                harness_root=harness_root,\n2078\t                duration_seconds=elapsed(),\n2079\t            )\n2080\t\n2081\t        missing = [out for out in stage.get(\"outputs\", []) if not (run_dir / out).is_file()]"}]},"parent_tool_use_id":null,"session_id":"84f4a87c-b999-457a-947f-f1281f3fb1f8","uuid":"b1adab39-a5ec-4b49-9b1b-f8f42245700a","timestamp":"2026-08-11T02:07:30.399Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jerodw/Work/AgenticProgramming/level-five/orchestration/story_coordinator.py","content":"def run_story(\n    story_id: str,\n    harness_root: Path,\n    target_root: Path,\n    runner=agent_runner.run_agent,\n    start_stage: str | None = None,\n) -> int:\n    \"\"\"Execute one story, from a fresh run or from where a run left off.\n\n    `start_stage` overrides where execution enters — the recorded stage on a\n    resume, the workflow's first stage on a fresh run. It is named\n    `start_stage` rather than `stage` because `stage` is the loop's name for\n    the stage being executed, and one name for two things is how this\n    repository has repeatedly confused itself.\n    \"\"\"\n    config = harness_config.load_config(target_root)\n    workflow = harness_config.load_workflow(harness_root, config.get(\"workflow\", \"story-workflow\"))\n    rules = harness_config.load_rules(harness_root)\n    stages = workflow[\"stages\"]\n    stage_names = [s[\"name\"] for s in stages]\n\n    # A stage the developer named overrides where execution enters, which is\n    # what makes a resume useful: an escalation caused by an amended story is\n    # re-entered at the implementer rather than at the verifier that recorded\n    # it. Refused above everything else, in the shape the other pre-flight\n    # refusals take — exit 1, one message, nothing created and no agent run.\n    if start_stage is not None and start_stage not in stage_names:\n        print(\n            f\"'{start_stage}' is not a stage the loaded workflow defines. \"\n            f\"{workflow['name']} defines: {', '.join(stage_names)}.\",\n            file=sys.stderr,\n        )\n        return 1\n\n    story_path = target_root / config.get(\"stories_dir\", \".harness/stories\") / f\"{story_id}.yaml\"\n    if not story_path.is_file():\n        print(f\"No story artifact at {story_path}. Run l5-plan first.\", file=sys.stderr)\n        return 1\n    story_text = story_path.read_text(encoding=\"utf-8\")\n\n    # Pre-flight: refuse a bad story before any run state exists, so a\n    # rejection leaves no run directory, no state.json, and no new branch.\n    # The schema ships with the harness code, so it is resolved by\n    # schema_validator relative to its own module, not from harness_root.\n    reading = read_story(story_text)\n    if reading.problems:\n        return refuse_bad_story(story_path, reading.problems)\n\n    # Conformance is one question, agreement with this workflow another. A\n    # stage exception is checked here rather than inside read_story so schema\n    # reading stays schema reading, and both refusals stay above run-directory\n    # creation.\n    exception_problems = stage_exception_problems(reading.parsed, stages)\n    if exception_problems:\n        return refuse_bad_story(story_path, exception_problems)\n\n    run_dir = target_root / config.get(\"runs_dir\", \".harness/runs\") / story_id\n    state = load_state(run_dir)\n\n    # Pre-flight: refuse a run onto a branch that already holds this story's\n    # finished work. `_checkout_story_branch` reuses an existing branch rather\n    # than resetting it, so deleting only the run directory puts the implementer\n    # in a repository where the story is already done, the tester finds the\n    # tests written and passing, the verifier verifies a tree that genuinely\n    # satisfies the story, and the run reports success having changed nothing.\n    #\n    # The evidence is deliberately a *finished run* — `_complete`'s own commit,\n    # recognized by its subject and marker — and not the existence of commits on\n    # the branch. Those are different statements, and only the first is what\n    # makes a re-run pointless: an escalation already leaves two commits, so an\n    # ahead-of-base test would refuse every escalated resume, and a later design\n    # that commits partial progress would have to unpick a check written that\n    # way. It is base-free for the same reason, so it still holds when the\n    # developer is standing on the branch a completed run left them on.\n    #\n    # A loaded state recording `completed` keeps its own refusal below: that one\n    # has the run directory to point at and says more.\n    if not (state and state.status == \"completed\"):\n        branch = state.branch if state else story_branch(config, story_id)\n        finished = completion_commits(target_root, branch, story_id)\n        if finished:\n            return _refuse_finished_branch(branch, run_dir, finished)\n\n    # Pre-flight: a run commits the tree it ends on, so it has to start from a\n    # tree it can account for. Which runs this applies to is decided by the\n    # state the run is *starting from*, which is already loaded above for the\n    # resume decision. No state is a fresh run; an escalated state is a resume\n    # of a run that left the tree clean when it escalated, so anything\n    # uncommitted now is the developer's own fix and committing it deliberately\n    # is what this check is for. A `running` state is the one exclusion, and it\n    # is not an exception to the rule so much as a different tree: nothing\n    # commits when a process dies, so that working tree holds the run's own\n    # unfinished work and refusing it would refuse the run its own state.\n    #\n    # It sits above the run-directory creation and the branch checkout, so a\n    # refusal leaves no run directory, no state.json, no log, no new branch,\n    # and invokes no agent. There is deliberately no flag, environment variable\n    # or configuration key that skips it: a bypass on a correctness guard\n    # becomes the default invocation.\n    if state is None or state.status == \"escalated\":\n        dirty = dirty_paths(target_root)\n        if dirty:\n            return _refuse_dirty_tree(target_root, dirty)\n\n    run_dir.mkdir(parents=True, exist_ok=True)\n    (run_dir / \"verification\").mkdir(exist_ok=True)\n    log_path = target_root / config.get(\"logs_dir\", \".harness/logs\") / f\"{story_id}.log\"\n\n    if state and state.status == \"completed\":\n        # Name the branch as well as the run directory. _checkout_story_branch\n        # reuses an existing branch rather than resetting it, so deleting only\n        # the run directory re-runs the story on top of the finished work — the\n        # implementer opens a repository where the story is already done, and\n        # the run reports success having changed nothing. This guard is about\n        # finished work; an escalated run resumes below, because its work is\n        # not finished and its evidence is what the resume exists to keep.\n        print(\n            f\"{story_id} already ended with status '{state.status}'. \"\n            f\"Inspect {run_dir} to review it.\\n\"\n            f\"To run the story again, delete {run_dir} *and* reset branch \"\n            f\"{state.branch}, which still holds the finished work. Archive both \"\n            f\"first if the run is worth keeping — {run_dir} is gitignored.\",\n            file=sys.stderr,\n        )\n        return 1\n    if state:\n        # A resume, of a crashed run or an escalated one. Chapter 18 treats\n        # the two identically and so does this: restore nothing, because the\n        # artifacts and the state are already here, and continue at the\n        # recorded stage. Nothing is reinitialized — retry_count and\n        # verification_iterations key the rendered prompt and verification\n        # iteration filenames, so resetting them would overwrite the evidence\n        # of the attempt being resumed.\n        if state.status == \"escalated\":\n            # Resuming is inferred from the recorded status and from nothing\n            # else. What the guard adds is a refusal in the one case where a\n            # resume is knowably pointless: the story, the tree and the harness\n            # are all establishably what they were when the run escalated.\n            evidence = unchanged_since_escalation(\n                state, story_text, target_root, harness_root\n            )\n            if evidence:\n                print(\n                    _resume_refusal(story_path, run_dir, state, evidence),\n                    file=sys.stderr,\n                )\n                return 1\n        if start_stage:\n            state.current_stage = start_stage\n        if state.status == \"escalated\":\n            # The interrupted attempt is archived before the resumed stage\n            # runs, under the attempt number it was written with. Refuse rather\n            # than overwrite: the archive is the evidence a resume exists to\n            # preserve, and story-010 recorded exactly this case as open.\n            attempt = state.retry_count + 1\n            destination = attempt_dir(run_dir, attempt)\n            if destination.exists():\n                print(\n                    f\"{destination} already holds an archived attempt, and \"\n                    f\"resuming {story_id} would write attempt {attempt} over \"\n                    f\"it. Move or remove it if that attempt is not worth \"\n                    f\"keeping, then run the story again.\",\n                    file=sys.stderr,\n                )\n                return 1\n            archive_attempt(\n                run_dir, interrupted_attempt_artifacts(stages, attempt), attempt\n            )\n            state.status = \"running\"\n            save_state(run_dir, state)\n        append_event(\n            run_dir,\n            f\"resumed at stage {state.current_stage}\",\n            kind=\"resumed\",\n            stage=state.current_stage,\n        )\n    else:\n        state = RunState(\n            story_id=story_id,\n            branch=story_branch(config, story_id),\n            current_stage=start_stage or stage_names[0],\n            # Recorded from the same text read_story was given, so the digest\n            # and the run's one reading describe one artifact.\n            story_digest=story_digest(story_text),\n        )\n        save_state(run_dir, state)\n        append_event(\n            run_dir, f\"workflow started for {story_id}\", kind=\"workflow-started\"\n        )\n\n    _checkout_story_branch(target_root, state.branch)\n\n    # Stage timing: started where the stage-started event is appended, read at\n    # whichever event ends the stage, so a completed stage carries an elapsed\n    # duration the log only made derivable.\n    stage_started_at: float | None = None\n\n    def elapsed() -> float | None:\n        if stage_started_at is None:\n            return None\n        return round(time.monotonic() - stage_started_at, 3)\n\n    index = stage_names.index(state.current_stage)\n    while index < len(stages):\n        stage = stages[index]\n        name = stage[\"name\"]\n        state.current_stage = name\n        save_state(run_dir, state)\n        stage_started_at = time.monotonic()\n        append_event(run_dir, f\"{name} stage started\", kind=\"stage-started\", stage=name)\n\n        context = context_assembler.build_context(\n            story_text=story_text,\n            story=reading.parsed,\n            run_dir=run_dir,\n            target_root=target_root,\n            harness_root=harness_root,\n            config=config,\n            rules=rules,\n            retry_count=state.retry_count,\n        )\n        template = context_assembler.load_template(harness_root, stage[\"prompt\"])\n        prompt = context_assembler.render(template, context)\n        attempt = state.retry_count + 1\n        (run_dir / f\"prompt-{name}-attempt-{attempt}.md\").write_text(prompt, encoding=\"utf-8\")\n\n        # What this stage's artifacts looked like before it ran. One snapshot,\n        # covering the conditional artifacts and the required ones together,\n        # feeding one comparison function. The conditional readers ask which\n        # of them this attempt wrote — nothing clears the retry guidance\n        # between attempts — and the required reader below asks the same\n        # question of the outputs, because a retry that leaves one untouched\n        # satisfies a presence check with a superseded attempt's file.\n        # artifacts_written_since narrows by the names its caller passes, so\n        # widening what is covered here changes neither conditional reader.\n        conditional = conditional_artifacts(stage)\n        required = required_artifacts(stage)\n        artifacts_before = artifact_signatures(run_dir, conditional + required)\n\n        # What the tree held under this stage's governed prefixes before it\n        # ran, which is the baseline the revert check below decides against.\n        # Both names come off the stage's declaration, so removing that one\n        # key disables the capture and the check together. Captured over the\n        # declared prefixes rather than the grant-subtracted list: the\n        # enforced list is computed after the stage, and capturing a superset\n        # costs a few file copies while the restore set stays narrowed.\n        declaration = stage.get(\"revert_check\") or {}\n        baseline_dir = (\n            capture_stage_baseline(\n                run_dir,\n                target_root,\n                declaration[\"baseline\"],\n                name,\n                attempt,\n                stage.get(\"may_not_create\", []),\n            )\n            if declaration\n            else None\n        )\n\n        result = runner(\n            prompt,\n            stage=name,\n            cwd=target_root,\n            log_path=log_path,\n            permission_mode=config.get(\"permission_mode\", \"acceptEdits\"),\n            model=config.get(\"model\"),\n            allowed_tools=config.get(\"allowed_tools\"),\n        )\n        if not result.ok:\n            return _escalate(\n                run_dir,\n                state,\n                f\"{name} agent process failed\",\n                target_root=target_root,\n                harness_root=harness_root,\n                duration_seconds=elapsed(),\n            )\n\n        missing = [out for out in stage.get(\"outputs\", []) if not (run_dir / out).is_file()]","numLines":280,"startLine":1802,"totalLines":2367}}}
