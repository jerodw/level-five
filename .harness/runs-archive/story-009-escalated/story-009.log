oordinator\n    # builds, so the story contract reaches the planner as the schema file\n    # itself rather than as a copy of it that can drift.\n    template = context_assembler.load_template(HARNESS_ROOT, \"planner.md\")\n    planner_prompt = context_assembler.render(\n        template, context_assembler.schema_context(HARNESS_ROOT)\n    )\n    os.execvp(\n        \"claude\",\n        [\n            \"claude\",\n            \"--permission-mode\",\n            \"acceptEdits\",\n            \"--append-system-prompt\",\n            planner_prompt,\n            f\"Story request: {request}\",\n        ],\n    )\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[{"oldStart":4,"oldLines":7,"newStart":4,"newLines":8,"lines":[" Usage: l5-plan \"<story request>\""," Starts an interactive Claude Code session carrying the planner prompt."," The planner interviews you, iterates on the plan, and writes the approved","-story artifact to .harness/stories/.","+story artifact to .harness/stories/. The target repository is found by","+walking up from the current directory to the nearest .harness/config.yaml."," \"\"\""," import os"," import sys"]},{"oldStart":14,"oldLines":6,"newStart":15,"newLines":7,"lines":[" sys.path.insert(0, str(HARNESS_ROOT / \"orchestration\"))"," "," import context_assembler  # noqa: E402","+import harness_config  # noqa: E402"," "," "," def main() -> None:"]},{"oldStart":21,"oldLines":13,"newStart":23,"newLines":18,"lines":["         sys.exit(__doc__.strip())","     request = \" \".join(sys.argv[1:])","     # The planner is not a workflow stage, so no coordinator renders its","-    # template. Render it here against the same schema context the coordinator","-    # builds, so the story contract reaches the planner as the schema file","-    # itself rather than as a copy of it that can drift.","+    # template. Render it here against the same context the coordinator","+    # builds, so the story contract and the workflow's own declarations",