{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P8T92UhHzFgkfWZTvTLhZw","type":"tool_result","content":"{\n  \"name\": \"story-workflow\",\n  \"stages\": [\n    {\n      \"name\": \"implementer\",\n      \"prompt\": \"implementer.md\",\n      \"outputs\": [\"changed-files.json\", \"implementation-summary.md\"],\n      \"changed_files\": \"changed-files.json\",\n      \"may_not_create\": [\"tests/\"],\n      \"schemas\": {\n        \"changed-files.json\": \"changed-files\"\n      }\n    },\n    {\n      \"name\": \"tester\",\n      \"prompt\": \"tester.md\",\n      \"outputs\": [\"test-results.json\", \"tester-changed-files.json\"],\n      \"changed_files\": \"tester-changed-files.json\",\n      \"schemas\": {\n        \"test-results.json\": \"test-results\",\n        \"tester-changed-files.json\": \"changed-files\"\n      }\n    },\n    {\n      \"name\": \"verifier\",\n      \"prompt\": \"verifier.md\",\n      \"outputs\": [\"verification-result.json\"],\n      \"schemas\": {\n        \"verification-result.json\": \"verification-result\",\n        \"retry-guidance.json\": \"retry-guidance\"\n      },\n      \"on_failure\": {\n        \"retry_stage\": \"implementer\",\n        \"max_retries\": 2\n      }\n    },\n    {\n      \"name\": \"documenter\",\n      \"prompt\": \"documenter.md\",\n      \"outputs\": [\"documentation-report.md\"]\n    }\n  ],\n  \"escalation_rules\": {\n    \"max_retries_exceeded\": { \"action\": \"escalate\" }\n  }\n}\n{\n  \"max_retries\": 2,\n  \"require_verifier_pass\": true,\n  \"blocked_paths\": [\n    \".git/\",\n    \".harness/runs/\",\n    \"rules/\"\n  ]\n}\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nHARNESS_ROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(HARNESS_ROOT / \"orchestration\"))\n\nSTORY = \"\"\"\\\nstory:\n  id: story-001\n  title: Sample story for coordinator tests\n  description: |\n    A stand-in story used to exercise the workflow determi