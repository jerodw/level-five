{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016pVoiX2YjqsF4QjkeQDYbf","type":"tool_result","content":"1\t\"\"\"Assemble stage context and inject it into prompt templates.\n2\t\n3\tThe coordinator selects what each stage sees and delivers it by\n4\tinjection: artifact content is substituted into {{placeholder}} fields in\n5\ta fixed template. Optional placeholders with nothing to inject render as\n6\tNone so the prompt stays coherent. Source code is never injected; agents\n7\tread it by reference because the coordinator cannot enumerate it in\n8\tadvance.\n9\t\"\"\"\n10\tfrom __future__ import annotations\n11\t\n12\timport json\n13\timport re\n14\tfrom pathlib import Path\n15\t\n16\tPLACEHOLDER = re.compile(r\"\\{\\{([a-z_]+)\\}\\}\")\n17\t\n18\t\n19\tdef render(template: str, context: dict[str, str | None]) -> str:\n20\t    def substitute(match: re.Match[str]) -> str:\n21\t        value = context.get(match.group(1))\n22\t        return value if value else \"None\"\n23\t\n24\t    return PLACEHOLDER.sub(substitute, template)\n25\t\n26\t\n27\tdef load_template(harness_root: Path, prompt_file: str) -> str:\n28\t    return (harness_root / \"prompts\" / prompt_file).read_text(encoding=\"utf-8\")\n29\t\n30\t\n31\tdef schema_context(harness_root: Path) -> dict[str, str]:\n32\t    \"\"\"Map every artifact schema to its injectable placeholder name.\n33\t\n34\t    Artifact schemas are injected rather than restated inline in prompts, so\n35\t    the definition an agent is asked to satisfy is the same file the\n36\t    coordinator enforces. schemas/verification-result.schema.json becomes\n37\t    {{verification_result_schema}}. A new schema file becomes an injectable\n38\t    placeholder with no code change.\n39\t\n40\t    This is the one place the glob lives: build_context calls it for workflow\n41\t    stages, and l5-plan calls it for the planner template, which no\n42\t    coordinator renders.\n43\t    \"\"\"\n44\t    context: dict[str, str] = {}\n45\t    for schema_path in sorted((harness_root / \"schemas\").glob(\"*.schema.json\")):\n46\t        stem = schema_path.name[: -len(\".schema.json\")]\n47\t        context[stem.replace(\"-\", \"_\") + \"_schema\"] = schema_path.read_text(\n48\t            encoding=\"utf-8\"\n49\t        )\n50\t    return context\n51\t\n52\t\n53\tdef _read(path: Path) -> str | None:\n54\t    return path.read_text(encoding=\"utf-8\") if path.is_file() else None\n55\t\n56\t\n57\tdef _read_files(root: Path, paths: list[str]) -> str | None:\n58\t    sections = []\n59\t    for rel in paths:\n60\t        text = _read(root / rel)\n61\t        if text:\n62\t            sections.append(f\"--- {rel} ---\\n{text}\")\n63\t    return \"\\n\".join(sections) if sections else None\n64\t\n65\t\n66\tdef _dashed_lines(items: object) -> str | None:\n67\t    \"\"\"Render a parsed list of criteria as one dash-prefixed line each.\n68\t\n69\t    The list comes from the parse, so each item is already one whole\n70\t    criterion: no YAML indentation, no quoting, no hand-wrapping. An absent\n71\t    or empty list renders as None, the optional-placeholder convention.\n72\t    \"\"\"\n73\t    if not items:\n74\t        return None\n75\t    return \"\\n\".join(f\"- {item}\" for item in items)\n76\t\n77\t\n78\tdef _exception_lines(exceptions: object) -> str | None:\n79\t    \"\"\"Render the story's stage exceptions, one dash-prefixed line each.\n80\t\n81\t    The reason travels with the grant: a stage told a rule is lifted should\n82\t    also be told why, so it can tell whether its own work is the case the\n83\t    story had in mind. Absent or empty renders as None.\n84\t    \"\"\"\n85\t    if not exceptions:\n86\t        return None\n87\t    return \"\\n\".join(\n88\t        f\"- {item['stage']} may create {item['create']}: {item['reason']}\"\n89\t        for item in exceptions\n90\t    )\n91\t\n92\t\n93\tdef latest_verifier_finding(run_dir: Path) -> str | None:\n94\t    iterations = sorted((run_dir / \"verification\").glob(\"iteration-*.json\"))\n95\t    return _read(iterations[-1]) if iterations else None\n96\t\n97\t\n98\tdef build_context(\n99\t    *,\n100\t    story_text: str,\n101\t    story: dict,\n102\t    run_dir: Path,\n103\t    target_root: Path,\n104\t    harness_root: Path,\n105\t    config: dict,\n106\t    rules: dict,\n107\t    retry_count: int,\n108\t) -> dict[str, str | None]:\n109\t    standards_dir = target_root / config.get(\"standards_dir\", \".harness/standards\")\n110\t    standards = _read_files(\n111\t        standards_dir, sorted(p.name for p in standards_dir.glob(\"*.md\"))\n112\t    ) if standards_dir.is_dir() else None\n113\t    doc_paths = config.get(\"architecture_docs\", [])\n114\t\n115\t    retry_state = None\n116\t    if retry_count > 0:\n117\t        retry_state = json.dumps(\n118\t            {\"retry_iteration\": retry_count, \"max_retries\": rules[\"max_retries\"]},\n119\t            indent=2,\n120\t        )\n121\t\n122\t    # {{story}} stays the raw artifact, byte-identical to the file on disk, so\n123\t    # agents read the story as authored. Every *structural* value is taken from\n124\t    # the parse instead, so nothing reads the artifact a second way.\n125\t    context: dict[str, str | None] = {\n126\t        \"story\": story_text,\n127\t        \"acceptance_criteria\": _dashed_lines(story.get(\"acceptance_criteria\")),\n128\t        \"stage_exceptions\": _exception_lines(story.get(\"stage_exceptions\")),\n129\t        \"blocked_paths\": \"\\n\".join(f\"- {p}\" for p in rules.get(\"blocked_paths\", [])),\n130\t        \"test_command\": config.get(\"test_command\"),\n131\t        \"repository_standards\": standards,\n132\t        \"architecture_docs\": _read_files(target_root, doc_paths),\n133\t        \"architecture_doc_paths\": \"\\n\".join(f\"- {p}\" for p in doc_paths) or None,\n134\t        \"run_dir\": str(run_dir),\n135\t        \"changed_files\": _read(run_dir / \"changed-files.json\"),\n136\t        \"tester_changed_files\": _read(run_dir / \"tester-changed-files.json\"),\n137\t        \"implementation_summary\": _read(run_dir / \"implementation-summary.md\"),\n138\t        \"test_results\": _read(run_dir / \"test-results.json\"),\n139\t        \"verification_result\": _read(run_dir / \"verification-result.json\"),\n140\t        \"latest_verifier_finding\": latest_verifier_finding(run_dir),\n141\t        \"retry_guidance\": _read(run_dir / \"retry-guidance.json\"),\n142\t        \"retry_state\": retry_state,\n143\t        \"testing_standards\": _read(standards_dir / \"testing.md\"),\n144\t    }\n145\t\n146\t    context.update(schema_context(harness_root))\n147\t\n148\t    # Two-pass render: resolve the shared harness-layer partial (including its\n149\t    # own {{blocked_paths}} placeholder) against the assembled context before\n150\t    # injecting it, because render() is single-pass and does not re-scan\n151\t    # substituted text. Absent partial leaves harness_layer unset -> None.\n152\t    harness_layer_path = harness_root / \"prompts\" / \"harness-layer.md\"\n153\t    if harness_layer_path.is_file():\n154\t        partial = load_template(harness_root, \"harness-layer.md\")\n155\t        context[\"harness_layer\"] = render(partial, context)\n156\t\n157\t    return context\n158\t"}]},"parent_tool_use_id":null,"session_id":"6c3fc9de-acc0-4d44-bf99-2824655b2225","uuid":"8090a881-240d-48a1-814c-15fd9831faad","timestamp":"2026-08-07T01:45:24.003Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jerodw/Work/AgenticProgramming/level-five/orchestration/context_assembler.py","content":"\"\"\"Assemble stage context and inject it into prompt templates.\n\nThe coordinator selects what each stage sees and delivers it by\ninjection: artifact content is substituted into {{placeholder}} fields in\na fixed template. Optional placeholders with nothing to inject render as\nNone so the prompt stays coherent. Source code is never injected; agents\nread it by reference because the coordinator cannot enumerate it in\nadvance.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport re\nfrom pathlib import Path\n\nPLACEHOLDER = re.compile(r\"\\{\\{([a-z_]+)\\}\\}\")\n\n\ndef render(template: str, context: dict[str, str | None]) -> str:\n    def substitute(match: re.Match[str]) -> str:\n        value = context.get(match.group(1))\n        return value if value else \"None\"\n\n    return PLACEHOLDER.sub(substitute, template)\n\n\ndef load_template(harness_root: Path, prompt_file: str) -> str:\n    return (harness_root / \"prompts\" / prompt_file).read_text(encoding=\"utf-8\")\n\n\ndef schema_context(harness_root: Path) -> dict[str, str]:\n    \"\"\"Map every artifact schema to its injectable placeholder name.\n\n    Artifact schemas are injected rather than restated inline in prompts, so\n    the definition an agent is asked to satisfy is the same file the\n    coordinator enforces. schemas/verification-result.schema.json becomes\n    {{verification_result_schema}}. A new schema file becomes an injectable\n    placeholder with no code change.\n\n    This is the one place the glob lives: build_context calls it for workflow\n    stages, and l5-plan calls it for the planner template, which no\n    coordinator renders.\n    \"\"\"\n    context: dict[str, str] = {}\n    for schema_path in sorted((harness_root / \"schemas\").glob(\"*.schema.json\")):\n        stem = schema_path.name[: -len(\".schema.json\")]\n        context[stem.replace(\"-\", \"_\") + \"_schema\"] = schema_path.read_text(\n            encoding=\"utf-8\"\n        )\n    return context\n\n\ndef _read(path: Path) -> str | None:\n    return path.read_text(encoding=\"utf-8\") if path.is_file() else None\n\n\ndef _read_files(root: Path, paths: list[str]) -> str | None:\n    sections = []\n    for rel in paths:\n        text = _read(root / rel)\n        if text:\n            sections.append(f\"--- {rel} ---\\n{text}\")\n    return \"\\n\".join(sections) if sections else None\n\n\ndef _dashed_lines(items: object) -> str | None:\n    \"\"\"Render a parsed list of criteria as one dash-prefixed line each.\n\n    The list comes from the parse, so each item is already one whole\n    criterion: no YAML indentation, no quoting, no hand-wrapping. An absent\n    or empty list renders as None, the optional-placeholder convention.\n    \"\"\"\n    if not items:\n        return None\n    return \"\\n\".join(f\"- {item}\" for item in items)\n\n\ndef _exception_lines(exceptions: object) -> str | None:\n    \"\"\"Render the story's stage exceptions, one dash-prefixed line each.\n\n    The reason travels with the grant: a stage told a rule is lifted should\n    also be told why, so it can tell whether its own work is the case the\n    story had in mind. Absent or empty renders as None.\n    \"\"\"\n    if not exceptions:\n        return None\n    return \"\\n\".join(\n        f\"- {item['stage']} may create {item['create']}: {item['reason']}\"\n        for item in exceptions\n    )\n\n\ndef latest_verifier_finding(run_dir: Path) -> str | None:\n    iterations = sorted((run_dir / \"verification\").glob(\"iteration-*.json\"))\n    return _read(iterations[-1]) if iterations else None\n\n\ndef build_context(\n    *,\n    story_text: str,\n    story: dict,\n    run_dir: Path,\n    target_root: Path,\n    harness_root: Path,\n    config: dict,\n    rules: dict,\n    retry_count: int,\n) -> dict[str, str | None]:\n    standards_dir = target_root / config.get(\"standards_dir\", \".harness/standards\")\n    standards = _read_files(\n        standards_dir, sorted(p.name for p in standards_dir.glob(\"*.md\"))\n    ) if standards_dir.is_dir() else None\n    doc_paths = config.get(\"architecture_docs\", [])\n\n    retry_state = None\n    if retry_count > 0:\n        retry_state = json.dumps(\n            {\"retry_iteration\": retry_count, \"max_retries\": rules[\"max_retries\"]},\n            indent=2,\n        )\n\n    # {{story}} stays the raw artifact, byte-identical to the file on disk, so\n    # agents read the story as authored. Every *structural* value is taken from\n    # the parse instead, so nothing reads the artifact a second way.\n    context: dict[str, str | None] = {\n        \"story\": story_text,\n        \"acceptance_criteria\": _dashed_lines(story.get(\"acceptance_criteria\")),\n        \"stage_exceptions\": _exception_lines(story.get(\"stage_exceptions\")),\n        \"blocked_paths\": \"\\n\".join(f\"- {p}\" for p in rules.get(\"blocked_paths\", [])),\n        \"test_command\": config.get(\"test_command\"),\n        \"repository_standards\": standards,\n        \"architecture_docs\": _read_files(target_root, doc_paths),\n        \"architecture_doc_paths\": \"\\n\".join(f\"- {p}\" for p in doc_paths) or None,\n        \"run_dir\": str(run_dir),\n        \"changed_files\": _read(run_dir / \"changed-files.json\"),\n        \"tester_changed_files\": _read(run_dir / \"tester-changed-files.json\"),\n        \"implementation_summary\": _read(run_dir / \"implementation-summary.md\"),\n        \"test_results\": _read(run_dir / \"test-results.json\"),\n        \"verification_result\": _read(run_dir / \"verification-result.json\"),\n        \"latest_verifier_finding\": latest_verifier_finding(run_dir),\n        \"retry_guidance\": _read(run_dir / \"retry-guidance.json\"),\n        \"retry_state\": retry_state,\n        \"testing_standards\": _read(standards_dir / \"testing.md\"),\n    }\n\n    context.update(schema_context(harness_root))\n\n    # Two-pass render: resolve the shared harness-layer partial (including its\n    # own {{blocked_paths}} placeholder) against the assembled context before\n    # injecting it, because render() is single-pass and does not re-scan\n    # substituted text. Absent partial leaves harness_layer unset -> None.\n    harness_layer_path = harness_root / \"prompts\" / \"harness-layer.md\"\n    if harness_layer_path.is_file():\n        partial = load_template(harness_root, \"harness-layer.md\")\n        context[\"harness_layer\"] = render(partial, context)\n\n    return context\n","numLines":158,"startLine":1,"totalLines":158}}}
