{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0156nkuCubH8uKuYm81AMeK9","type":"tool_result","content":"1\t\"\"\"Assemble stage context and inject it into prompt templates.\n2\t\n3\tThe coordinator selects what each stage sees and delivers it by\n4\tinjection: artifact content is substituted into {{placeholder}} fields in\n5\ta fixed template. Optional placeholders with nothing to inject render as\n6\tNone so the prompt stays coherent. Source code is never injected; agents\n7\tread it by reference because the coordinator cannot enumerate it in\n8\tadvance.\n9\t\"\"\"\n10\tfrom __future__ import annotations\n11\t\n12\timport json\n13\timport re\n14\tfrom pathlib import Path\n15\t\n16\tPLACEHOLDER = re.compile(r\"\\{\\{([a-z_]+)\\}\\}\")\n17\t\n18\t\n19\tdef render(template: str, context: dict[str, str | None]) -> str:\n20\t    def substitute(match: re.Match[str]) -> str:\n21\t        value = context.get(match.group(1))\n22\t        return value if value else \"None\"\n23\t\n24\t    return PLACEHOLDER.sub(substitute, template)\n25\t\n26\t\n27\tdef load_template(harness_root: Path, prompt_file: str) -> str:\n28\t    return (harness_root / \"prompts\" / prompt_file).read_text(encoding=\"utf-8\")\n29\t\n30\t\n31\tdef schema_context(harness_root: Path) -> dict[str, str]:\n32\t    \"\"\"Map every artifact schema to its injectable placeholder name.\n33\t\n34\t    Artifact schemas are injected rather than restated inline in prompts, so\n35\t    the definition an agent is asked to satisfy is the same file the\n36\t    coordinator enforces. schemas/verification-result.schema.json becomes\n37\t    {{verification_result_schema}}. A new schema file becomes an injectable\n38\t    placeholder with no code change.\n39\t\n40\t    This is the one place the glob lives: build_context calls it for workflow\n41\t    stages, and l5-plan calls it for the planner template, which no\n42\t    coordinator renders.\n43\t    \"\"\"\n44\t    context: dict[str, str] = {}\n45\t    for schema_path in sorted((harness_root / \"schemas\").glob(\"*.schema.json\")):\n46\t        stem = schema_path.name[: -len(\".schema.json\")]\n47\t        context[stem.replace(\"-\", \"_\") + \"_schema\"] = schema_path.read_text(\n48\t            encoding=\"utf-8\"\n49\t        )\n50\t    return context\n51\t\n52\t\n53\tdef workflow_context(\n54\t    workflow: dict, rules: dict\n55\t) -> dict[str, str | None]:\n56\t    \"\"\"Render the workflow's own declarations as injectable context.\n57\t\n58\t    A prompt that restates a workflow fact drifts from it silently. These\n59\t    are the facts a planner needs and cannot otherwise see: which stages\n60\t    the workflow defines, which of them are restricted from creating files\n61\t    under which prefixes, and the repository-wide blocked paths.\n62\t    \"\"\"\n63\t    stages = workflow.get(\"stages\", [])\n64\t    restrictions = [\n65\t        f\"{stage['name']} may not create anything under {prefix}\"\n66\t        for stage in stages\n67\t        for prefix in stage.get(\"may_not_create\", [])\n68\t    ]\n69\t    return {\n70\t        \"workflow_stages\": _dashed_lines([stage[\"name\"] for stage in stages]),\n71\t        \"stage_create_restrictions\": _dashed_lines(restrictions),\n72\t        \"blocked_paths\": _dashed_lines(rules.get(\"blocked_paths\", [])),\n73\t    }\n74\t\n75\t\n76\tdef _read(path: Path) -> str | None:\n77\t    return path.read_text(encoding=\"utf-8\") if path.is_file() else None\n78\t\n79\t\n80\tdef _read_files(root: Path, paths: list[str]) -> str | None:\n81\t    sections = []\n82\t    for rel in paths:\n83\t        text = _read(root / rel)\n84\t        if text:\n85\t            sections.append(f\"--- {rel} ---\\n{text}\")\n86\t    return \"\\n\".join(sections) if sections else None\n87\t\n88\t\n89\tdef _dashed_lines(items: object) -> str | None:\n90\t    \"\"\"Render a parsed list of criteria as one dash-prefixed line each.\n91\t\n92\t    The list comes from the parse, so each item is already one whole\n93\t    criterion: no YAML indentation, no quoting, no hand-wrapping. An absent\n94\t    or empty list renders as None, the optional-placeholder convention.\n95\t    \"\"\"\n96\t    if not items:\n97\t        return None\n98\t    return \"\\n\".join(f\"- {item}\" for item in items)\n99\t\n100\t\n101\tdef _exception_lines(exceptions: object) -> str | None:\n102\t    \"\"\"Render the story's stage exceptions, one dash-prefixed line each.\n103\t\n104\t    The reason travels with the grant: a stage told a rule is lifted should\n105\t    also be told why, so it can tell whether its own work is the case the\n106\t    story had in mind. Absent or empty renders as None.\n107\t    \"\"\"\n108\t    if not exceptions:\n109\t        return None\n110\t    return \"\\n\".join(\n111\t        f\"- {item['stage']} may create {item['create']}: {item['reason']}\"\n112\t        for item in exceptions\n113\t    )\n114\t\n115\t\n116\tdef latest_verifier_finding(run_dir: Path) -> str | None:\n117\t    iterations = sorted((run_dir / \"verification\").glob(\"iteration-*.json\"))\n118\t    return _read(iterations[-1]) if iterations else None\n119\t\n120\t\n121\tdef build_context(\n122\t    *,\n123\t    story_text: str,\n124\t    story: dict,\n125\t    run_dir: Path,\n126\t    target_root: Path,\n127\t    harness_root: Path,\n128\t    config: dict,\n129\t    rules: dict,\n130\t    retry_count: int,\n131\t) -> dict[str, str | None]:\n132\t    standards_dir = target_root / config.get(\"standards_dir\", \".harness/standards\")\n133\t    standards = _read_files(\n134\t        standards_dir, sorted(p.name for p in standards_dir.glob(\"*.md\"))\n135\t    ) if standards_dir.is_dir() else None\n136\t    doc_paths = config.get(\"architecture_docs\", [])\n137\t\n138\t    retry_state = None\n139\t    if retry_count > 0:\n140\t        retry_state = json.dumps(\n141\t            {\"retry_iteration\": retry_count, \"max_retries\": rules[\"max_retries\"]},\n142\t            indent=2,\n143\t        )\n144\t\n145\t    # {{story}} stays the raw artifact, byte-identical to the file on disk, so\n146\t    # agents read the story as authored. Every *structural* value is taken from\n147\t    # the parse instead, so nothing reads the artifact a second way.\n148\t    context: dict[str, str | None] = {\n149\t        \"story\": story_text,\n150\t        \"acceptance_criteria\": _dashed_lines(story.get(\"acceptance_criteria\")),\n151\t        \"stage_exceptions\": _exception_lines(story.get(\"stage_exceptions\")),\n152\t        \"blocked_paths\": _dashed_lines(rules.get(\"blocked_paths\", [])),\n153\t        \"test_command\": config.get(\"test_command\"),\n154\t        \"repository_standards\": standards,\n155\t        \"architecture_docs\": _read_files(target_root, doc_paths),\n156\t        \"architecture_doc_paths\": \"\\n\".join(f\"- {p}\" for p in doc_paths) or None,\n157\t        \"run_dir\": str(run_dir),\n158\t        \"changed_files\": _read(run_dir / \"changed-files.json\"),\n159\t        \"tester_changed_files\": _read(run_dir / \"tester-changed-files.json\"),\n160\t        \"implementation_summary\": _read(run_dir / \"implementation-summary.md\"),\n161\t        \"test_results\": _read(run_dir / \"test-results.json\"),\n162\t        \"verification_result\": _read(run_dir / \"verification-result.json\"),\n163\t        \"latest_verifier_finding\": latest_verifier_finding(run_dir),\n164\t        \"retry_guidance\": _read(run_dir / \"retry-guidance.json\"),\n165\t        \"retry_state\": retry_state,\n166\t        \"testing_standards\": _read(standards_dir / \"testing.md\"),\n167\t    }\n168\t\n169\t    context.update(schema_context(harness_root))\n170\t\n171\t    # Two-pass render: resolve the shared harness-layer partial (including its\n172\t    # own {{blocked_paths}} placeholder) against the assembled context before\n173\t    # injecting it, because render() is single-pass and does not re-scan\n174\t    # substituted text. Absent partial leaves harness_layer unset -> None.\n175\t    harness_layer_path = harness_root / \"prompts\" / \"harness-layer.md\"\n176\t    if harness_layer_path.is_file():\n177\t        partial = load_template(harness_root, \"harness-layer.md\")\n178\t        context[\"harness_layer\"] = render(partial, context)\n179\t\n180\t    return context\n181\t"}]},"parent_tool_use_id":null,"session_id":"303aa4ca-f162-4e54-bf71-9e3ef02d0938","uuid":"38a8c3f5-4322-4654-b491-d5b6139178ad","timestamp":"2026-08-07T01:49:27.129Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jerodw/Work/AgenticProgramming/level-five/orchestration/context_assembler.py","content":"\"\"\"Assemble stage context and inject it into prompt templates.\n\nThe coordinator selects what each stage sees and delivers it by\ninjection: artifact content is substituted into {{placeholder}} fields in\na fixed template. Optional placeholders with nothing to inject render as\nNone so the prompt stays coherent. Source code is never injected; agents\nread it by reference because the coordinator cannot enumerate it in\nadvance.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport re\nfrom pathlib import Path\n\nPLACEHOLDER = re.compile(r\"\\{\\{([a-z_]+)\\}\\}\")\n\n\ndef render(template: str, context: dict[str, str | None]) -> str:\n    def substitute(match: re.Match[str]) -> str:\n        value = context.get(match.group(1))\n        return value if value else \"None\"\n\n    return PLACEHOLDER.sub(substitute, template)\n\n\ndef load_template(harness_root: Path, prompt_file: str) -> str:\n    return (harness_root / \"prompts\" / prompt_file).read_text(encoding=\"utf-8\")\n\n\ndef schema_context(harness_root: Path) -> dict[str, str]:\n    \"\"\"Map every artifact schema to its injectable placeholder name.\n\n    Artifact schemas are injected rather than restated inline in prompts, so\n    the definition an agent is asked to satisfy is the same file the\n    coordinator enforces. schemas/verification-result.schema.json becomes\n    {{verification_result_schema}}. A new schema file becomes an injectable\n    placeholder with no code change.\n\n    This is the one place the glob lives: build_context calls it for workflow\n    stages, and l5-plan calls it for the planner template, which no\n    coordinator renders.\n    \"\"\"\n    context: dict[str, str] = {}\n    for schema_path in sorted((harness_root / \"schemas\").glob(\"*.schema.json\")):\n        stem = schema_path.name[: -len(\".schema.json\")]\n        context[stem.replace(\"-\", \"_\") + \"_schema\"] = schema_path.read_text(\n            encoding=\"utf-8\"\n        )\n    return context\n\n\ndef workflow_context(\n    workflow: dict, rules: dict\n) -> dict[str, str | None]:\n    \"\"\"Render the workflow's own declarations as injectable context.\n\n    A prompt that restates a workflow fact drifts from it silently. These\n    are the facts a planner needs and cannot otherwise see: which stages\n    the workflow defines, which of them are restricted from creating files\n    under which prefixes, and the repository-wide blocked paths.\n    \"\"\"\n    stages = workflow.get(\"stages\", [])\n    restrictions = [\n        f\"{stage['name']} may not create anything under {prefix}\"\n        for stage in stages\n        for prefix in stage.get(\"may_not_create\", [])\n    ]\n    return {\n        \"workflow_stages\": _dashed_lines([stage[\"name\"] for stage in stages]),\n        \"stage_create_restrictions\": _dashed_lines(restrictions),\n        \"blocked_paths\": _dashed_lines(rules.get(\"blocked_paths\", [])),\n    }\n\n\ndef _read(path: Path) -> str | None:\n    return path.read_text(encoding=\"utf-8\") if path.is_file() else None\n\n\ndef _read_files(root: Path, paths: list[str]) -> str | None:\n    sections = []\n    for rel in paths:\n        text = _read(root / rel)\n        if text:\n            sections.append(f\"--- {rel} ---\\n{text}\")\n    return \"\\n\".join(sections) if sections else None\n\n\ndef _dashed_lines(items: object) -> str | None:\n    \"\"\"Render a parsed list of criteria as one dash-prefixed line each.\n\n    The list comes from the parse, so each item is already one whole\n    criterion: no YAML indentation, no quoting, no hand-wrapping. An absent\n    or empty list renders as None, the optional-placeholder convention.\n    \"\"\"\n    if not items:\n        return None\n    return \"\\n\".join(f\"- {item}\" for item in items)\n\n\ndef _exception_lines(exceptions: object) -> str | None:\n    \"\"\"Render the story's stage exceptions, one dash-prefixed line each.\n\n    The reason travels with the grant: a stage told a rule is lifted should\n    also be told why, so it can tell whether its own work is the case the\n    story had in mind. Absent or empty renders as None.\n    \"\"\"\n    if not exceptions:\n        return None\n    return \"\\n\".join(\n        f\"- {item['stage']} may create {item['create']}: {item['reason']}\"\n        for item in exceptions\n    )\n\n\ndef latest_verifier_finding(run_dir: Path) -> str | None:\n    iterations = sorted((run_dir / \"verification\").glob(\"iteration-*.json\"))\n    return _read(iterations[-1]) if iterations else None\n\n\ndef build_context(\n    *,\n    story_text: str,\n    story: dict,\n    run_dir: Path,\n    target_root: Path,\n    harness_root: Path,\n    config: dict,\n    rules: dict,\n    retry_count: int,\n) -> dict[str, str | None]:\n    standards_dir = target_root / config.get(\"standards_dir\", \".harness/standards\")\n    standards = _read_files(\n        standards_dir, sorted(p.name for p in standards_dir.glob(\"*.md\"))\n    ) if standards_dir.is_dir() else None\n    doc_paths = config.get(\"architecture_docs\", [])\n\n    retry_state = None\n    if retry_count > 0:\n        retry_state = json.dumps(\n            {\"retry_iteration\": retry_count, \"max_retries\": rules[\"max_retries\"]},\n            indent=2,\n        )\n\n    # {{story}} stays the raw artifact, byte-identical to the file on disk, so\n    # agents read the story as authored. Every *structural* value is taken from\n    # the parse instead, so nothing reads the artifact a second way.\n    context: dict[str, str | None] = {\n        \"story\": story_text,\n        \"acceptance_criteria\": _dashed_lines(story.get(\"acceptance_criteria\")),\n        \"stage_exceptions\": _exception_lines(story.get(\"stage_exceptions\")),\n        \"blocked_paths\": _dashed_lines(rules.get(\"blocked_paths\", [])),\n        \"test_command\": config.get(\"test_command\"),\n        \"repository_standards\": standards,\n        \"architecture_docs\": _read_files(target_root, doc_paths),\n        \"architecture_doc_paths\": \"\\n\".join(f\"- {p}\" for p in doc_paths) or None,\n        \"run_dir\": str(run_dir),\n        \"changed_files\": _read(run_dir / \"changed-files.json\"),\n        \"tester_changed_files\": _read(run_dir / \"tester-changed-files.json\"),\n        \"implementation_summary\": _read(run_dir / \"implementation-summary.md\"),\n        \"test_results\": _read(run_dir / \"test-results.json\"),\n        \"verification_result\": _read(run_dir / \"verification-result.json\"),\n        \"latest_verifier_finding\": latest_verifier_finding(run_dir),\n        \"retry_guidance\": _read(run_dir / \"retry-guidance.json\"),\n        \"retry_state\": retry_state,\n        \"testing_standards\": _read(standards_dir / \"testing.md\"),\n    }\n\n    context.update(schema_context(harness_root))\n\n    # Two-pass render: resolve the shared harness-layer partial (including its\n    # own {{blocked_paths}} placeholder) against the assembled context before\n    # injecting it, because render() is single-pass and does not re-scan\n    # substituted text. Absent partial leaves harness_layer unset -> None.\n    harness_layer_path = harness_root / \"prompts\" / \"harness-layer.md\"\n    if harness_layer_path.is_file():\n        partial = load_template(harness_root, \"harness-layer.md\")\n        context[\"harness_layer\"] = render(partial, context)\n\n    return context\n","numLines":181,"startLine":1,"totalLines":181}}}
