{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F2duBZDapiE5dTxUyXgUu4","type":"tool_result","content":"1\t\"\"\"Independent validation for story-008: the planner's story contract is the\n2\tschema file, not a copy of it.\n3\t\n4\tWritten from the story's acceptance criteria rather than from the\n5\timplementation. The story exists because prose restating a schema drifts\n6\tfrom it silently, so these tests prefer observable behavior over source\n7\tinspection wherever behavior is available: what `scripts/l5-plan` actually\n8\thands to `claude --append-system-prompt` (captured by putting a fake\n9\t`claude` on PATH), and what `build_context` resolves for a workflow stage.\n10\t\n11\tTwo properties need a control rather than an assertion:\n12\t\n13\t- the required-field coverage of the rendered planner prompt must come from\n14\t  the injection. The control renders a copy of the template with\n15\t  `{{story_schema}}` removed and asserts the same coverage check fails.\n16\t- the \"no normative prose in planner.md\" check must be able to fail. The\n17\t  control feeds the detector the prose story-008 removed and asserts it is\n18\t  flagged.\n19\t\"\"\"\n20\timport json\n21\timport os\n22\timport re\n23\timport subprocess\n24\timport sys\n25\tfrom pathlib import Path\n26\t\n27\timport pytest\n28\t\n29\timport context_assembler\n30\t\n31\tREPO_ROOT = Path(__file__).resolve().parents[1]\n32\tORCHESTRATION = REPO_ROOT / \"orchestration\"\n33\tSCHEMAS_DIR = REPO_ROOT / \"schemas\"\n34\tPLANNER = REPO_ROOT / \"prompts\" / \"planner.md\"\n35\tSTORY_SCHEMA_PATH = SCHEMAS_DIR / \"story.schema.json\"\n36\t\n37\tPLACEHOLDER = re.compile(r\"\\{\\{[a-z_]+\\}\\}\")\n38\t\n39\t# Vocabulary that states a section or field is part of the contract. \"must\"\n40\t# is deliberately absent: the template legitimately points at the schema\n41\t# (\"the schema above says what must be present\") without restating it, and\n42\t# the story asks for the statements to move, not for the pointer to go.\n43\tNORMATIVE = re.compile(r\"\\b(required|optional|mandatory)\\b\", re.IGNORECASE)\n44\t\n45\t# The prose story-008 removed from planner.md, kept verbatim as the control\n46\t# for the detector below.\n47\tREMOVED_PROSE = \"\"\"\\\n48\tWrite the approved story exactly in this shape. The shape is a\n49\tcontract: the harness extracts acceptance_criteria by its top-level\n50\tkey and injects it into the verifier prompt, and l5-run refuses to\n51\texecute a story artifact that is missing any required top-level\n52\tsection.\n53\t\n54\tA story may also carry an optional top-level stage_exceptions section,\n55\tand most do not.\n56\t\"\"\"\n57\t\n58\t\n59\tdef planner_template() -> str:\n60\t    return PLANNER.read_text(encoding=\"utf-8\")\n61\t\n62\t\n63\tdef story_schema() -> dict:\n64\t    return json.loads(STORY_SCHEMA_PATH.read_text(encoding=\"utf-8\"))\n65\t\n66\t\n67\tdef schema_property_names(node: object, out: set[str] | None = None) -> set[str]:\n68\t    \"\"\"Every property name the schema defines, at any depth.\"\"\"\n69\t    names = set() if out is None else out\n70\t    if isinstance(node, dict):\n71\t        properties = node.get(\"properties\")\n72\t        if isinstance(properties, dict):\n73\t            names.update(properties)\n74\t        for value in node.values():\n75\t            schema_property_names(value, names)\n76\t    elif isinstance(node, list):\n77\t        for value in node:\n78\t            schema_property_names(value, names)\n79\t    return names\n80\t\n81\t\n82\tdef required_property_names(node: object, out: set[str] | None = None) -> set[str]:\n83\t    \"\"\"Every name appearing in a `required` list, at any depth.\"\"\"\n84\t    names = set() if out is None else out\n85\t    if isinstance(node, dict):\n86\t        required = node.get(\"required\")\n87\t        if isinstance(required, list):\n88\t            names.update(n for n in required if isinstance(n, str))\n89\t        for value in node.values():\n90\t            required_property_names(value, names)\n91\t    elif isinstance(node, list):\n92\t        for value in node:\n93\t            required_property_names(value, names)\n94\t    return names\n95\t\n96\t\n97\tdef normative_sentences(text: str) -> list[str]:\n98\t    \"\"\"Sentences that name a schema property AND state contract membership.\"\"\"\n99\t    names = schema_property_names(story_schema())\n100\t    flagged = []\n101\t    for sentence in re.split(r\"(?<=[.;])\\s+\", PLACEHOLDER.sub(\"\", text)):\n102\t        if not NORMATIVE.search(sentence):\n103\t            continue\n104\t        words = set(re.findall(r\"[a-z_]+\", sentence.lower()))\n105\t        if words & names:\n106\t            flagged.append(\" \".join(sentence.split()))\n107\t    return flagged\n108\t\n109\t\n110\tdef missing_required_names(rendered: str) -> set[str]:\n111\t    \"\"\"Required property names absent from the rendered prompt.\n112\t\n113\t    Looked for in their quoted JSON form, which only the injected schema\n114\t    supplies — the skeleton writes the story dialect, unquoted.\n115\t    \"\"\"\n116\t    return {\n117\t        name for name in required_property_names(story_schema())\n118\t        if f'\"{name}\"' not in rendered\n119\t    }\n120\t\n121\t\n122\tdef rendered_planner_prompt() -> str:\n123\t    return context_assembler.render(\n124\t        planner_template(), context_assembler.schema_context(REPO_ROOT)\n125\t    )\n126\t\n127\t\n128\t# --------------------------------------------------------------------------\n129\t# planner.md states nothing normative of its own\n130\t# --------------------------------------------------------------------------\n131\t\n132\t\n133\tdef test_the_planner_template_injects_the_story_schema():\n134\t    assert \"{{story_schema}}\" in planner_template()\n135\t\n136\t\n137\tdef test_the_planner_template_states_no_required_section_or_field_itself():\n138\t    assert normative_sentences(planner_template()) == []\n139\t\n140\t\n141\tdef test_the_detector_flags_the_prose_this_story_removed():\n142\t    \"\"\"Control: an empty result above must mean the prose is gone, not that\n143\t    the detector cannot see it.\"\"\"\n144\t    flagged = normative_sentences(REMOVED_PROSE)\n145\t    assert len(flagged) == 2\n146\t    assert any(\"required top-level\" in s for s in flagged)\n147\t    assert any(\"optional top-level stage_exceptions\" in s for s in flagged)\n148\t\n149\t\n150\tdef test_the_skeleton_survives_as_an_illustration():\n151\t    text = planner_template()\n152\t    assert \"story-NNN\" in text and \"acceptance_criteria:\" in text\n153\t    assert \"illustration\" in text\n154\t    # The word \"contract\" now points at the schema, not at the skeleton.\n155\t    assert re.search(r\"contract is schemas/story\\.schema\\.json\", text)\n156\t\n157\t\n158\tdef test_the_skeleton_names_no_field_the_schema_does_not_define():\n159\t    known = schema_property_names(story_schema())\n160\t    text = PLACEHOLDER.sub(\"\", planner_template())\n161\t    keys = {\n162\t        match.group(1)\n163\t        for match in re.finditer(r\"^\\t\\s*(?:- )?([a-z_]+):\", text, re.MULTILINE)\n164\t    }\n165\t    assert keys, \"no skeleton keys found — the skeleton is indented with tabs\"\n166\t    assert keys <= known, keys - known\n167\t\n168\t\n169\tdef test_the_stage_exceptions_ask_first_guidance_survives():\n170\t    text = planner_template()\n171\t    assert \"stage_exceptions\" in text\n172\t    assert \"without asking the developer first\" in text\n173\t\n174\t\n175\t# --------------------------------------------------------------------------\n176\t# The rendered prompt carries the schema\n177\t# --------------------------------------------------------------------------\n178\t\n179\t\n180\tdef test_the_rendered_prompt_carries_the_schema_file_verbatim():\n181\t    assert STORY_SCHEMA_PATH.read_text(encoding=\"utf-8\") in rendered_planner_prompt()\n182\t\n183\t\n184\tdef test_the_rendered_prompt_has_no_leftover_placeholder():\n185\t    assert PLACEHOLDER.search(rendered_planner_prompt()) is None\n186\t\n187\t\n188\tdef test_every_required_property_name_reaches_the_rendered_prompt():\n189\t    required = required_property_names(story_schema())\n190\t    assert {\n191\t        \"story\", \"tasks\", \"acceptance_criteria\", \"scope\",\n192\t        \"verification_requirements\", \"constraints\",\n193\t        \"id\", \"title\", \"description\", \"modify\", \"do_not_modify\",\n194\t        \"file\", \"reason\", \"stage\", \"create\",\n195\t    } <= required\n196\t    assert missing_required_names(rendered_planner_prompt()) == set()\n197\t\n198\t\n199\tdef test_the_coverage_comes_from_the_injection_and_not_from_leftover_prose():\n200\t    \"\"\"Negative control: strip the placeholder and the coverage collapses.\"\"\"\n201\t    stripped = planner_template().replace(\"{{story_schema}}\", \"\")\n202\t    rendered = context_assembler.render(\n203\t        stripped, context_assembler.schema_context(REPO_ROOT)\n204\t    )\n205\t    assert missing_required_names(rendered) == required_property_names(story_schema())\n206\t\n207\t\n208\t# --------------------------------------------------------------------------\n209\t# l5-plan renders the template and passes it through --append-system-prompt\n210\t# --------------------------------------------------------------------------\n211\t\n212\t\n213\t@pytest.fixture\n214\tdef captured_plan_argv(tmp_path: Path) -> list[str]:\n215\t    \"\"\"Run scripts/l5-plan with a fake `claude` on PATH and capture its argv.\"\"\"\n216\t    bin_dir = tmp_path / \"bin\"\n217\t    bin_dir.mkdir()\n218\t    argv_path = tmp_path / \"argv.json\"\n219\t    fake = bin_dir / \"claude\"\n220\t    fake.write_text(\n221\t        \"#!/usr/bin/env python3\\n\"\n222\t        \"import json, sys\\n\"\n223\t        f\"open({str(argv_path)!r}, 'w').write(json.dumps(sys.argv))\\n\",\n224\t        encoding=\"utf-8\",\n225\t    )\n226\t    fake.chmod(0o755)\n227\t    env = dict(os.environ, PATH=f\"{bin_dir}{os.pathsep}{os.environ['PATH']}\")\n228\t    result = subprocess.run(\n229\t        [sys.executable, str(REPO_ROOT / \"scripts\" / \"l5-plan\"), \"a story request\"],\n230\t        env=env, capture_output=True, text=True, cwd=tmp_path,\n231\t    )\n232\t    assert result.returncode == 0, result.stderr\n233\t    return json.loads(argv_path.read_text(encoding=\"utf-8\"))\n234\t\n235\t\n236\tdef test_l5_plan_starts_an_interactive_session_with_the_request(captured_plan_argv):\n237\t    assert Path(captured_plan_argv[0]).name == \"claude\"\n238\t    assert \"--append-system-prompt\" in captured_plan_argv\n239\t    assert captured_plan_argv[-1] == \"Story request: a story request\"\n240\t    assert \"--permission-mode\" in captured_plan_argv\n241\t\n242\t\n243\tdef test_l5_plan_passes_the_rendered_prompt_not_the_raw_template(captured_plan_argv):\n244\t    prompt = captured_plan_argv[captured_plan_argv.index(\"--append-system-prompt\") + 1]\n245\t    assert prompt != planner_template()\n246\t    assert PLACEHOLDER.search(prompt) is None\n247\t    assert STORY_SCHEMA_PATH.read_text(encoding=\"utf-8\") in prompt\n248\t    assert missing_required_names(prompt) == set()\n249\t\n250\t\n251\tdef test_l5_plan_needs_no_target_repository(captured_plan_argv):\n252\t    \"\"\"The fixture runs it from an empty tmp_path: the schema ships beside the\n253\t    harness code, so rendering does not depend on where it is invoked.\"\"\"\n254\t    assert \"--append-system-prompt\" in captured_plan_argv\n255\t\n256\t\n257\tdef test_l5_plan_adds_no_second_substitution_implementation():\n258\t    source = (REPO_ROOT / \"scripts\" / \"l5-plan\").read_text(encoding=\"utf-8\")\n259\t    assert \"context_assembler.render\" in source\n260\t    assert \"context_assembler.schema_context\" in source\n261\t    assert \"re.sub\" not in source and \".replace(\" not in source\n262\t\n263\t\n264\t# --------------------------------------------------------------------------\n265\t# One schema-context implementation, and build_context unchanged\n266\t# --------------------------------------------------------------------------\n267\t\n268\t\n269\tdef test_the_schemas_glob_appears_once_in_context_assembler():\n270\t    source = (ORCHESTRATION / \"context_assembler.py\").read_text(encoding=\"utf-8\")\n271\t    assert source.count('glob(\"*.schema.json\")') == 1\n272\t    assert source.count(\"schemas\") >= 1\n273\t\n274\t\n275\tdef test_build_context_uses_the_same_schema_context_function():\n276\t    source = (ORCHESTRATION / \"context_assembler.py\").read_text(encoding=\"utf-8\")\n277\t    body = source.split(\"def build_context\")[1]\n278\t    assert \"schema_context(harness_root)\" in body\n279\t\n280\t\n281\tdef test_schema_context_maps_every_schema_file_to_its_placeholder_name():\n282\t    context = context_assembler.schema_context(REPO_ROOT)\n283\t    expected = {\n284\t        path.name[: -len(\".schema.json\")].replace(\"-\", \"_\") + \"_schema\":\n285\t            path.read_text(encoding=\"utf-8\")\n286\t        for path in SCHEMAS_DIR.glob(\"*.schema.json\")\n287\t    }\n288\t    assert context == expected\n289\t    assert all(isinstance(value, str) for value in context.values())\n290\t\n291\t\n292\tdef test_build_context_still_resolves_every_stage_schema_placeholder(\n293\t    target_root, harness_root\n294\t):\n295\t    import harness_config\n296\t    import schema_validator\n297\t    import story_parser\n298\t\n299\t    run_dir = target_root / \".harness\" / \"runs\" / \"story-001\"\n300\t    run_dir.mkdir(parents=True, exist_ok=True)\n301\t    story_text = (target_root / \".harness\" / \"stories\" / \"story-001.yaml\").read_text()\n302\t    context = context_assembler.build_context(\n303\t        story_text=story_text,\n304\t        story=story_parser.parse(story_text, schema_validator.load_schema(\"story\")),\n305\t        run_dir=run_dir,\n306\t        target_root=target_root,\n307\t        harness_root=harness_root,\n308\t        config=harness_config.load_config(target_root),\n309\t        rules={\"blocked_paths\": [\".git/\"], \"max_retries\": 3},\n310\t        retry_count=0,\n311\t    )\n312\t    for path in SCHEMAS_DIR.glob(\"*.schema.json\"):\n313\t        key = path.name[: -len(\".schema.json\")].replace(\"-\", \"_\") + \"_schema\"\n314\t        assert context[key] == path.read_text(encoding=\"utf-8\"), key\n315\t\n316\t    for name in (\"implementer.md\", \"tester.md\", \"verifier.md\"):\n317\t        rendered = context_assembler.render(\n318\t            context_assembler.load_template(harness_root, name), context\n319\t        )\n320\t        assert PLACEHOLDER.search(rendered) is None, name\n321\t\n322\t\n323\t# --------------------------------------------------------------------------\n324\t# What this story leaves alone\n325\t# --------------------------------------------------------------------------\n326\t\n327\t\n328\tdef _unchanged_against_head(rel: str) -> bool:\n329\t    result = subprocess.run(\n330\t        [\"git\", \"diff\", \"HEAD\", \"--stat\", \"--\", rel],\n331\t        cwd=REPO_ROOT, capture_output=True, text=True, check=True,\n332\t    )\n333\t    return result.stdout.strip() == \"\"\n334\t\n335\t\n336\tdef test_l5_assist_is_unchanged():\n337\t    assert _unchanged_against_head(\"scripts/l5-assist\")\n338\t\n339\t\n340\tdef test_the_story_schema_is_unchanged():\n341\t    assert _unchanged_against_head(\"schemas/story.schema.json\")\n342\t\n343\t\n344\tdef test_no_committed_story_artifact_was_edited():\n345\t    assert _unchanged_against_head(\".harness/stories\")\n346\t\n347\t\n348\tdef test_every_committed_story_artifact_still_parses():\n349\t    import schema_validator\n350\t    import story_parser\n351\t\n352\t    stories = sorted((REPO_ROOT / \".harness\" / \"stories\").glob(\"*.yaml\"))\n353\t    assert stories\n354\t    schema = schema_validator.load_schema(\"story\")\n355\t    for path in stories:\n356\t        parsed = story_parser.parse(path.read_text(encoding=\"utf-8\"), schema)\n357\t        assert parsed[\"story\"][\"id\"], path.name\n358\t"}]},"parent_tool_use_id":null,"session_id":"303aa4ca-f162-4e54-bf71-9e3ef02d0938","uuid":"7f55d35d-9531-48be-a8f6-176c2c2b9955","timestamp":"2026-08-07T01:49:34.202Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jerodw/Work/AgenticProgramming/level-five/tests/test_story_008_validation.py","content":"\"\"\"Independent validation for story-008: the planner's story contract is the\nschema file, not a copy of it.\n\nWritten from the story's acceptance criteria rather than from the\nimplementation. The story exists because prose restating a schema drifts\nfrom it silently, so these tests prefer observable behavior over source\ninspection wherever behavior is available: what `scripts/l5-plan` actually\nhands to `claude --append-system-prompt` (captured by putting a fake\n`claude` on PATH), and what `build_context` resolves for a workflow stage.\n\nTwo properties need a control rather than an assertion:\n\n- the required-field coverage of the rendered planner prompt must come from\n  the injection. The control renders a copy of the template with\n  `{{story_schema}}` removed and asserts the same coverage check fails.\n- the \"no normative prose in planner.md\" check must be able to fail. The\n  control feeds the detector the prose story-008 removed and asserts it is\n  flagged.\n\"\"\"\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nimport context_assembler\n\nREPO_ROOT = Path(__file__).resolve().parents[1]\nORCHESTRATION = REPO_ROOT / \"orchestration\"\nSCHEMAS_DIR = REPO_ROOT / \"schemas\"\nPLANNER = REPO_ROOT / \"prompts\" / \"planner.md\"\nSTORY_SCHEMA_PATH = SCHEMAS_DIR / \"story.schema.json\"\n\nPLACEHOLDER = re.compile(r\"\\{\\{[a-z_]+\\}\\}\")\n\n# Vocabulary that states a section or field is part of the contract. \"must\"\n# is deliberately absent: the template legitimately points at the schema\n# (\"the schema above says what must be present\") without restating it, and\n# the story asks for the statements to move, not for the pointer to go.\nNORMATIVE = re.compile(r\"\\b(required|optional|mandatory)\\b\", re.IGNORECASE)\n\n# The prose story-008 removed from planner.md, kept verbatim as the control\n# for the detector below.\nREMOVED_PROSE = \"\"\"\\\nWrite the approved story exactly in this shape. The shape is a\ncontract: the harness extracts acceptance_criteria by its top-level\nkey and injects it into the verifier prompt, and l5-run refuses to\nexecute a story artifact that is missing any required top-level\nsection.\n\nA story may also carry an optional top-level stage_exceptions section,\nand most do not.\n\"\"\"\n\n\ndef planner_template() -> str:\n    return PLANNER.read_text(encoding=\"utf-8\")\n\n\ndef story_schema() -> dict:\n    return json.loads(STORY_SCHEMA_PATH.read_text(encoding=\"utf-8\"))\n\n\ndef schema_property_names(node: object, out: set[str] | None = None) -> set[str]:\n    \"\"\"Every property name the schema defines, at any depth.\"\"\"\n    names = set() if out is None else out\n    if isinstance(node, dict):\n        properties = node.get(\"properties\")\n        if isinstance(properties, dict):\n            names.update(properties)\n        for value in node.values():\n            schema_property_names(value, names)\n    elif isinstance(node, list):\n        for value in node:\n            schema_property_names(value, names)\n    return names\n\n\ndef required_property_names(node: object, out: set[str] | None = None) -> set[str]:\n    \"\"\"Every name appearing in a `required` list, at any depth.\"\"\"\n    names = set() if out is None else out\n    if isinstance(node, dict):\n        required = node.get(\"required\")\n        if isinstance(required, list):\n            names.update(n for n in required if isinstance(n, str))\n        for value in node.values():\n            required_property_names(value, names)\n    elif isinstance(node, list):\n        for value in node:\n            required_property_names(value, names)\n    return names\n\n\ndef normative_sentences(text: str) -> list[str]:\n    \"\"\"Sentences that name a schema property AND state contract membership.\"\"\"\n    names = schema_property_names(story_schema())\n    flagged = []\n    for sentence in re.split(r\"(?<=[.;])\\s+\", PLACEHOLDER.sub(\"\", text)):\n        if not NORMATIVE.search(sentence):\n            continue\n        words = set(re.findall(r\"[a-z_]+\", sentence.lower()))\n        if words & names:\n            flagged.append(\" \".join(sentence.split()))\n    return flagged\n\n\ndef missing_required_names(rendered: str) -> set[str]:\n    \"\"\"Required property names absent from the rendered prompt.\n\n    Looked for in their quoted JSON form, which only the injected schema\n    supplies — the skeleton writes the story dialect, unquoted.\n    \"\"\"\n    return {\n        name for name in required_property_names(story_schema())\n        if f'\"{name}\"' not in rendered\n    }\n\n\ndef rendered_planner_prompt() -> str:\n    return context_assembler.render(\n        planner_template(), context_assembler.schema_context(REPO_ROOT)\n    )\n\n\n# --------------------------------------------------------------------------\n# planner.md states nothing normative of its own\n# --------------------------------------------------------------------------\n\n\ndef test_the_planner_template_injects_the_story_schema():\n    assert \"{{story_schema}}\" in planner_template()\n\n\ndef test_the_planner_template_states_no_required_section_or_field_itself():\n    assert normative_sentences(planner_template()) == []\n\n\ndef test_the_detector_flags_the_prose_this_story_removed():\n    \"\"\"Control: an empty result above must mean the prose is gone, not that\n    the detector cannot see it.\"\"\"\n    flagged = normative_sentences(REMOVED_PROSE)\n    assert len(flagged) == 2\n    assert any(\"required top-level\" in s for s in flagged)\n    assert any(\"optional top-level stage_exceptions\" in s for s in flagged)\n\n\ndef test_the_skeleton_survives_as_an_illustration():\n    text = planner_template()\n    assert \"story-NNN\" in text and \"acceptance_criteria:\" in text\n    assert \"illustration\" in text\n    # The word \"contract\" now points at the schema, not at the skeleton.\n    assert re.search(r\"contract is schemas/story\\.schema\\.json\", text)\n\n\ndef test_the_skeleton_names_no_field_the_schema_does_not_define():\n    known = schema_property_names(story_schema())\n    text = PLACEHOLDER.sub(\"\", planner_template())\n    keys = {\n        match.group(1)\n        for match in re.finditer(r\"^\\t\\s*(?:- )?([a-z_]+):\", text, re.MULTILINE)\n    }\n    assert keys, \"no skeleton keys found — the skeleton is indented with tabs\"\n    assert keys <= known, keys - known\n\n\ndef test_the_stage_exceptions_ask_first_guidance_survives():\n    text = planner_template()\n    assert \"stage_exceptions\" in text\n    assert \"without asking the developer first\" in text\n\n\n# --------------------------------------------------------------------------\n# The rendered prompt carries the schema\n# --------------------------------------------------------------------------\n\n\ndef test_the_rendered_prompt_carries_the_schema_file_verbatim():\n    assert STORY_SCHEMA_PATH.read_text(encoding=\"utf-8\") in rendered_planner_prompt()\n\n\ndef test_the_rendered_prompt_has_no_leftover_placeholder():\n    assert PLACEHOLDER.search(rendered_planner_prompt()) is None\n\n\ndef test_every_required_property_name_reaches_the_rendered_prompt():\n    required = required_property_names(story_schema())\n    assert {\n        \"story\", \"tasks\", \"acceptance_criteria\", \"scope\",\n        \"verification_requirements\", \"constraints\",\n        \"id\", \"title\", \"description\", \"modify\", \"do_not_modify\",\n        \"file\", \"reason\", \"stage\", \"create\",\n    } <= required\n    assert missing_required_names(rendered_planner_prompt()) == set()\n\n\ndef test_the_coverage_comes_from_the_injection_and_not_from_leftover_prose():\n    \"\"\"Negative control: strip the placeholder and the coverage collapses.\"\"\"\n    stripped = planner_template().replace(\"{{story_schema}}\", \"\")\n    rendered = context_assembler.render(\n        stripped, context_assembler.schema_context(REPO_ROOT)\n    )\n    assert missing_required_names(rendered) == required_property_names(story_schema())\n\n\n# --------------------------------------------------------------------------\n# l5-plan renders the template and passes it through --append-system-prompt\n# --------------------------------------------------------------------------\n\n\n@pytest.fixture\ndef captured_plan_argv(tmp_path: Path) -> list[str]:\n    \"\"\"Run scripts/l5-plan with a fake `claude` on PATH and capture its argv.\"\"\"\n    bin_dir = tmp_path / \"bin\"\n    bin_dir.mkdir()\n    argv_path = tmp_path / \"argv.json\"\n    fake = bin_dir / \"claude\"\n    fake.write_text(\n        \"#!/usr/bin/env python3\\n\"\n        \"import json, sys\\n\"\n        f\"open({str(argv_path)!r}, 'w').write(json.dumps(sys.argv))\\n\",\n        encoding=\"utf-8\",\n    )\n    fake.chmod(0o755)\n    env = dict(os.environ, PATH=f\"{bin_dir}{os.pathsep}{os.environ['PATH']}\")\n    result = subprocess.run(\n        [sys.executable, str(REPO_ROOT / \"scripts\" / \"l5-plan\"), \"a story request\"],\n        env=env, capture_output=True, text=True, cwd=tmp_path,\n    )\n    assert result.returncode == 0, result.stderr\n    return json.loads(argv_path.read_text(encoding=\"utf-8\"))\n\n\ndef test_l5_plan_starts_an_interactive_session_with_the_request(captured_plan_argv):\n    assert Path(captured_plan_argv[0]).name == \"claude\"\n    assert \"--append-system-prompt\" in captured_plan_argv\n    assert captured_plan_argv[-1] == \"Story request: a story request\"\n    assert \"--permission-mode\" in captured_plan_argv\n\n\ndef test_l5_plan_passes_the_rendered_prompt_not_the_raw_template(captured_plan_argv):\n    prompt = captured_plan_argv[captured_plan_argv.index(\"--append-system-prompt\") + 1]\n    assert prompt != planner_template()\n    assert PLACEHOLDER.search(prompt) is None\n    assert STORY_SCHEMA_PATH.read_text(encoding=\"utf-8\") in prompt\n    assert missing_required_names(prompt) == set()\n\n\ndef test_l5_plan_needs_no_target_repository(captured_plan_argv):\n    \"\"\"The fixture runs it from an empty tmp_path: the schema ships beside the\n    harness code, so rendering does not depend on where it is invoked.\"\"\"\n    assert \"--append-system-prompt\" in captured_plan_argv\n\n\ndef test_l5_plan_adds_no_second_substitution_implementation():\n    source = (REPO_ROOT / \"scripts\" / \"l5-plan\").read_text(encoding=\"utf-8\")\n    assert \"context_assembler.render\" in source\n    assert \"context_assembler.schema_context\" in source\n    assert \"re.sub\" not in source and \".replace(\" not in source\n\n\n# --------------------------------------------------------------------------\n# One schema-context implementation, and build_context unchanged\n# --------------------------------------------------------------------------\n\n\ndef test_the_schemas_glob_appears_once_in_context_assembler():\n    source = (ORCHESTRATION / \"context_assembler.py\").read_text(encoding=\"utf-8\")\n    assert source.count('glob(\"*.schema.json\")') == 1\n    assert source.count(\"schemas\") >= 1\n\n\ndef test_build_context_uses_the_same_schema_context_function():\n    source = (ORCHESTRATION / \"context_assembler.py\").read_text(encoding=\"utf-8\")\n    body = source.split(\"def build_context\")[1]\n    assert \"schema_context(harness_root)\" in body\n\n\ndef test_schema_context_maps_every_schema_file_to_its_placeholder_name():\n    context = context_assembler.schema_context(REPO_ROOT)\n    expected = {\n        path.name[: -len(\".schema.json\")].replace(\"-\", \"_\") + \"_schema\":\n            path.read_text(encoding=\"utf-8\")\n        for path in SCHEMAS_DIR.glob(\"*.schema.json\")\n    }\n    assert context == expected\n    assert all(isinstance(value, str) for value in context.values())\n\n\ndef test_build_context_still_resolves_every_stage_schema_placeholder(\n    target_root, harness_root\n):\n    import harness_config\n    import schema_validator\n    import story_parser\n\n    run_dir = target_root / \".harness\" / \"runs\" / \"story-001\"\n    run_dir.mkdir(parents=True, exist_ok=True)\n    story_text = (target_root / \".harness\" / \"stories\" / \"story-001.yaml\").read_text()\n    context = context_assembler.build_context(\n        story_text=story_text,\n        story=story_parser.parse(story_text, schema_validator.load_schema(\"story\")),\n        run_dir=run_dir,\n        target_root=target_root,\n        harness_root=harness_root,\n        config=harness_config.load_config(target_root),\n        rules={\"blocked_paths\": [\".git/\"], \"max_retries\": 3},\n        retry_count=0,\n    )\n    for path in SCHEMAS_DIR.glob(\"*.schema.json\"):\n        key = path.name[: -len(\".schema.json\")].replace(\"-\", \"_\") + \"_schema\"\n        assert context[key] == path.read_text(encoding=\"utf-8\"), key\n\n    for name in (\"implementer.md\", \"tester.md\", \"verifier.md\"):\n        rendered = context_assembler.render(\n            context_assembler.load_template(harness_root, name), context\n        )\n        assert PLACEHOLDER.search(rendered) is None, name\n\n\n# --------------------------------------------------------------------------\n# What this story leaves alone\n# --------------------------------------------------------------------------\n\n\ndef _unchanged_against_head(rel: str) -> bool:\n    result = subprocess.run(\n        [\"git\", \"diff\", \"HEAD\", \"--stat\", \"--\", rel],\n        cwd=REPO_ROOT, capture_output=True, text=True, check=True,\n    )\n    return result.stdout.strip() == \"\"\n\n\ndef test_l5_assist_is_unchanged():\n    assert _unchanged_against_head(\"scripts/l5-assist\")\n\n\ndef test_the_story_schema_is_unchanged():\n    assert _unchanged_against_head(\"schemas/story.schema.json\")\n\n\ndef test_no_committed_story_artifact_was_edited():\n    assert _unchanged_against_head(\".harness/stories\")\n\n\ndef test_every_committed_story_artifact_still_parses():\n    import schema_validator\n    import story_parser\n\n    stories = sorted((REPO_ROOT / \".harness\" / \"stories\").glob(\"*.yaml\"))\n    assert stories\n    schema = schema_validator.load_schema(\"story\")\n    for path in stories:\n        parsed = story_parser.parse(path.read_text(encoding=\"utf-8\"), schema)\n        assert parsed[\"story\"][\"id\"], path.name\n","numLines":358,"startLine":1,"totalLines":358}}}
