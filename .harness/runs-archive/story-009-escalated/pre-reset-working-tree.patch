 from __future__ import annotations
 
 import json
+import sys
 from pathlib import Path
 
 
+def find_target_root(start: Path) -> Path:
+    """Walk up from `start` to the nearest repository carrying a harness.
+
+    Every script needs the same lookup, so it lives here once rather than
+    once per script. Exits non-zero when there is nothing to find.
+    """
+    for candidate in [start, *start.parents]:
+        if (candidate / ".harness" / "config.yaml").is_file():
+            return candidate
+    sys.exit("No .harness/config.yaml found here or above. Run l5-init first.")
+
