+def workflow_context(
+    workflow: dict, rules: dict
+) -> dict[str, str | None]:
+    """Render the workflow's own declarations as injectable context.
+
+    A prompt that restates a workflow fact drifts from it silently. These
+    are the facts a planner needs and cannot otherwise see: which stages
+    the workflow defines, which of them are restricted from creating files
+    under which prefixes, and the repository-wide blocked paths.
+    """
+    stages = workflow.get("stages", [])
+    restrictions = [
+        f"{stage['name']} may not create anything under {prefix}"
+        for stage in stages
+        for prefix in stage.get("may_not_create", [])
+    ]
+    return {
+        "workflow_stages": _dashed_lines([stage["name"] for stage in stages]),
+        "stage_create_restrictions": _dashed_lines(restrictions),
+        "blocked_paths": _dashed_lines(rules.get("blocked_paths", [])),
+    }
+
+
