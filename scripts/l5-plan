#!/usr/bin/env python3
"""Plan a story interactively with the planner agent.

Usage: l5-plan [--base <branch>] [--workflow <name>] "<story request>"
       l5-plan [--base <branch>] [--workflow <name>] --brief <key>
Starts an interactive Claude Code session carrying the planner prompt.
The planner interviews you, iterates on the plan, and writes the approved
story artifact to .harness/stories/. When the session ends, this script
commits the artifact it caused to appear and pushes it, so committing is a
mechanism rather than something an agent is asked to remember.

The commit lands on whatever branch is checked out, so the same base check
l5-run runs at pre-flight runs here before the commit: an unstated base is
the repository's own default branch, and --base states another deliberately.

--brief names a brief to plan instead of giving the request as text, and the
two are mutually exclusive. The brief is fetched through the same configured
command the dedupe question is asked of, asked this time by key, and what comes
back is rendered as the request the planning session is given. The fetch
happens above everything -- above the workflow decision, above the template
render and above the stories directory snapshot -- so a refused fetch leaves
nothing invoked and nothing written. The key is opaque and is sent exactly as
it was given.

The brief is read at plan time and nowhere else. It is not written into the
story artifact, not stored and not re-read; the only trace of it after the
session is its key in the story's description, as prose, which the request text
asks the planner to record. Planning still happens the way it always has: the
interview happens, the developer approves, and the mandate is stamped from what
this process observed them answer.

A brief names the workflow it should be planned under, so on that path the
workflow selector is not invoked: the brief's workflow is the proposal, put to
the developer through the same confirmation where there is a terminal and taken
without asking where there is not. An explicit --workflow wins over it, and
this script says which it used and that the brief named another.

--workflow states the workflow the planner is rendered against, so the stage
facts injected into the prompt are the facts of the workflow the story will
actually run under. A name with no definition refuses before the session
starts, and an artifact naming another workflow is refused when the session
ends.

Without --workflow, planning runs in two phases. The planner is invoked first
against prompts/workflow-selector.md, which carries the request and what each
defined workflow says it is for and nothing else -- it cannot be rendered
against a workflow, because choosing one is its job. It writes a name and the
reasoning behind it; this script reads the name mechanically, shows the
reasoning, and asks the developer to accept it, name another, or abort. The
confirmed name is what the planning session is rendered against.

That turn is asked for its answer inside the workspace, under the configured
logs directory, and is granted the one tool writing it needs. What it printed
on the way there is appended to a transcript beside the answer, so an
invocation that proposed nothing leaves behind the reason it did not.

That confirmation needs a terminal, so an invocation with neither a terminal
nor --workflow is refused before anything is invoked, written or committed. A
call site that plans without a terminal names its workflow.

When the session ends, this script asks the developer whether they approve the
plan, and stamps the mandate the coordinator resolves before it will run
anything only on their answer — so the block records an act this process
watched happen rather than one it inferred from a terminal and a file. No
agent is ever asked to write it.

A rejection stamps nothing, commits nothing and pushes nothing, removes
nothing, and says where the artifacts are and what removes them. An artifact
that came back from the session already carrying a block is put to the
developer as part of that same question, since approving discards it; with no
terminal there is nobody to ask, so such an artifact is refused with nothing
stamped and nothing committed. An invocation with no terminal and no such
block stamps nothing at all — its artifact is then refused for the block it
does not carry, which is the correct outcome rather than a gap.
"""
import os
import subprocess
import sys
import time
from pathlib import Path
from typing import Sequence

HARNESS_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(HARNESS_ROOT / "orchestration"))

import brief_fetch  # noqa: E402
import context_assembler  # noqa: E402
import harness_config  # noqa: E402
import plan_commit  # noqa: E402
import plan_mandate  # noqa: E402
import plan_run_offer  # noqa: E402
import plan_validation  # noqa: E402
import story_coordinator  # noqa: E402
import workflow_selection  # noqa: E402


def main() -> None:
    argv = sys.argv[1:]
    base = None
    selected = None
    brief_key = None
    # --base, --workflow and --brief come ahead of the request; everything
    # after them is the request text, passed to the session unchanged. A loop
    # rather than positional cases, so no option's presence decides whether
    # another can be given.
    while argv[:1] in (["--base"], ["--workflow"], ["--brief"]):
        if len(argv) < 2:
            sys.exit(__doc__.strip())
        if argv[0] == "--base":
            base = argv[1]
        elif argv[0] == "--workflow":
            selected = argv[1]
        else:
            brief_key = argv[1]
        argv = argv[2:]
    # A brief and request text are two answers to what this session is planning,
    # and preferring one silently would plan something the developer did not
    # ask for. Refused rather than resolved, and above everything, so nothing
    # is invoked, written or committed.
    if brief_key is not None and argv:
        sys.exit(refuse_brief_and_request(brief_key, " ".join(argv)))
    if brief_key is None and not argv:
        sys.exit(__doc__.strip())
    target_root = harness_config.find_target_root(Path.cwd())
    config = harness_config.load_config(target_root)
    brief = None
    if brief_key is not None:
        # Fetched above the workflow decision, above the template render and
        # above the stories directory snapshot, so a refusal here leaves no
        # session invoked, no artifact written and no tree touched. The fetch
        # refuses where the dedupe query absorbs: this is a terminal invocation
        # a human asked for, and planning against a brief nobody could read is
        # planning against nothing.
        fetched = brief_fetch.fetch(brief_key, config, target_root, HARNESS_ROOT)
        if not fetched.fetched:
            sys.exit(refuse_fetch(brief_key, fetched.reason))
        brief = fetched.brief
        request = brief_fetch.render(brief, brief_key)
    else:
        request = " ".join(argv)
    # The workflow the planner is rendered against is the one --workflow named
    # or the one the developer confirmed, and there is no third source: after
    # story-072 no path renders the planner against a name that was neither
    # given on the command line nor chosen by a human. The configured workflow
    # key is not read here at all; it is still what the coordinator resolves a
    # story artifact naming no workflow through.
    if brief is not None:
        # A brief names its workflow, so there is a proposal already and the
        # selector has nothing to add: it is not invoked and writes no answer.
        selected = workflow_for_brief(brief, selected)
        if selected is None:
            sys.exit(1)
    elif selected is None:
        # No terminal and no --workflow leaves nobody to confirm a proposal,
        # and the refusal is decided here, above phase one, so a refused
        # invocation runs nothing, writes nothing and commits nothing. It reads
        # no input, so it returns whether or not anything is on stdin. There is
        # deliberately no escape hatch: a call site that needs to plan without
        # a terminal names its workflow.
        if not plan_run_offer.can_prompt(sys.stdin):
            sys.exit(refuse_headless(HARNESS_ROOT))
        selected = choose_workflow(HARNESS_ROOT, target_root, config, request)
        if selected is None:
            sys.exit(1)
    workflow_name = selected
    try:
        workflow = harness_config.load_workflow(HARNESS_ROOT, workflow_name, config)
    except harness_config.UnknownWorkflow as unknown:
        sys.exit(story_coordinator.refuse_unknown_workflow(unknown))
    rules = harness_config.load_rules(HARNESS_ROOT)
    # The planner is not a workflow stage, so no coordinator renders its
    # template. Render it here against the same schema and workflow context
    # the coordinator builds from, so the story contract and the workflow's
    # stage rules reach the planner as the enforced files themselves rather
    # than as copies of them that can drift.
    template = context_assembler.load_template(HARNESS_ROOT, "planner.md")
    context = context_assembler.schema_context(HARNESS_ROOT)
    context.update(context_assembler.workflow_context(workflow, rules))
    # The name the injected facts came from, so the planner can record in the
    # artifact the workflow the session was started for. It is the name
    # load_workflow was given rather than a second reading of the definition,
    # so what the prompt says and what was loaded cannot differ.
    context["workflow_name"] = workflow_name
    # The shared prose partial, resolved through the same helper build_context
    # uses, so the planner is held to the rule every stage that writes prose is
    # held to — the first of the stale counts it exists against was written in
    # a story artifact. It carries no placeholders of its own, which is what
    # lets this narrower context render it.
    prose = context_assembler.resolved_partial(
        HARNESS_ROOT, context_assembler.PROSE_LAYER, context
    )
    if prose is not None:
        context["prose_layer"] = prose
    planner_prompt = context_assembler.render(template, context)
    stories_dir = target_root / config.get("stories_dir", ".harness/stories")
    # The session runs as a child rather than through os.execvp, so this
    # script outlives it and can commit what it wrote. The argument list is
    # what the exec passed, unchanged, and stdin, stdout and stderr are
    # inherited, so the developer's terminal is the session's terminal.
    before = plan_commit.snapshot(stories_dir)
    try:
        status = subprocess.run(
            [
                "claude",
                "--permission-mode",
                "acceptEdits",
                "--append-system-prompt",
                planner_prompt,
                f"Story request: {request}",
            ]
        ).returncode
    except KeyboardInterrupt:
        # An interrupted session ends like any other end: whatever it already
        # wrote is committed, and the exit status is the shell's own 130.
        status = 130
    if status < 0:
        # A session killed by a signal reports it as a negative return code;
        # a shell reports the same end as 128 + the signal, and an interrupt
        # is 130 either way.
        status = 128 - status
    # Committing happens whatever the session's status was, so it is done
    # before the status is consulted at all. The session's own status then
    # wins; the commit's is what is left to say when the session ended
    # cleanly and the push did not.
    committing = report(
        target_root,
        stories_dir,
        before,
        workflow["stages"],
        config,
        base,
        workflow_name,
    )
    sys.exit(status or committing)


def refuse_headless(harness_root: Path) -> int:
    """Refuse an invocation with no terminal and no --workflow.

    Through the coordinator's own refusal helper, so this reads like every
    other refusal the harness prints. It names the flag and lists the
    workflows the harness defines, so the repair is in the message: the caller
    states the workflow it means rather than being told a terminal is missing
    and left to work out what to do about it.
    """
    defined = harness_config.workflow_names(harness_root)
    listed = ", ".join(defined) if defined else "no workflow definitions"
    return story_coordinator.refuse(
        "l5-plan has no terminal to confirm a workflow at:",
        [
            "without --workflow the planner proposes a workflow and the "
            "developer confirms it, and there is no terminal here to ask",
            f"the harness defines: {listed}",
        ],
        "Name the workflow with --workflow <name>. Nothing was invoked, "
        "written or committed.",
    )


def refuse_brief_and_request(key: str, request: str) -> int:
    """Refuse an invocation giving both a brief and request text.

    Through the coordinator's own refusal helper, like every other refusal
    this script prints. Neither is preferred silently: they are two answers to
    what this session is planning, and choosing one would plan something
    nobody asked for.
    """
    return story_coordinator.refuse(
        "l5-plan was given both a brief and request text:",
        [
            f"--brief names {key}",
            f"and the request text is: {request}",
        ],
        "A session plans one or the other. Give the brief's key, or give the "
        "request as text. Nothing was fetched, invoked, written or committed.",
    )


def refuse_fetch(key: str, reason: str) -> int:
    """Refuse an invocation whose brief could not be fetched.

    Every way of not having a brief arrives here carrying its own reason, so
    what a developer reads names what actually happened -- a key that did not
    resolve reads differently from a command that could not answer at all --
    and the guidance says the way through, which is that a request may be
    given as text instead of as a brief.

    Reached above the workflow decision, above the template render and above
    the stories directory snapshot, so this refuses an invocation that has
    invoked nothing and written nothing.
    """
    return story_coordinator.refuse(
        f"l5-plan could not fetch the brief {key}:",
        [reason],
        "Nothing was invoked, written or committed. Pass the request as text "
        "instead of --brief to plan it without fetching anything.",
    )


def workflow_for_brief(brief: dict, explicit: str | None) -> str | None:
    """The workflow a brief-driven session is planned under.

    A brief names its workflow, so there is a proposal without asking a model
    for one: the selector is not invoked on this path and writes no answer.
    What the brief names is put to the developer through the same confirmation
    the selector's proposal goes through, with the brief named as the reason,
    so Enter accepts, naming another overrides, and anything else aborts with
    no session started -- and the wording of that exchange stays in one place.

    Where there is no terminal the brief's workflow is taken without asking. A
    brief-driven invocation is not refused for having nobody to confirm a
    proposal: the proposal came from the brief rather than from a classifying
    turn, and refusing it would make the loop closable only by hand. An
    invocation with no terminal, no brief and no --workflow is refused exactly
    as it was before.

    An explicit --workflow wins, and both are reported: which one the session
    is planned under, and that the brief named another.
    """
    named = brief["workflow"]
    if explicit is not None:
        print(
            f"l5-plan: planning under {explicit}, which --workflow named; "
            f"the brief names {named}."
        )
        return explicit
    if not plan_run_offer.can_prompt(sys.stdin):
        print(
            f"l5-plan: planning under {named}, which the brief names; there "
            f"is no terminal here to confirm it at."
        )
        return named
    proposal = workflow_selection.Selection(
        workflow=named,
        reasoning=f"the brief names {named} as the workflow to plan it under",
        fault=None,
    )
    return confirm(
        proposal, workflow_selection.candidates(HARNESS_ROOT),
        proposer="the brief",
    )


def choose_workflow(
    harness_root: Path, target_root: Path, config: dict, request: str
) -> str | None:
    """Propose a workflow for this request and ask the developer to confirm it.

    Phase one of two. The planner is invoked against the selector prompt,
    which carries the request and what each defined workflow says it is for
    and nothing else; what it writes is read mechanically, and the developer
    is shown the reasoning rather than only the name, because the reasoning is
    what they are being asked to review.

    The answer is asked for inside the workspace rather than in a temporary
    directory, and the invocation is granted the one tool a turn whose entire
    output is one JSON file needs, so a turn that reasons correctly can also
    deliver. Its output is kept rather than discarded, so a run whose answer
    never arrives leaves behind what the turn said on the way there.

    Returns the confirmed name, or None where nothing was chosen — an unusable
    answer the developer declined to replace, or a reply naming a workflow the
    harness does not define. On None no planning session is started and no
    artifact is written. Every decision here is `workflow_selection`'s; what
    lives here is the wording and the reading of the reply.
    """
    found = workflow_selection.candidates(harness_root)
    paths = workflow_selection.selection_paths(target_root, config)
    paths.answer.parent.mkdir(parents=True, exist_ok=True)
    # An answer left behind by an earlier invocation is not this one's, and
    # reading one as this one's would report a proposal nothing made. Removed
    # before the invocation and again after it is read, so whatever this
    # invocation does, the next one starts with nothing there.
    paths.answer.unlink(missing_ok=True)
    try:
        template = context_assembler.load_template(
            harness_root, workflow_selection.SELECTOR_PROMPT
        )
        context = context_assembler.schema_context(harness_root)
        context["request"] = request
        context["workflow_candidates"] = workflow_selection.candidate_block(found)
        context["selection_path"] = str(paths.answer)
        prose = context_assembler.resolved_partial(
            harness_root, context_assembler.PROSE_LAYER, context
        )
        if prose is not None:
            context["prose_layer"] = prose
        print("l5-plan: choosing a workflow for this request...")
        # One classifying turn, so it prints its answer rather than opening a
        # session. Its output is the file it writes; what it says on the way
        # there is not what the developer is being asked to review, so it is
        # captured rather than left to clutter the terminal above the
        # confirmation — and then kept, because a turn that delivered nothing
        # is exactly the turn whose reasoning someone has to be able to read.
        #
        # cwd is the target root, so the workspace the permission mode accepts
        # edits within is the repository being planned for whatever directory
        # l5-plan was invoked from. stdin is /dev/null because this turn is
        # given its whole request on the command line and has nothing to read:
        # inheriting the session's stdin buys a three-second wait for data that
        # never comes.
        with open(os.devnull, "rb") as devnull:
            completed = subprocess.run(
                [
                    "claude",
                    "-p",
                    "--permission-mode",
                    "acceptEdits",
                    "--allowedTools",
                    "Write",
                    "--append-system-prompt",
                    context_assembler.render(template, context),
                    f"Story request: {request}",
                ],
                cwd=target_root,
                stdin=devnull,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
            )
        keep_transcript(paths.transcript, request, completed.stdout)
        selection = workflow_selection.read_selection(
            paths.answer, found, harness_root
        )
    finally:
        paths.answer.unlink(missing_ok=True)
    return confirm(selection, found, paths.transcript)


def keep_transcript(transcript: Path, request: str, output: str) -> None:
    """Append one invocation's output to the transcript, headed by its request.

    Appended rather than written, in the shape agent_runner writes its stage
    separator, so an earlier invocation's evidence survives a later one: the
    file is a record of what phase one has said in this repository, not of
    what it said most recently.
    """
    transcript.parent.mkdir(parents=True, exist_ok=True)
    with open(transcript, "a", encoding="utf-8") as handle:
        handle.write(f"\n===== workflow selection: {request} =====\n")
        handle.write(output or "")


def confirm(
    selection: workflow_selection.Selection,
    found: Sequence[workflow_selection.Candidate],
    transcript: Path | None = None,
    proposer: str = "the planner",
) -> str | None:
    """Show what was proposed and read the developer's one reply.

    A proposal is shown with its reasoning and accepted by pressing Enter. An
    unusable answer is shown as what it was — unsure, absent, unreadable,
    unparsable, or naming a workflow no definition has — and the developer is
    asked to name a workflow instead, where an empty reply aborts. Either way
    the workflows they may name are listed, and the reply is read once.

    On the branch where nothing was proposed the transcript is named beside the
    fault, because "it wrote no answer" tells a developer what happened and not
    where to look. The path that reaches a proposal says nothing new, so it is
    not printed there. The caller passes it in; `workflow_selection` still
    decides nothing about wording.

    `proposer` is what made the proposal, because a proposal can come from the
    classifying turn or from a brief that names its workflow, and the exchange
    is the same one either way. Naming it is what keeps this the one place the
    confirmation's wording lives rather than a second copy per source.
    """
    names = [candidate.name for candidate in found]
    listed = ", ".join(names) if names else "no workflow definitions"
    if selection.proposed:
        print(f"l5-plan: {proposer} proposes {selection.workflow}.")
        print(f"l5-plan: {selection.reasoning}")
        print(
            f"l5-plan: Enter accepts it; naming another runs the session "
            f"under that one instead ({listed}); anything else aborts: ",
            end="",
            flush=True,
        )
    else:
        print(f"l5-plan: {proposer} proposed no workflow — {selection.fault}.")
        if selection.reasoning:
            print(f"l5-plan: {selection.reasoning}")
        if transcript is not None:
            print(f"l5-plan: what it said is in {transcript}")
        print(
            f"l5-plan: name the workflow to plan under ({listed}); "
            f"Enter aborts: ",
            end="",
            flush=True,
        )
    decision = workflow_selection.read_reply(
        sys.stdin.readline(), tuple(found), selection.workflow
    )
    if decision.action == workflow_selection.ABORT:
        if decision.unknown is not None:
            print(
                f"l5-plan: '{decision.unknown}' is not a workflow the harness "
                f"defines; it defines: {listed}."
            )
        print("l5-plan: no workflow chosen; started no planning session.")
        return None
    print(f"l5-plan: planning under {decision.workflow}.")
    return decision.workflow


def report(
    target_root: Path,
    stories_dir: Path,
    before,
    stages,
    config=None,
    base=None,
    selected=None,
) -> int:
    """Say what plan_validation and plan_commit did with the session's artifacts.

    Both modules return what happened rather than printing it, so this is
    where the wording lives. The status it returns is only ever this script's
    own, and it is never allowed to unwind anything plan_commit did.
    """
    artifacts = plan_commit.new_artifacts(stories_dir, before)
    if not artifacts:
        print("l5-plan: the session added no story artifact; committed nothing.")
        return 0
    # A block the session wrote is detected here, immediately after the
    # artifacts are known and above everything that decides anything about
    # them, so it is found whether or not there is a terminal: a headless
    # invocation that let one through would be the path by which an agent's own
    # block reaches a commit no process observed.
    # Each artifact is read once here and that one read serves both readers of
    # it: the session-written-block check immediately below, and the titles the
    # approval prompt and the run offer name their stories by.
    texts = {path: path.read_text(encoding="utf-8") for path in artifacts}
    written = [
        path for path, text in texts.items() if plan_mandate.carries_a_mandate(text)
    ]
    # The title is read through the coordinator's own reader, which is the one
    # reader of a story artifact this repository has, and bounded by the
    # coordinator's own function. An artifact that does not parse, or that
    # carries no title, answers with the empty string and is named by its id
    # alone; the fault it carries is the validation's to report, below.
    titles = {
        path: story_coordinator.story_title(
            story_coordinator.read_story(text).parsed
        )
        for path, text in texts.items()
    }
    # The mandate is stamped between the snapshot and the validation, so the
    # artifact the validation is handed is the artifact the coordinator would
    # run: a block appended afterwards would be a block the plan-time check
    # never saw, and one appended after the commit would not be in it.
    #
    # It is stamped only where there is a terminal, because a terminal is where
    # the developer who approved the plan is asked. A headless invocation
    # therefore stamps nothing and falls through to the validation below, which
    # refuses the artifact for the block it does not carry — and is told, beside
    # the schema fault, that what is missing is the human.
    stamping = plan_run_offer.can_prompt(sys.stdin)
    conferred: list = []
    if written and not stamping:
        return refuse_session_block(written, artifacts)
    if stamping:
        # The developer approves before the schema check runs, and that ordering
        # is forced rather than chosen: the stamp has to precede validation
        # because the schema declares the block, and the approval has to precede
        # the stamp because the stamp is the record of it. So an approved
        # artifact can still be refused below for a fault — which leaves
        # everything in the tree to re-run from, and is cheaper than validating
        # against a second, relaxed spelling of the schema.
        if not approve(written, titles):
            return reject(artifacts, written)
        # Read after the answer rather than before the question, so conferred_at
        # is when the approval was observed rather than when the session ended.
        approved_at = time.time()
        if not stamp(
            target_root,
            config or {},
            artifacts,
            conferred,
            discarding=bool(written),
            now=approved_at,
        ):
            print(
                "l5-plan: stamped nothing and committed nothing; "
                f"{', '.join(str(path) for path in artifacts)} "
                "remain in the working tree."
            )
            return 1
    # Validation sits between the snapshot and the commit, so an artifact that
    # would be refused at pre-flight is never committed. It refuses rather
    # than warning — a warning here is a warning nobody sees, because the
    # session that could have repaired it has already ended. Nothing is
    # deleted and nothing is repaired: every artifact stays in the working
    # tree exactly as the session wrote it, which is what the developer fixes
    # and re-runs from. When one of several artifacts fails, none is
    # committed; the commit is one commit for the session's artifacts, and a
    # partial one would invent a split the session did not have.
    # The target root goes with the artifacts: the assignment check asks the
    # repository the story will run in whether a file it names is already
    # there, and that repository is the one find_target_root resolved, never
    # the harness root and never wherever this process was started from.
    # The workflow this session was rendered against goes with them: an
    # artifact naming another one was planned against facts that are not its
    # own, and an artifact naming one with no definition would refuse the run.
    # It is the name the flag gave or the developer confirmed, and nothing
    # else: this script reads the configured workflow key on no path.
    problems = plan_validation.artifact_problems(
        artifacts, stages, target_root, HARNESS_ROOT, selected
    )
    if problems:
        for path, found in problems.items():
            # The coordinator's own refusal helper, so the text a developer
            # reads here is the text l5-run's pre-flight would print.
            story_coordinator.refuse_bad_story(path, found)
        if not stamping:
            # A headless invocation's artifact fails its schema for a reason
            # the schema fault alone does not explain, so the reason is said
            # here: nobody was present, so nothing conferred the right to run
            # this work and no block was written.
            print(
                "l5-plan: no mandate was stamped, because there was no "
                "terminal here and therefore no human present to confer one. "
                "Plan from a terminal, or have the authorizing act observed "
                "some other way; nothing writes the block on an agent's word."
            )
        print(
            "l5-plan: committed nothing; "
            f"{', '.join(str(path) for path in artifacts)} "
            "remain in the working tree."
        )
        return 1
    # The base check sits here for the same reason validation does: this script
    # commits and pushes, and a plan artifact committed onto whatever happened
    # to be checked out is how a story branch came to be cut from another
    # story's unaccepted work. The base is resolved by the coordinator's own
    # function and printed through the coordinator's own refusal, so l5-run and
    # l5-plan cannot report the same defect differently. Nothing is committed
    # and nothing is pushed on this path; the artifacts stay where the session
    # wrote them.
    resolved_base = story_coordinator.resolve_base(target_root, config or {}, base)
    base_found = story_coordinator.base_problems(
        target_root, resolved_base, base is not None
    )
    if base_found:
        story_coordinator._refuse_base(resolved_base, base_found)
        print(
            "l5-plan: committed nothing; "
            f"{', '.join(str(path) for path in artifacts)} "
            "remain in the working tree."
        )
        return 1
    # The conferring records go in first, so the artifact commit is still the
    # branch tip and still says what it always said, and so the versioned
    # history this process wrote is not left in the tree for the run this
    # session is about to offer to be refused for.
    if conferred:
        recorded = plan_mandate.commit_records(
            target_root,
            harness_config.history_dir(target_root, config or {}),
            conferred,
        )
        if not recorded.committed:
            print(
                f"l5-plan: could not commit {', '.join(recorded.paths)}: "
                f"{recorded.detail}"
            )
            return 1
        print(f"l5-plan: committed {', '.join(recorded.paths)} as {recorded.subject}")
    commit = plan_commit.commit_artifacts(target_root, artifacts, HARNESS_ROOT)
    if not commit.committed:
        print(f"l5-plan: could not commit {', '.join(commit.paths)}: {commit.detail}")
        return 1
    print(f"l5-plan: committed {', '.join(commit.paths)} as {commit.subject}")
    push = plan_commit.push_commit(target_root)
    if not push.pushed:
        print(
            f"l5-plan: could not push {push.branch} to "
            f"{push.remote or '<no remote>'}: {push.detail}\n"
            f"l5-plan: the commit is intact on {push.branch}; push it yourself."
        )
        return 1
    print(f"l5-plan: pushed {push.branch} to {push.remote}")
    return offer(artifacts, base, titles)


def refuse_session_block(written: Sequence[Path], artifacts: Sequence[Path]) -> int:
    """Refuse artifacts carrying a session-written block with nobody to ask.

    Reached only where there is no terminal, so there is no developer to put
    the block to and nothing may be discarded on an agent's word. Nothing is
    stamped, nothing is committed and nothing is removed; the artifacts stay
    exactly as the session wrote them.

    Printed through the shared refusal rather than `refuse_bad_story`, which
    exists so plan time and pre-flight word one defect identically: pre-flight
    has nothing to say about this one — it would resolve the block and permit
    the run, which is the forgery this closes — so there is no second wording
    for it to agree with, and what the message owes instead is where the
    repair is.
    """
    story_coordinator.refuse(
        "l5-plan will not confer a mandate on an artifact that arrived with one:",
        [
            f"{path} already carries a {plan_mandate.MANDATE_KEY} block, and a "
            f"block this process did not write is a block nothing observed"
            for path in written
        ],
        "There is no terminal here, so there is no developer to put that block "
        "to and nothing discards it on an agent's word. Plan from a terminal, "
        "where approving the plan is what discards it and stamps what this "
        "process saw.",
    )
    print(
        "l5-plan: stamped nothing and committed nothing; "
        f"{', '.join(str(path) for path in artifacts)} "
        "remain in the working tree."
    )
    return 1


def approve(written: Sequence[Path], titles: dict | None = None) -> bool:
    """Ask the developer whether they approve what the session planned.

    Asked after the session has ended and before anything is stamped,
    committed or pushed, so what the mandate records is an act this process
    observed rather than one it inferred from a terminal and a file. The
    decision is `plan_mandate.approved`'s; the wording is this script's.

    The question is given its subject first: one line per artifact naming that
    artifact's story id and its title, printed above the question and before
    anything is stamped. The question itself is unchanged and is still the last
    thing printed before the read. An artifact with no title is named by its id
    alone rather than by a placeholder.

    A session-written block is folded into this same question rather than
    repaired quietly or refused outright: the developer is told the block is
    there and that approving discards it, because an agent that ignored an
    explicit instruction about the one field it must not write is an agent
    whose remaining output deserves a closer read.
    """
    for path, title in (titles or {}).items():
        print(f"l5-plan: {path.stem}" + (f": {title}" if title else ""))
    if written:
        for path in written:
            print(
                f"l5-plan: {path} carries a {plan_mandate.MANDATE_KEY} block "
                f"the session wrote, which it was told not to write."
            )
        print(
            "l5-plan: approving discards that block and stamps the mandate "
            "this process observed; read the rest of what the session wrote "
            "with that in mind."
        )
    print(
        "l5-plan: approve this plan? y approves and stamps the mandate, "
        "anything else rejects: ",
        end="",
        flush=True,
    )
    return plan_mandate.approved(sys.stdin)


def reject(artifacts: Sequence[Path], written: Sequence[Path]) -> int:
    """Say what a rejection left behind, and hand over the command that clears it.

    Nothing is stamped, written, committed or pushed, and nothing is removed —
    including a session-written block, because leave-and-warn leaves
    everything. The command that removes the artifacts is handed over rather
    than run, following the PAUSE_UNDO_COMMAND idiom: a destructive default
    belongs behind an explicit flag, and this adds none.
    """
    paths = [str(path) for path in artifacts]
    print("l5-plan: rejected; stamped nothing, committed nothing, pushed nothing.")
    for path in artifacts:
        print(f"l5-plan: {path} is in the working tree, unstamped and uncommitted")
    if written:
        print(
            f"l5-plan: the {plan_mandate.MANDATE_KEY} block the session wrote "
            f"is left where it is; nothing was removed."
        )
    print(
        "l5-plan: left there, they are what the next run's clean-tree "
        "pre-flight refuses on, and what a later completion commit staging "
        "the whole tree would absorb."
    )
    print(
        f"l5-plan: remove them with: "
        f"{plan_mandate.REMOVE_COMMAND} {' '.join(paths)}"
    )
    return 1


def stamp(
    target_root: Path,
    config: dict,
    artifacts: Sequence[Path],
    conferred: list,
    discarding: bool = False,
    now: float | None = None,
) -> bool:
    """Confer a mandate on each artifact the session wrote, and record it.

    Reached only on an approval, so `now` is when that approval was read and is
    what `conferred_at` records — the time the act was observed, not the time
    the session ended. `discarding` is that same approval given over a
    session-written block the developer was shown.

    Returns whether every artifact was stamped, and appends what was conferred
    to `conferred`, which is what the caller commits the records of once the
    artifacts have passed everything that could refuse them. `plan_mandate`
    decides what happens and this decides how it is said, which is the division
    `report` already keeps with `plan_commit` and `plan_validation`.
    """
    for path in artifacts:
        one = plan_mandate.confer(path, target_root, now, discarding=discarding)
        if not one.stamped:
            story_coordinator.refuse_bad_story(path, [one.detail])
            return False
        directory = plan_mandate.record(target_root, config, one)
        conferred.append(one)
        print(
            f"l5-plan: {one.story_id} runs on a mandate conferred by "
            f"{one.conferred_by} at {one.conferred_at}; recorded under "
            f"{directory}"
        )
    return True


def offer(
    artifacts: Sequence[Path],
    base: str | None = None,
    titles: dict | None = None,
) -> int:
    """Offer to run the story that was just committed, or say how to run it.

    Reached only on the path that reports success, so a commit that failed and
    a push that failed each return before it and offer nothing. The offer never
    unwinds or re-reports the commit and push that preceded it: the worst it
    does is print a command.

    A session that produced more than one artifact is told how to run each and
    offered nothing, because the offer is run-or-skip for one story and there
    is no order between them to pick from.

    The prompt is written only to a terminal. When stdin is not one, nothing is
    asked and nothing is read, and the skip path's command is printed exactly as
    it would have been had the developer declined.

    The prompt and each skip line name the story's title beside its id, so a
    developer offered a run recognises what they are being offered. The command
    a skip line hands over is unchanged, and a story with no title is named by
    its id alone.
    """
    named = {artifact.stem: (titles or {}).get(artifact, "") for artifact in artifacts}
    story_ids = list(named)

    def naming(story_id: str) -> str:
        title = named.get(story_id, "")
        return f"{story_id}: {title}" if title else story_id

    if len(story_ids) == 1 and plan_run_offer.can_prompt(sys.stdin):
        print(
            f"l5-plan: run {naming(story_ids[0])} now? "
            "Enter runs it, anything else skips: ",
            end="",
            flush=True,
        )
        if plan_run_offer.should_run(sys.stdin):
            return plan_run_offer.launch_run(HARNESS_ROOT, story_ids[0], base)
    for story_id in story_ids:
        command = plan_run_offer.run_command(HARNESS_ROOT, story_id, base)
        print(f"l5-plan: run {naming(story_id)} with: {command}")
    return 0


if __name__ == "__main__":
    main()
