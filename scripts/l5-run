#!/usr/bin/env python3
"""Execute an approved story through the story workflow.

Usage: l5-run <story-id> [--stage <stage>] [--base <branch>]
The target repository is found by walking up from the current directory
to the nearest .harness/config.yaml.

That repository is where the run reads refs and branches from; it is not
necessarily where the run works. The run works in a worktree of its own,
under the directory worktree_dir names, which is outside the repository:
this tree when it already stands on the story branch, the existing
worktree for that branch when there is one, and a new worktree otherwise.
So an invocation from a checkout with uncommitted work leaves that work
alone and commits none of it.

A worktree holds tracked files alone, so the run gives it the build
state the configured commands name: the directories the first word of
test_command and verification_runner live under are linked in from this
tree and excluded, so they never dirty the worktree or reach a commit.
The source directories are only read from — removing a worktree leaves
them alone — and a word with no root inside the tree links nothing and
refuses nothing.

A story whose artifact is not in this tree is not refused for that. It is
the ordinary state of a clone that did not plan the story, because
planning pushes its artifact on the story branch and removes its own
worktree; the branch is fetched and the artifact read from it.

A run whose state.json says it escalated, or that it paused because
capacity ran out, resumes at the recorded stage. --stage overrides that
with a stage the loaded workflow defines; the coordinator refuses one it
does not.

The two resumes differ in what they restore. An escalated run is
re-entered: its attempt allowance goes back to zero and the entry that
ended is archived. A paused run simply continues — nothing failed and no
attempt was spent, so no counter is reset and nothing is archived.

--base declares what a new story branch is cut from. Unstated, it is the
repository's own default branch, and the coordinator refuses a run that
would cut the branch from somewhere else.
"""
import sys
from pathlib import Path

HARNESS_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(HARNESS_ROOT / "orchestration"))

import harness_config  # noqa: E402
import story_coordinator  # noqa: E402


def main() -> int:
    argv = sys.argv[1:]
    options: dict[str, str | None] = {"--stage": None, "--base": None}
    positional = []
    index = 0
    while index < len(argv):
        if argv[index] in options:
            if index + 1 >= len(argv):
                print(__doc__.strip(), file=sys.stderr)
                return 1
            options[argv[index]] = argv[index + 1]
            index += 2
        else:
            positional.append(argv[index])
            index += 1
    if len(positional) != 1:
        print(__doc__.strip(), file=sys.stderr)
        return 1
    target_root = harness_config.find_target_root(Path.cwd())
    return story_coordinator.run_story(
        positional[0],
        HARNESS_ROOT,
        target_root,
        start_stage=options["--stage"],
        base=options["--base"],
    )


if __name__ == "__main__":
    sys.exit(main())
