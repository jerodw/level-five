#!/usr/bin/env python3
"""Drain the outbox: the harness's durable local queue of work to file.

Usage: l5-sync
The target repository is found by walking up from the current directory
to the nearest .harness/config.yaml.

This is the explicit drain, and the only drain site the harness ships. No
sweep runs inside a story run: nothing enqueues anything yet, so there is
no queue accumulating unattended for a forgotten one to strand, and the
story that adds a producer is the first point at which an automatic sweep
earns its call site.

It exits zero for a queue it drained and for one left holding only pending
entries a later sync will retry, and non-zero for a queue holding a failed
or a poisoned entry, naming each one. A poisoned file — one that is not an
entry — is named and left exactly as it is: the harness cannot know what a
human meant by it.

A target files an entry by configuring sync_command, one command the harness
invokes per entry and knows nothing else about the tracker through: the entry
on stdin, a reference on stdout, and an exit code saying landed, retry or
stop. A reference implementation ships at templates/sync/github.sh, installed
into a target's .harness/sync/ by l5-init. With no sync_command configured
this says that no transport is configured, reports the queue as it stands,
and applies the same exit rule.
"""
import sys
from pathlib import Path

HARNESS_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(HARNESS_ROOT / "orchestration"))

import command_transport  # noqa: E402
import harness_config  # noqa: E402
import outbox  # noqa: E402

#: The configuration keys this script reads. The reads live here rather than
#: in the transport module because no run reads them — the coordinator is not
#: involved in a sweep — and because this is where the AST scan in
#: tests/test_config_keys_are_obeyed.py already looks for a configured key.
TIMEOUT_KEY = "sync_timeout_seconds"


def build_transport(config: dict, target_root: Path):
    """The transport this configuration describes, or the reason it is refused.

    Returns `(transport, problem)`. No configured command is not a problem: a
    target that files nothing is the ordinary case, and it gets no transport
    and no complaint. A sync_timeout_seconds that is not a positive number is
    a problem, and it is refused here rather than obeyed — a timeout of zero
    or of a word is no timeout at all, which is the failure the bound exists
    to prevent.
    """
    command = config.get("sync_command")
    declared = config.get(TIMEOUT_KEY)
    if declared is None:
        timeout = command_transport.DEFAULT_TIMEOUT_SECONDS
    else:
        try:
            timeout = float(declared)
        except (TypeError, ValueError):
            timeout = None
        if timeout is None or timeout <= 0:
            return None, (
                f"{TIMEOUT_KEY}: {declared!r} is not a positive number of "
                "seconds, and a sync command must be bounded in time"
            )
    if not command:
        return None, ""
    return command_transport.CommandTransport(
        command=command, timeout=timeout, cwd=target_root
    ), ""


def report(summary, queue: Path) -> int:
    """Say what the drain found, and return the exit code the summary implies.

    The module collects; this decides how to say it and what it is worth. A
    failed or poisoned entry is what a later sweep cannot resolve on its own,
    so those and only those are worth a non-zero status.
    """
    print(f"outbox: {queue}")
    if not summary.transport:
        print("no transport is configured, so nothing was filed")
    print(
        f"landed {summary.landed}, pending {summary.pending}, "
        f"failed {summary.failed}, poisoned {summary.poisoned}"
    )
    for key in summary.pending_keys:
        print(f"  pending: {key}")
    for key in summary.failed_keys:
        print(f"  failed:  {key}")
    for poisoned in summary.poisoned_files:
        print(f"  poisoned: {poisoned.path}")
        for problem in poisoned.problems:
            print(f"      {problem}")
    for note in summary.notes:
        print(f"  note: {note}")
    return 1 if summary.blocked else 0


def main() -> int:
    if len(sys.argv) > 1:
        print(__doc__.strip(), file=sys.stderr)
        return 1
    target_root = harness_config.find_target_root(Path.cwd())
    config = harness_config.load_config(target_root)
    transport, problem = build_transport(config, target_root)
    if problem:
        print(problem, file=sys.stderr)
        return 1
    queue = outbox.queue_dir(target_root)
    return report(
        outbox.sync(queue, transport, harness_root=HARNESS_ROOT), queue
    )


if __name__ == "__main__":
    sys.exit(main())
